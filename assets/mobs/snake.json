                0.4,
                1
              ],
              "z": [
                0,
                0.4
              ]
            }
          }
        ]
      },
      "tail": {
        "layers": [
          {
            "material": "skin",
            "depth": 1,
            "keep": true
          },
          {
            "material": "muscle",
            "depth": 1
          },
          {
            "material": "bone"
          }
        ]
      }
    },
    "becomes": {
      "flesh_cooked": "venom_gland"
    }
  },
