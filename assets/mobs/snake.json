    "layers": [
      {
        "material": "skin",
        "depth": 1,
        "keep": true
      },
      {
        "material": "flesh",
        "depth": 1
      },
      {
        "material": "muscle",
        "depth": 1,
        "speckle": {
          "material": "blood",
          "fraction": 0.05
        }
      },
      {
        "material": "bone"
      }
    ],
