      "wavelength": 1.05,
      "amplitude": 0.075,
      "ampHead": 0.08,
      "ampRamp": 1,
      "turnBend": 1,
      "maxCurvature": 0.06,
      "bendHalfLife": 0.25,
      "beatHz": 0.55,
      "slip": 1.0,
      "ampIdle": 0.45,
      "ampSpeed": 0.8,
      "parts": [
        "head",
        "body1",
        "body2",
        "body3",
        "tail"
      ]
    },
    "trunkHalfW": 1.569,
    "trunkHalfH": 1.861
  },
  "headLook": false,
  "aimSpineShare": 0.15,
  "aimLeanBodies": 0.03,
  "//natural": "THE JAWS. An AIM effector on the head (no chain owns it), the edge running from the gape to the snout along the mouth line. A MOUTHFUL: biteRadius 4.5 x gore.biteRadius is a 0.8..2.0-voxel tear across the speed ramp (a charge lands near the top of it), and mouthful 1.25 takes the same tear out of every other limb of the victim inside 1.25 of it -- the thigh with the hip, the hand with the wrist. 90 hp at full speed, the extra limbs sharing half as much again.",
