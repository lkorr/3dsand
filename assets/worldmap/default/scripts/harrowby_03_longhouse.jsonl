# ---- the walking graph: the generator put the hall's node IN the hearth ----
# Move it off the fire to the back of the hall, and route the byre door
# round the hearth through a new node rather than across the ashes.
{"cmd": "slot.move", "args": {"name": "waynode_room_0", "pos": [-8, 0, -14]}}
{"cmd": "slot.add", "args": {"name": "waynode_hall_w", "kind": "waynode", "pos": [-36, 0, -8], "yaw": 0, "props": {"links": ["waynode_room_0", "waynode_left_0_in"]}}}
{"cmd": "slot.set_prop", "args": {"name": "waynode_left_0_in", "key": "links", "value": ["waynode_left_0_out", "waynode_hall_w"]}}
{"cmd": "slot.set_prop", "args": {"name": "waynode_room_0", "key": "links", "value": ["waynode_back_0_in", "waynode_front_0_in", "waynode_partition_0", "waynode_stair_bottom"]}}
# Up in the loft the clothes chest stands between the loft's node and Edric's
# bed: a second loft node on the stair side of the chest reaches it.
{"cmd": "slot.add", "args": {"name": "waynode_loft_w", "kind": "waynode", "pos": [22, 27, -10], "yaw": 0, "props": {"links": ["waynode_stair_top", "waynode_loft"]}}}
# ...and one beside Maud's bed, so she climbs in over the side rail and not
# over the bed's end board (the loft's own node is off the end of it).
{"cmd": "slot.add", "args": {"name": "waynode_loft_e", "kind": "waynode", "pos": [55, 27, -10], "yaw": 0, "props": {"links": ["waynode_loft"]}}}
# The `hearth` (Maud's work, where the Cotters eat) stood south of the fire,
# so every walk from it to the back of the hall cut across the kerb and the
# pot. Stand it on the EAST side instead, facing the fire, clear of the board.
{"cmd": "slot.move", "args": {"name": "hearth", "pos": [-12, 0, 0], "yaw": 270}}

# ---- slots: Edric's clothes chest in the loft; the generator's spare work spot goes
{"cmd": "slot.set_prop", "args": {"name": "chest_0", "key": "title", "value": "Clothes chest"}}
{"cmd": "slot.set_prop", "args": {"name": "chest_0", "key": "items", "value": [{"item": "hood", "count": 1}, {"item": "footwraps", "count": 1}]}}
{"cmd": "slot.remove", "args": {"name": "work_1"}}

