# HARROWBY 01 -- put the three houses on the ground.
#
# The houses were generated first (the Structures page, or from a terminal):
#   node scripts/bake_structure.mjs harrowby_longhouse assets/worldmap/default/scripts/harrowby_longhouse.params.json
#   node scripts/bake_structure.mjs harrowby_smithy    assets/worldmap/default/scripts/harrowby_smithy.params.json
#   node scripts/bake_structure.mjs harrowby_alehouse  assets/worldmap/default/scripts/harrowby_alehouse.params.json
#
# The green is the space between them (a structure of its own, script 05,
# centred at (555, 3467) with the well just north of its middle); the map's
# spawn (580, 3515) is on the green's open south side, so a new game starts
# looking at the village.
#
#            N (-z)
#    [ longhouse, door faces S ]
#   alehouse     well     smithy
#   door faces E  green   door faces W (the forge bay opens onto the green)
#                spawn
#
# pos is the middle of the house's footprint, y the floor you walk on (the
# village's softened ground rolls round 200, so floor 201). A placed house
# levels its own footprint and a ring round it (padApron, 0.8 m: the
# doorsteps) to the floor, then eases back into the ground with a smooth
# S-curve over padMargin (3.6 m). Ramps of houses on the same floor may meet;
# a ramp reaching the flat ring of a house on ANOTHER floor is a load warning.
# (Until 2026-09-29 a pad was a SQUARE as wide as the longest side with a
# 0.4 m straight ramp -- the hard-edged lawns.)
{"cmd": "ref.place", "args": {"id": "harrowby/longhouse", "kind": "structure", "base": "harrowby_longhouse", "pos": [560, 201, 3340], "yaw": 0, "props": {"padApron": 8, "padMargin": 36}}}
{"cmd": "ref.place", "args": {"id": "harrowby/smithy", "kind": "structure", "base": "harrowby_smithy", "pos": [700, 201, 3460], "yaw": 270, "props": {"padApron": 8, "padMargin": 36}}}
{"cmd": "ref.place", "args": {"id": "harrowby/alehouse", "kind": "structure", "base": "harrowby_alehouse", "pos": [415, 201, 3460], "yaw": 90, "props": {"padApron": 8, "padMargin": 36}}}
