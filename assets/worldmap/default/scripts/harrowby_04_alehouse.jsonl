# ---- the places people stand ------------------------------------------------
# Agnes's work spot: at the cask rack, facing the room, the board before her.
{"cmd": "slot.add", "args": {"name": "trestle", "kind": "marker", "pos": [20, 0, -18], "yaw": 0, "props": {"tags": ["trestle"]}}}
# The evening gathering (schedules say `at: alehouse`): the open floor between
# the board and the fire. Anyone without a place of their own stands here.
{"cmd": "slot.add", "args": {"name": "gathering", "kind": "marker", "pos": [22, 0, 4], "yaw": 270, "props": {"tags": ["alehouse"]}}}
# Three regulars, three places at the board, each named on the villager's own
# ref (props.alehouse): five people sent to ONE marker shoulder each other off
# it all night. Osric and Edric at the front bench, Wat on the back bench.
{"cmd": "slot.add", "args": {"name": "seat_osric", "kind": "marker", "pos": [2, 0, 5], "yaw": 180, "props": {"tags": ["alehouse_seat"]}}}
{"cmd": "slot.add", "args": {"name": "seat_edric", "kind": "marker", "pos": [10, 0, 5], "yaw": 180, "props": {"tags": ["alehouse_seat"]}}}
{"cmd": "slot.add", "args": {"name": "seat_wat", "kind": "marker", "pos": [6, 0, -15], "yaw": 0, "props": {"tags": ["alehouse_seat"]}}}

# ---- the walking graph, redrawn round the board ----------------------------
# NPCs walk STRAIGHT between nodes (the local pathfinder only sees the ground
# near the player), so every leg must be clear. The generator's front-room
# node stood where the board now is, and its link to the back room's doorway
# ran diagonally through the board. Now:
#   front door -- room_1 (the open floor by the fire) -- bar (the cask rack)
#   front door -- hall_w -- hall_nw (down the gangway past the board's west
#   end) -- the partition doorway -- the back room
{"cmd": "slot.move", "args": {"name": "waynode_room_1", "pos": [24, 0, 8]}}
{"cmd": "slot.add", "args": {"name": "waynode_bar", "kind": "waynode", "pos": [18, 0, -15], "yaw": 0, "props": {"links": ["waynode_room_1"]}}}
{"cmd": "slot.add", "args": {"name": "waynode_hall_nw", "kind": "waynode", "pos": [-9, 0, -19], "yaw": 0, "props": {"links": ["waynode_partition_0"]}}}
{"cmd": "slot.add", "args": {"name": "waynode_hall_w", "kind": "waynode", "pos": [-9, 0, 10], "yaw": 0, "props": {"links": ["waynode_front_0_in", "waynode_hall_nw"]}}}
# the partition's node stood a pace east of the doorway: put it IN the doorway
{"cmd": "slot.move", "args": {"name": "waynode_partition_0", "pos": [-16, 0, -22]}}
{"cmd": "slot.set_prop", "args": {"name": "waynode_partition_0", "key": "links", "value": ["waynode_room_0"]}}
{"cmd": "slot.set_prop", "args": {"name": "waynode_room_1", "key": "links", "value": ["waynode_front_0_in"]}}

