{"cmd": "vox.box_fill", "args": {"min": [-41, 1, 8], "max": [-35, 1, 12], "mat": "plank"}}
{"cmd": "vox.box_fill", "args": {"min": [-40, 2, 8], "max": [-36, 5, 12], "mat": "leather"}}
{"cmd": "vox.box_fill", "args": {"min": [-41, 6, 8], "max": [-35, 6, 12], "mat": "plank"}}
