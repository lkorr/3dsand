# HARROWBY 02 -- Osric's smithy, by hand, on top of the generated scaffold.
#
# House frame (the same numbers however the smithy is turned in the world):
# y = 0 is the floor, +z is the FRONT wall (z 31..34), x -46..50 wall to wall.
# The forge is the LEFT end (the chimney gable, x < 0); Osric's back room with
# his bed is the RIGHT end behind the plank partition (x > 12).
# In the world the smithy is turned 270, so its front faces WEST onto the
# green and the forge end is the NORTH end.
{"cmd": "struct.open", "args": {"ref": "harrowby/smithy"}}

# ---- the open forge bay: take the front wall out of the forge end ----------
# 2.8 m wide, 2 m high, a timber bressumer across the top carrying the
# cobble above; a 0.5 m cobble pier is left between the bay and the door.
{"cmd": "vox.clear", "args": {"min": [-39, 0, 31], "max": [-12, 19, 34]}}
{"cmd": "vox.box_fill", "args": {"min": [-41, 20, 31], "max": [-10, 21, 34], "mat": "timber"}}

# ---- the forge hearth: a waist-high cobble bed run into the old fireplace ----
# The chimney recess (x -52..-43) becomes the back of the forge; the bed
# comes 0.9 m into the room. Its top is a bed of charcoal inside a cobble rim.
# A COLD forge: live ember would never sleep and would find the timber.
{"cmd": "vox.box_fill", "args": {"min": [-52, 0, -5], "max": [-43, 6, 4], "mat": "cobble"}}
{"cmd": "vox.box_fill", "args": {"min": [-42, 0, -7], "max": [-34, 7, 6], "mat": "cobble"}}
{"cmd": "vox.box_fill", "args": {"min": [-50, 7, -4], "max": [-36, 7, 3], "mat": "charcoal"}}
{"cmd": "vox.box_fill", "args": {"min": [-47, 8, -2], "max": [-40, 8, 1], "mat": "charcoal"}}

