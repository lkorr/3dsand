// THE table of tuning parameters. Every plain number, flag and name in
// assets/materials/tuning.json has exactly one row here, and the row is the
// ONLY place its default and its range are written. From it:
//
//   tuning.h        the member initializer: `float x = TPD(group, x);`
//                   (namespace tuning_def, expanded at the top of tuning.h)
//   tuning.cpp      LoadTuning's read + clamp (ReadDefRows), --sweep's setter
//                   (SetTuningField) and the WGSL consts (TuningWgslBlock)
//   Python          scripts/tuning_def.py parses this file for the offline
//                   shader prelude (scripts/tuning_prelude.py), the invariant
//                   checks, and scripts/gen_tuning_params.py, which writes
//                   assets/tuning_params.js -- the tuner's min/max, joined to
//                   tuner_schema.js's hand-written rows by group.key
//   selftest        the `tuning-reach` gate expands every row
//
// Row forms (the macro name is the type):
//   TP_F (group, member, WGSL, default, min, max)   float
//   TP_I (group, member, WGSL, default, min, max)   int; the JSON must be an
//                                                   integer (rule 1 for sim.*)
//   TP_U (group, member, WGSL, default, min, max)   int, emitted as WGSL u32
//   TP_B (group, member, WGSL, default)             bool; JSON true/false only
//   TP_S (group, member, WGSL, default)             std::string
//   TP_V3(group, member, WGSL, x, y, z)             float[3]; JSON [x, y, z]
//
//   group    the Tuning sub-struct AND the tuning.json object name.
//   member   the C++ member inside it AND the JSON key.
//   WGSL     the shader constant name (TUNE_*, conventionally TUNE_ +
//            SNAKE(member); four rows predate that) or NO_WGSL for a row no
//            shader reads. NO_WGSL rows never reach the prelude, so they can
//            never miss the shader cache.
//   min/max  the LOAD CLAMP (a value outside is clamped and warned about) AND
//            the tuner's slider range -- one range, not two. A literal, a
//            world.h constant (kFarLevels), or TP_OPEN for no bound.
//
// Rules:
//   - One row per line and NO trailing comment on a row: the Python side reads
//     whole lines. Put the why on the line(s) above; it stays with the row.
//   - A rule a row cannot state (a bound that depends on another field, a
//     reset-to-default, an enum gate, a non-row read) is hand-written in
//     LoadTuning's group block, which runs after the generated reads; the row
//     is preceded by `// + a hand-written rule in LoadTuning`.
//   - A knob with no row is still legal -- the gore.*Var variance objects are
//     read by hand, and a branch may add a knob in the old style (literal
//     initializer in tuning.h, Read* in LoadTuning). Both styles coexist;
//     check_invariants.py only asks that every tuning.json key has a reader.
//   - A WGSL-visible row change is a prelude change for every shader that
//     reads it; `sim.*` rows feed the CA and move the world hash (rule 1).

// clang-format off


// ---- sky / sun ----
TP_F(render, sunDiscGain, TUNE_SUN_DISC_GAIN, 3.0f, 0.0f, 20.0f)
TP_V3(render, sunColor, TUNE_SUN_COLOR, 1.0f, 0.95f, 0.86f)
TP_F(render, sunIntensity, TUNE_SUN_INTENSITY, 1.35f, 0.0f, 5.0f)

// ---- atmospheric sky ----
TP_F(render, skyRayleigh, TUNE_SKY_RAYLEIGH, 12.0f, 0.0f, 40.0f)
TP_F(render, skyMie, TUNE_SKY_MIE, 1.0f, 0.0f, 8.0f)
// + a hand-written rule in LoadTuning
TP_F(render, skyMieG, TUNE_SKY_MIE_G, 0.76f, -0.9f, 0.95f)
TP_F(render, skyMieStrength, TUNE_SKY_MIE_STRENGTH, 1.0f, 0.0f, 6.0f)
TP_F(render, skyExposure, TUNE_SKY_EXPOSURE, 1.6f, 0.0f, 6.0f)
TP_V3(render, skyGround, TUNE_SKY_GROUND, 0.22f, 0.20f, 0.17f)
// + a hand-written rule in LoadTuning
TP_F(render, sunSize, TUNE_SUN_SIZE, 3.0f, 0.25f, 20.0f)
TP_F(render, sunReddening, TUNE_SUN_REDDENING, 1.0f, 0.0f, 4.0f)

// ---- night sky ----
TP_V3(render, nightZenith, TUNE_NIGHT_ZENITH, 0.006f, 0.010f, 0.028f)
TP_V3(render, nightHorizon, TUNE_NIGHT_HORIZON, 0.030f, 0.036f, 0.062f)
TP_F(render, fluidParticleSize, TUNE_FLUID_PARTICLE_SIZE, 0.58f, 0.2f, 1.2f)
TP_F(render, fluidStretch, TUNE_FLUID_STRETCH, 0.4f, 0.0f, 1.5f)
TP_F(render, fluidDensityShade, TUNE_FLUID_DENSITY_SHADE, 0.45f, 0.0f, 1.0f)
TP_F(render, fluidFoam, TUNE_FLUID_FOAM, 0.55f, 0.0f, 2.0f)
// MPM fluid SURFACE rendering (raymarch.wgsl MPM FLUID SURFACE block):
// fluidSurface is a 0-3 DRAW MODE (see tuning.h), iso x rest density,
// smooth in voxels, clarity metres, foamSpeed vox/s.
TP_F(render, fluidSurface, TUNE_FLUID_SURFACE, 2.0f, 0.0f, 3.0f)
TP_F(render, fluidIso, TUNE_FLUID_ISO, 0.30f, 0.08f, 1.0f)
TP_F(render, fluidSmooth, TUNE_FLUID_SMOOTH, 1.3f, 0.4f, 3.0f)
TP_F(render, fluidLevel, TUNE_FLUID_LEVEL, 1.0f, 0.0f, 1.0f)
TP_F(render, fluidIor, TUNE_FLUID_IOR, 1.33f, 1.01f, 2.0f)
TP_F(render, fluidClarity, TUNE_FLUID_CLARITY, 1.3f, 0.05f, 20.0f)
TP_F(render, fluidReflect, TUNE_FLUID_REFLECT, 1.0f, 0.0f, 2.0f)
TP_F(render, fluidSpecular, TUNE_FLUID_SPECULAR, 1.0f, 0.0f, 4.0f)
TP_F(render, fluidFoamSpeed, TUNE_FLUID_FOAM_SPEED, 22.0f, 1.0f, 90.0f)
TP_F(render, fluidWobble, TUNE_FLUID_WOBBLE, 0.5f, 0.0f, 2.0f)
// Depth colour gradient (raymarch.wgsl, DEPTH GRADIENT block). The shallow
// tint is what a thin film reads as, the deep tint what the body tends toward;
// depth is the metres of path over which the ramp completes.
TP_V3(render, fluidShallow, TUNE_FLUID_SHALLOW, 0.42f, 0.86f, 0.82f)
TP_V3(render, fluidDeep, TUNE_FLUID_DEEP, 0.02f, 0.15f, 0.42f)
TP_F(render, fluidDepth, TUNE_FLUID_DEPTH, 2.6f, 0.05f, 20.0f)
TP_F(render, fluidGradient, TUNE_FLUID_GRADIENT, 1.0f, 0.0f, 1.0f)
// Grid foam field (sim_fluid.wgsl foam potentials, raymarch surface whitening).
TP_F(render, fluidFoamField, TUNE_FLUID_FOAM_FIELD, 1.0f, 0.0f, 3.0f)
TP_F(render, fluidFoamTexture, TUNE_FLUID_FOAM_TEXTURE, 0.65f, 0.0f, 1.0f)
// Foam PARTICLE colour (debris.wgsl vsParticle, PPAY_FOAM). Foam is
// entrained air, so it has no material - it is coloured from here.
TP_V3(render, foamColor, TUNE_FOAM_COLOR, 0.97f, 0.98f, 1.0f)
TP_F(render, foamColorVar, TUNE_FOAM_COLOR_VAR, 0.18f, 0.0f, 1.0f)
TP_F(render, starBrightness, TUNE_STAR_BRIGHTNESS, 1.0f, 0.0f, 6.0f)
TP_F(render, starDensity, TUNE_STAR_DENSITY, 150.0f, 1.0f, 900.0f)
// + a hand-written rule in LoadTuning
TP_F(render, starSize, TUNE_STAR_SIZE, 0.85f, 0.2f, 4.0f)
TP_F(render, starSparsity, TUNE_STAR_SPARSITY, 0.012f, 0.0f, 1.0f)
TP_F(render, starTwinkle, TUNE_STAR_TWINKLE, 0.35f, 0.0f, 2.0f)
TP_F(render, milkyWayStrength, TUNE_MILKYWAY_STRENGTH, 0.55f, 0.0f, 4.0f)
TP_V3(render, milkyWayColor, TUNE_MILKYWAY_COLOR, 0.52f, 0.56f, 0.78f)
// + a hand-written rule in LoadTuning
TP_V3(render, galaxyNormal, TUNE_GALAXY_NORMAL, 0.36f, 0.52f, -0.77f)
// galaxyWidth is a smoothstep edge; at 0 the band is a zero-width slit and
// the divide inside smoothstep degenerates.
TP_F(render, galaxyWidth, TUNE_GALAXY_WIDTH, 0.17f, 0.001f, 0.6f)
TP_F(render, nebulaStrength, TUNE_NEBULA_STRENGTH, 0.40f, 0.0f, 4.0f)
TP_V3(render, nebulaCool, TUNE_NEBULA_COOL, 0.16f, 0.30f, 0.62f)
TP_V3(render, nebulaWarm, TUNE_NEBULA_WARM, 0.55f, 0.20f, 0.38f)
TP_F(render, auroraStrength, TUNE_AURORA_STRENGTH, 0.55f, 0.0f, 4.0f)
// + a hand-written rule in LoadTuning
TP_F(render, auroraHeight, TUNE_AURORA_HEIGHT, 900.0f, 50.0f, 5000.0f)
TP_V3(render, auroraLow, TUNE_AURORA_LOW, 0.10f, 0.85f, 0.45f)
TP_V3(render, auroraHigh, TUNE_AURORA_HIGH, 0.65f, 0.20f, 0.85f)

// ---- moons ----
// NOTE there is no moon RADIUS here any more. Apparent size is now an output
// of the orbit (dayNight.moonAngularRadius modulated by orbital distance,
// arriving as R.moonAngRadius), because the eclipse test and the disc must
// read ONE number for how big a moon is. A render-side radius knob would be a
// second, diverging answer to that question.
TP_F(render, moonBrightness, TUNE_MOON_BRIGHTNESS, 1.6f, 0.0f, 8.0f)
TP_V3(render, moonColor, TUNE_MOON_COLOR, 0.92f, 0.93f, 0.88f)
TP_V3(render, moonMariaSeed, TUNE_MOON_MARIA_SEED, 4.0f, 1.0f, 9.0f)
TP_F(render, moonGlow, TUNE_MOON_GLOW, 0.35f, 0.0f, 3.0f)
TP_F(render, moonEarthshine, TUNE_MOON_EARTHSHINE, 0.055f, 0.0f, 0.5f)
TP_V3(render, moonLightColor, TUNE_MOON_LIGHT_COLOR, 0.55f, 0.68f, 1.0f)
TP_F(render, moonLightIntensity, TUNE_MOON_LIGHT_INTENSITY, 0.16f, 0.0f, 2.0f)
// Moon B: a smaller, colder, dimmer body. Only look lives here; where it is
// and how big it appears come from its orbit.
TP_V3(render, moon2Color, TUNE_MOON2_COLOR, 0.78f, 0.80f, 0.86f)
TP_V3(render, moon2MariaSeed, TUNE_MOON2_MARIA_SEED, -21.0f, 13.0f, 37.0f)
TP_F(render, moon2Brightness, TUNE_MOON2_BRIGHTNESS, 0.72f, 0.0f, 4.0f)
TP_F(render, moon2LightIntensity, TUNE_MOON2_LIGHT_INTENSITY, 0.055f, 0.0f, 2.0f)
TP_V3(render, moon2LightColor, TUNE_MOON2_LIGHT_COLOR, 0.62f, 0.62f, 0.86f)
// How dark a TOTAL solar eclipse gets. 1 = full totality (the dome falls to
// its night value); lower keeps some daylight so a total eclipse still reads
// as daytime-gone-wrong rather than as night.
// eclipseDarkness scales a subtraction from the daylight weight; past 1 it
// would drive the weight negative and the sky would light from below.
TP_F(render, eclipseDarkness, TUNE_ECLIPSE_DARKNESS, 0.93f, 0.0f, 1.0f)
// The perceptual falloff of that darkening against covered AREA. 3 (the old
// hardcoded cube) keeps the world bright until the last sliver of sun goes,
// which is how a real partial eclipse reads; 1 tracks the covered area
// linearly and looks like an exposure slide. Mirrored in common.wgsl's
// eclipseDayWeightP and raymarch.wgsl's eclipseDim — they MUST agree.
// eclipseCurve is an exponent on a 0..1 fraction. At or below 0, pow()
// takes the uncovered sky (f = 0) to infinity rather than to zero, so a
// clear day would render as permanent totality.
TP_F(render, eclipseCurve, TUNE_ECLIPSE_CURVE, 3.0f, 0.05f, 8.0f)

// ---- night ambient ----
TP_V3(render, nightAmbSky, TUNE_NIGHT_AMB_SKY, 0.055f, 0.075f, 0.135f)
TP_V3(render, nightAmbGround, TUNE_NIGHT_AMB_GROUND, 0.022f, 0.026f, 0.042f)

// ---- ambient / diffuse ----
TP_V3(render, ambSky, TUNE_AMB_SKY, 0.40f, 0.48f, 0.62f)
TP_V3(render, ambGround, TUNE_AMB_GROUND, 0.25f, 0.22f, 0.17f)
TP_F(render, diffuseWrap, TUNE_DIFFUSE_WRAP, 0.55f, 0.0f, 2.0f)
TP_F(render, faceX, TUNE_FACE_X, 0.96f, 0.5f, 1.0f)
TP_F(render, faceZ, TUNE_FACE_Z, 0.92f, 0.5f, 1.0f)

// ---- AO / shadows ----
TP_F(render, aoStrength, TUNE_AO_STRENGTH, 0.45f, 0.0f, 1.0f)
TP_F(render, aoFar, TUNE_AO_FAR, 0.72f, 0.0f, 1.0f)
TP_F(render, shadowBias, TUNE_SHADOW_BIAS, 0.02f, 0.001f, 0.5f)
TP_I(render, shadowSteps, TUNE_SHADOW_STEPS, 384, 0, 2048)
TP_F(render, shadowSoftNear, TUNE_SHADOW_SOFT_NEAR, 0.6f, 0.0f, 5.0f)
TP_F(render, shadowSoftFar, TUNE_SHADOW_SOFT_FAR, 9.0f, 0.5f, 60.0f)
TP_F(render, shadowLift, TUNE_SHADOW_LIFT, 0.45f, 0.0f, 1.0f)
TP_F(render, shadowFarLift, TUNE_SHADOW_FAR_LIFT, 0.3f, 0.0f, 1.0f)
TP_I(render, shadowCache, TUNE_SHADOW_CACHE, 1, 0, 1)
// Subdivision must be >= 1 and within the 3 bits the shadow request record
// gives each sub-index (world.h kShadowSubdivMax). A 0 here would divide by
// zero in shadowPatchCentre; anything over the max would alias two patches
// onto one key, which reads as shadows flickering between neighbours.
// 8 is world.h's kShadowSubdivMax, restated rather than included: this TU
// does not pull in world.h, and the shader clamps to SHADOW_SUBDIV_MAX
// independently, so an over-large value here is bounded twice over. The
// clamp exists so the tuner slider cannot silently alias two patches onto
// one key, not as the load-bearing guard.
TP_I(render, shadowCacheSubdiv, TUNE_SHADOW_CACHE_SUBDIV, 4, 1, 8)
// The penumbra cone's half-angle in degrees. 0 is legal and means "point
// sun", i.e. the hard single-ray shadow this replaced. The ceiling is
// where tan() stops being a small angle and the jittered ray would start
// missing the blocker it is supposed to be sampling the edge of.
TP_F(render, shadowSunAngle, TUNE_SHADOW_SUN_ANGLE, 1.0f, 0.0f, 15.0f)

// ---- grain ----
TP_F(render, grainBroadScale, TUNE_GRAIN_BROAD_SCALE, 11.0f, 1.0f, 64.0f)
TP_F(render, grainFineScale, TUNE_GRAIN_FINE_SCALE, 2.5f, 0.5f, 16.0f)
TP_F(render, grainMix, TUNE_GRAIN_MIX, 0.68f, 0.0f, 1.0f)
TP_F(render, grainAmp, TUNE_GRAIN_AMP, 0.065f, 0.0f, 0.4f)
TP_F(render, grainAmpFar, TUNE_GRAIN_AMP_FAR, 0.05f, 0.0f, 0.4f)

// ---- media / fire ----
TP_F(render, mediaAbsorb, TUNE_MEDIA_ABSORB, 6.4f, 0.0f, 40.0f)
TP_F(render, mediaTauMax, TUNE_MEDIA_TAU_MAX, 6.0f, 1.0f, 20.0f)
TP_F(render, fireFlickerBase, TUNE_FIRE_FLICKER_BASE, 0.70f, 0.0f, 2.0f)
TP_F(render, fireFlickerAmp, TUNE_FIRE_FLICKER_AMP, 0.55f, 0.0f, 2.0f)
TP_F(render, fireFlickerRate, TUNE_FIRE_FLICKER_RATE, 13.0f, 0.0f, 40.0f)
TP_F(render, fireGlowRate, TUNE_FIRE_GLOW_RATE, 1.4f, 0.1f, 8.0f)
TP_F(render, fireIntensity, TUNE_FIRE_INTENSITY, 2.1f, 0.0f, 10.0f)
TP_F(render, fireBreatheAmp, TUNE_FIRE_BREATHE_AMP, 0.08f, 0.0f, 1.0f)
TP_F(render, fireBreatheRate, TUNE_FIRE_BREATHE_RATE, 5.3f, 0.0f, 20.0f)
TP_F(render, emissiveStrength, TUNE_EMISSIVE_STRENGTH, 1.7f, 0.0f, 8.0f)
TP_F(render, emissiveFlickerBase, TUNE_EMISSIVE_FLICKER_BASE, 0.82f, 0.0f, 2.0f)
TP_F(render, emissiveFlickerAmp, TUNE_EMISSIVE_FLICKER_AMP, 0.28f, 0.0f, 2.0f)
TP_F(render, emissiveFlickerRate, TUNE_EMISSIVE_FLICKER_RATE, 9.0f, 0.0f, 40.0f)
// Burn-tinted materials (materials.json "burnTint", sim/materials.h
// kMatFlagBurnTint): the palette is the UNBURNT colour and each cell pulses
// toward this flame colour on a slow per-cell phase. Min/Max bound the pulse
// weight; the emission is scaled by the same weight (common.wgsl burnTint).
TP_V3(render, burnTintColor, TUNE_BURN_TINT_COLOR, 1.0f, 0.52f, 0.14f)
TP_F(render, burnTintRate, TUNE_BURN_TINT_RATE, 2.6f, 0.0f, 20.0f)
TP_F(render, burnTintMin, TUNE_BURN_TINT_MIN, 0.25f, 0.0f, 1.0f)
TP_F(render, burnTintMax, TUNE_BURN_TINT_MAX, 0.9f, 0.0f, 1.0f)

// ---- water ----
TP_F(render, waterF0, TUNE_WATER_F0, 0.0204f, 0.0f, 0.3f)
TP_V3(render, waterAbsorb, TUNE_WATER_ABSORB, 1.85f, 0.42f, 0.20f)
TP_V3(render, waterScatter, TUNE_WATER_SCATTER, 0.045f, 0.16f, 0.20f)
TP_F(render, waterFresnelPower, TUNE_WATER_FRESNEL_POWER, 5.0f, 1.0f, 10.0f)
TP_F(render, rippleAmpScale, TUNE_RIPPLE_AMP_SCALE, 0.35f, 0.0f, 4.0f)
TP_F(render, rippleSpeedScale, TUNE_RIPPLE_SPEED_SCALE, 0.40f, 0.0f, 4.0f)
TP_F(render, waterFetchLow, TUNE_WATER_FETCH_LOW, 0.35f, 0.0f, 1.0f)
TP_F(render, waterFetchHigh, TUNE_WATER_FETCH_HIGH, 0.85f, 0.0f, 1.0f)
// M4 surface waves (PLAN_water_master.md component 9). These had .def
// rows, struct fields, tuning.json values and tuner sliders since 9a79eba
// but no read here, so every slider was dead and the shader always ran the
// tuning.h defaults. check_invariants.py now refuses a .def row with no
// quoted read in this file.
// Dispersion is a mix() weight and steepness a crest fraction: both mean
// nothing outside 0..1. The rest are lengths / rates / gains that go
// nonsensical (or divide by ~0 in raymarch.wgsl) below their floor; the
// ceilings are generous past the tuner's slider range.
TP_F(render, waveDispersion, TUNE_WAVE_DISPERSION, 1.0f, 0.0f, 1.0f)
TP_F(render, waveSteepness, TUNE_WAVE_STEEPNESS, 0.55f, 0.0f, 1.0f)
TP_F(render, waveShoreDepth, TUNE_WAVE_SHORE_DEPTH, 0.45f, 0.0f, 16.0f)
TP_F(render, waveFlowScale, TUNE_WAVE_FLOW_SCALE, 1.0f, 0.0f, 16.0f)
TP_F(render, waveFoamThreshold, TUNE_WAVE_FOAM_THRESHOLD, 0.12f, 0.0f, 16.0f)
TP_F(render, waveFoamGain, TUNE_WAVE_FOAM_GAIN, 3.0f, 0.0f, 100.0f)
TP_F(render, waveImpactSpeed, TUNE_WAVE_IMPACT_SPEED, 1.8f, 0.0f, 50.0f)
TP_F(render, waveImpactDecay, TUNE_WAVE_IMPACT_DECAY, 2.5f, 0.05f, 60.0f)
TP_F(render, waveImpactLen, TUNE_WAVE_IMPACT_LEN, 0.70f, 0.05f, 20.0f)
// W3 render (docs/PLAN_water_relevel.md section 5, last bullet). The SIM's own
// surface momentum, read in the fragment stage from `waterFlux`. The height is
// already authoritative through liquidColumn(); what the pipes add is what the
// eighth-quantised height CANNOT carry -- which way the surface is moving, and
// how hard. waveSimSlope tilts the normal a little down-flow (sub-eighth
// detail between the steps the column height can express); waveSimFoam froths
// the columns whose pipes are running hardest. BOTH AT 0 CONST-FOLDS THE WHOLE
// BLOCK, including the buffer read, which is not a nicety: the raymarch
// fragment shader has no register headroom and this is the arm --shader-stats
// is compared against.
// W3 render (PLAN_water_relevel.md §5). Read from JSON rather than left to
// the C++ default, so the tuner's slider actually reaches the shader const
// TuningWgslBlock emits from the struct.
TP_F(render, waveSimSlope, TUNE_WAVE_SIM_SLOPE, 0.030f, 0.0f, 0.5f)
TP_F(render, waveSimFoam, TUNE_WAVE_SIM_FOAM, 0.55f, 0.0f, 4.0f)
TP_F(render, dbgCurrentSpacing, TUNE_CUR_DBG_SPACING, 6.0f, 1.0f, 64.0f)
TP_F(render, dbgCurrentRadius, TUNE_CUR_DBG_RADIUS, 40.0f, 0.0f, 256.0f)
TP_F(render, reflectionCutoff, TUNE_REFLECTION_CUTOFF, 0.06f, 0.0f, 1.0f)
TP_I(render, reflectionSteps, TUNE_REFLECTION_STEPS, 96, 0, 512)
TP_F(render, causticGain, TUNE_CAUSTIC_GAIN, 1.5f, 0.0f, 8.0f)
TP_F(render, causticCap, TUNE_CAUSTIC_CAP, 0.85f, 0.0f, 4.0f)
TP_F(render, glintIntensity, TUNE_GLINT_INTENSITY, 0.85f, 0.0f, 4.0f)
TP_F(render, glintPowerNear, TUNE_GLINT_POWER_NEAR, 180.0f, 10.0f, 2000.0f)
TP_F(render, glintPowerFar, TUNE_GLINT_POWER_FAR, 900.0f, 10.0f, 4000.0f)
TP_F(render, foamDepth, TUNE_FOAM_DEPTH, 0.42f, 0.0f, 3.0f)
TP_F(render, foamStrength, TUNE_FOAM_STRENGTH, 0.55f, 0.0f, 1.0f)
TP_F(render, iceF0, TUNE_ICE_F0, 0.021f, 0.0f, 0.3f)
TP_F(render, iceFresnelPower, TUNE_ICE_FRESNEL_POWER, 5.0f, 1.0f, 8.0f)
TP_F(render, iceAbsorb, TUNE_ICE_ABSORB, 3.2f, 0.0f, 12.0f)
TP_F(render, iceAbsorbFloor, TUNE_ICE_ABSORB_FLOOR, 0.06f, 0.0f, 1.0f)
TP_F(render, iceScatter, TUNE_ICE_SCATTER, 0.30f, 0.0f, 2.0f)
TP_F(render, iceScatterDepth, TUNE_ICE_SCATTER_DEPTH, 1.6f, 0.1f, 8.0f)
TP_F(render, iceScatterNight, TUNE_ICE_SCATTER_NIGHT, 0.25f, 0.0f, 1.0f)
TP_F(render, iceGrain, TUNE_ICE_GRAIN, 0.09f, 0.0f, 0.6f)
TP_F(render, iceGrainScale, TUNE_ICE_GRAIN_SCALE, 0.35f, 0.02f, 3.0f)
TP_F(render, iceGloss, TUNE_ICE_GLOSS, 190.0f, 4.0f, 1200.0f)
TP_F(render, iceSpec, TUNE_ICE_SPEC, 0.55f, 0.0f, 3.0f)
TP_F(render, iceDepthMax, TUNE_ICE_DEPTH_MAX, 3.0f, 0.5f, 40.0f)
TP_F(render, iceReflectMin, TUNE_ICE_REFLECT_MIN, 0.12f, 0.0f, 1.0f)

// ---- submerged view (raymarch.wgsl shadeSubmerged / godRays / bedCaustic) ----
// These only ever apply when the ray is INSIDE a liquid, which above water is
// never — every term below is gated on that, so a dry frame pays nothing.
// Underwater absorption is deliberately its OWN set rather than reusing
// waterAbsorb: looking THROUGH a lake from outside wants a strong red kill
// (that is the depth cue), but living inside it at that strength leaves you in
// a flat blue void with no visible distance at all. Underwater wants a longer
// visibility range and a stronger scatter floor.
// ---- submerged view ----
TP_V3(render, subAbsorb, TUNE_SUB_ABSORB, 0.42f, 0.11f, 0.075f)
TP_V3(render, subScatter, TUNE_SUB_SCATTER, 0.055f, 0.19f, 0.24f)
// In-scatter strength and how fast the volume tint saturates with distance.
TP_F(render, subScatterGain, TUNE_SUB_SCATTER_GAIN, 1.0f, 0.0f, 4.0f)
// Distance (metres) at which the far view has fully faded to the scatter
// colour. This is the underwater equivalent of fog distance and it is the
// single knob that says "murky pond" vs "clear tropical water".
// A visibility of 0 divides by zero in the shader's fade and takes the
// whole submerged view to NaN, which renders as a black screen the moment
// the player's head goes under. Floor it well clear of that.
TP_F(render, subVisibility, TUNE_SUB_VISIBILITY, 11.0f, 0.5f, 60.0f)
// Screen-edge darkening while submerged — a cheap, strong "you are in a
// medium" cue that costs one dot product.
TP_F(render, subVignette, TUNE_SUB_VIGNETTE, 0.34f, 0.0f, 1.0f)
// Snell's-window brightening: looking UP from under water compresses the whole
// sky into a ~97 degree cone. Outside it the surface mirrors the murk.
TP_F(render, subSnellGain, TUNE_SUB_SNELL_GAIN, 1.25f, 0.0f, 4.0f)

// ---- caustics cast onto submerged surfaces ----
// The existing causticGain/Cap drive the caustic seen looking DOWN through a
// surface from outside. These drive the caustic painted on a lit voxel face
// while the camera is under the water, which is a different projection (from
// the surface above the SURFACE point, not the bed point) and wants its own
// strength or one of the two views always looks wrong.
TP_F(render, bedCausticGain, TUNE_BED_CAUSTIC_GAIN, 2.4f, 0.0f, 10.0f)
TP_F(render, bedCausticCap, TUNE_BED_CAUSTIC_CAP, 1.5f, 0.0f, 6.0f)
// Metres of water above a surface past which its caustics have washed out.
TP_F(render, bedCausticFade, TUNE_BED_CAUSTIC_FADE, 6.0f, 0.1f, 40.0f)
// Sharpness of the caustic web. Higher = thinner, brighter filaments.
TP_F(render, bedCausticSharp, TUNE_BED_CAUSTIC_SHARP, 2.2f, 0.1f, 8.0f)

// ---- volumetric light shafts (god rays) ----
// Ray-marched with a real occlusion test per sample, so shafts break correctly
// around the shore and any overhang. Sample count is a direct frame-time
// multiplier on submerged pixels ONLY.
// ---- god rays ----
// Both step counts are a direct per-submerged-pixel frame-time multiplier
// (steps x shadowSteps is the real cost), so the ceilings here are a perf
// guard, not a taste judgement. 0 steps disables the effect cleanly.
TP_I(render, godRaySteps, TUNE_GODRAY_STEPS, 14, 0, 64)
TP_F(render, godRayStrength, TUNE_GODRAY_STRENGTH, 0.55f, 0.0f, 4.0f)
// Henyey-Greenstein forward-scattering asymmetry: shafts are much brighter
// looking toward the sun than away from it, which is what makes them read as
// beams rather than as uniform haze.
// The Henyey-Greenstein phase function has a (1 - g^2) numerator and a
// denominator that goes to zero as |g| -> 1, so a g of exactly 1 is a
// division by zero and anything past it is not a valid phase function.
TP_F(render, godRayAniso, TUNE_GODRAY_ANISO, 0.62f, -0.95f, 0.95f)
// Metres the shaft march covers. Beyond this the scatter has saturated anyway.
TP_F(render, godRayRange, TUNE_GODRAY_RANGE, 14.0f, 0.1f, 60.0f)
// Steps the per-sample occlusion ray gets. Short on purpose: it only has to
// find the surface or a nearby blocker, not resolve distant geometry. Since
// W2-B these are BLOCK steps (the ray is coarse from t=0), so 8 of them reach
// 3.2 m where the old 20 voxel steps reached 2.0 m.
TP_I(render, godRayShadowSteps, TUNE_GODRAY_SHADOW_STEPS, 8, 0, 64)

// ---- coarse-terminate for secondary rays (PLAN_lin_followups.md W2-B) ------
// Metres past which traceOpaque stops asking the voxel and asks the 4^3
// blockers-class sub-occupancy mask instead: a clear block is skipped whole
// (exact), a set block stops the ray (conservative). 0 disables it and the
// const-folded 1e30 deletes the code. It lives next to the god-ray rows
// because god rays pass 0 for it — they are coarse from the first step.
// 0 is the OFF value (the shader const-folds the coarse march away), so
// only negatives are refused — a negative would make every ray coarse from
// its first cell, which is what god rays ask for explicitly and no shadow
// ray should get by accident.
TP_F(render, shadowCoarseDist, TUNE_SHADOW_COARSE_DIST, 8.0f, 0.0f, 60.0f)

// ---- the openness (sky-visibility) grid (docs/PLAN_gi.md §2, W3 P0) --------
// How far a hemisphere ray looks for a blocker, in metres. 12 m is chosen so a
// ruin roof reads as cover and a 2 m overhang reads as shade; sky past it is
// the plain n.y prior, which is what the old lerp already assumed.
// A negative reach would make every ray report "blocked at t < 0" and
// paint the world black; a negative strength would brighten the ambient
// past the sky value. Clamp rather than warn -- neither is expressible as
// an intent, and both are one keystroke away in the tuner.
TP_F(render, opennessReach, TUNE_OPENNESS_REACH, 12.0f, 0.0f, 40.0f)
// Chunk slots the rolling refresh revisits per TICK (not per frame -- the pass
// is on the tick table, see pass_table.def). The whole 32,768-slot window comes
// round in kNumChunks / this ticks; every EDIT is covered by the dirty walk
// instead, so this budget only has to cover cold start and streaming.
TP_I(render, opennessChunksPerFrame, TUNE_OPENNESS_CHUNKS, 256, 0, 2048)
// 0 = the plain n.y hemisphere lerp, bit-identical to pre-P0, AND the pass is
// not recorded at all -- which is what the `noopenness` --render-budget arm
// measures. 1 = full spatial attenuation.
TP_F(render, opennessStrength, TUNE_OPENNESS_STRENGTH, 1.0f, 0.0f, 1.0f)
// THE OLD LEAK, KEPT AS ITS OWN A/B ARM AND DEFAULTED OFF (2026-09-11). This
// was the least the openness grid could scale the SKY ambient to, and because
// the sky ambient is the entire day/night signal a sealed cave got a flat 30%
// of the time of day through solid rock: measured in the `--shot` stone room,
// 97.6% of a sealed wall's noon brightness was this term and the room's
// noon/midnight ratio was 8.6x. What it was standing in for -- "real enclosed
// surfaces keep light from the surfaces around them" -- is enclosedAmbient
// below plus the bounce gather, neither of which moves with the sun.
TP_F(render, opennessFloor, TUNE_OPENNESS_FLOOR, 0.0f, 0.0f, 1.0f)
// The ambient an ENCLOSED face keeps, ADDED rather than multiplied in, and
// deliberately NOT a function of the sun, the moons or the sky: this is the
// term that decides how bright a cave is, and a cave must not know what time
// it is. Scaled by (1 - openness), so open ground never sees it at all and the
// meadow stays bit-identical; scaled by opennessStrength too, so the
// `noopenness` arm still folds the whole feature away. Sits at about the
// brightness a moonless night gives the open sky, which is the look the
// measurement was aiming at: dim, navigable, and the same at noon.
TP_V3(render, enclosedAmbient, TUNE_ENCLOSED_AMBIENT, 0.012f, 0.013f, 0.016f)
// Bilinear over the four neighbouring blocks in the face plane. Nearest-only
// tiles visibly on a flat wall at 40 cm blocks; this costs three more byte
// reads on a hit that has already paid for a chunk lookup.
TP_I(render, opennessBilinear, TUNE_OPENNESS_BILINEAR, 1, 0, 1)

// ---- one-bounce indirect light (docs/PLAN_gi.md §3, W3 P1) ----
// Weight of the gathered bounce added at every near-field hit. 0 is an EXACT
// off switch: the gather, the resolve-pass injection and the walk's sun
// sample all const-fold away, which is what the `nogi` --render-budget arm
// measures.
// Indirect light (PLAN_gi.md §3-4). A negative strength would subtract
// light; a decay outside [0,1] is meaningless; and the P2 write-back must
// stay strictly below the decay or every bounce adds more than the walk
// forgets and the grid brightens without bound. That last one is the
// assertion PLAN_gi.md §4 asks for, expressed as a warning plus a clamp
// because a bad value is one keystroke away in the tuner and must not
// take the game down.
// + a hand-written rule in LoadTuning
TP_F(render, giStrength, TUNE_GI_STRENGTH, 2.0f, 0.0f, 3.0f)
// Fraction of a face's irradiance the openness walk forgets per visit when it
// cannot re-measure the face (its front block holds a blocker, so no sun ray
// can be cast from it) -- how fast light deposited under an old sun fades
// once no patch of that face is on screen to re-deposit it.
// + a hand-written rule in LoadTuning
TP_F(render, giDecay, TUNE_GI_DECAY, 0.25f, 0.0f, 1.0f)
// P2 (PLAN_gi.md §4): fraction of a receiver's own gathered term blended back
// into its block-face per frame, so bounces compound. 0 = one bounce only.
// LoadTuning keeps it strictly below giDecay or the grid brightens without
// bound.
// + a hand-written rule in LoadTuning
TP_F(render, giFeedback, TUNE_GI_FEEDBACK, 0.2f, 0.0f, 1.0f)
// The STEP BUDGET of each of the nine gather rays, not a distance: traceOpaque
// jumps a whole CHUNK (1.6 m) per step wherever the chunk holds no blocker and
// a 4^3 block otherwise, so open air is crossed four times faster than the
// name suggests. At the old 3 the gather reached 1.2 m and light could not
// cross a room, and render.opennessFloor was leaking daylight into sealed rock
// to stand in for the transport that was missing; 12 crosses a room.
// MUST STAY A CONSTANT the shader can fold -- see giGatherRays in
// raymarch.wgsl for the 128 -> 168 register cliff a per-pixel budget costs.
// Paid for by doubling giCachePeriod below: measured 2026-09-11, 12 steps at
// period 16 costs the same 0.78 ms as 3 steps at period 8.
// A STEP budget, not a distance (tuning_params.def says why). The ceiling
// is what bounds the gather's cost: nine rays x this many iterations on a
// re-gather frame, amortised over giCachePeriod. 64 is already ~30 m of
// open interior, which is past the residency window's useful half.
TP_I(render, giGatherBlocks, TUNE_GI_GATHER_BLOCKS, 12, 0, 64)
// The gather CACHE (PLAN_frame_perf.md s3 item 1): frames between re-gathers
// of one chunk slot's block-faces. The nine rays run only on a slot's scheduled
// frame (slots are staggered, so 1/N of the visible ones re-gather per frame)
// and for a face never gathered; every other hit reads one cached word,
// bilinear over the face plane. 0 = the old per-pixel gather every frame,
// const-folded, which is the `nogicache` --render-budget arm.
// 8 -> 16 on 2026-09-11, to pay for giGatherBlocks 3 -> 12: the gather's cost
// is (rays x steps) / period, so doubling this absorbed the whole of the
// reach increase (0.78 ms on the noon overlook, before and after). What it
// buys the reach with is LATENCY -- the bounce now trails the sun and the
// shadow cache by up to 16 frames instead of 8, about a quarter-second, which
// is well under what the eye reads as a lag on a term this diffuse.
// Beyond 64 the bounce visibly lags the sun; 0 is the uncached path.
TP_I(render, giCachePeriod, TUNE_GI_CACHE_PERIOD, 16, 0, 64)

// ---- the glow field (src/sim/world.h kGlowBytes, assets/shaders/sim_glow.wgsl)
// Weight of the sampled emitter light added at a consumer. 0 is an EXACT off
// switch: both producer rows go unrecorded (C_GLOW) and every consumer's term
// const-folds away, which is what the `noglow` --render-budget arm measures.
TP_F(render, glowStrength, TUNE_GLOW_STRENGTH, 1.0f, 0.0f, 4.0f)
// How far an emitter chunk throws light, in metres. LoadTuning clamps this to
// one chunk plus half a block diagonal, because the producer's stencil is 3x3x3
// CHUNKS and a reach past that would be a truncated kernel -- a hard edge at
// the stencil boundary instead of a falloff that reaches zero on its own.
// + a hand-written rule in LoadTuning
TP_F(render, glowReach, TUNE_GLOW_REACH, 2.4f, 0.0f, 2.6f)
// Emitting-cell fraction at which a chunk reads as a full-strength light
// source. 32 means 1/32 of the chunk (128 of 4,096 cells) saturates it, so a
// lava pool's surface layer counts fully while four stray embers do not. This
// is the only knob between "how much lava" and "how bright"; the ceiling itself
// is structural (see glowStoreSrc) and does not depend on it.
TP_F(render, glowFill, TUNE_GLOW_FILL, 32.0f, 1.0f, 256.0f)
// Chunk slots the rolling refresh revisits per TICK. Every EDIT is covered by
// the dirty walk, so this only has to cover cold start, streaming, and chunks
// the ring budget below turned away.
TP_I(render, glowChunksPerFrame, TUNE_GLOW_CHUNKS, 64, 0, kNumChunks)
// The per-tick ceiling on the expensive branch: how many of the dirty list's
// workgroups may rewrite their whole 3x3x3 neighbourhood when their source word
// moves. A prefix of the compacted list, so it is stable rather than
// scheduling-dependent. 64 x 27 x 64 = 110,592 stores is the worst tick.
TP_I(render, glowRingBudget, TUNE_GLOW_RING_BUDGET, 64, 0, kNumChunks)
// Sample the field at the near-field TERRAIN hit as well as on the raster body
// paths. OFF by default and that is a correctness call, not caution: terrain
// already receives emitter light through giGather over the irradiance grid,
// which carries emission since PLAN_gi.md P3, so adding this there
// DOUBLE-COUNTS every emitter within the gather's 1.2 m reach. On, it extends
// emitter light to render.glowReach on terrain at the cost of that overlap --
// worth having as a knob, not as a default.
// + a hand-written rule in LoadTuning
TP_I(render, glowTerrain, TUNE_GLOW_TERRAIN, 0, 0, 1)

// ---- drifting particulate (silt) ----
// Render-only motes in the water volume. This is what gives the shafts
// something to catch, and it is most of why footage reads as underwater.
// ---- silt ----
TP_F(render, siltDensity, TUNE_SILT_DENSITY, 0.55f, 0.0f, 4.0f)
TP_F(render, siltBrightness, TUNE_SILT_BRIGHTNESS, 0.50f, 0.0f, 4.0f)
TP_F(render, siltDrift, TUNE_SILT_DRIFT, 0.05f, 0.0f, 1.0f)

// ---- waterfall mist and spray ----
// Render-only. "Liquid with air under it" is not a field in the voxel word, so
// the renderer derives a falling column from ONE read of the cell below a
// liquid hit and overlays procedural slabs on it -- no particle, no buffer, no
// sim state, nothing hashed. mistDensity <= 0 deletes the whole term at
// shader-compile time, which is why the dry overlook pays nothing for it.
// ---- waterfall mist / spray ----
// Clamped at 0 on the low side so `mistDensity <= 0` stays the ONE off
// switch the shader const-folds on, and generously on the high side
// because these are look knobs with no stability hazard behind them.
TP_F(render, mistDensity, TUNE_MIST_DENSITY, 1.0f, 0.0f, 4.0f)
TP_F(render, mistBrightness, TUNE_MIST_BRIGHTNESS, 0.9f, 0.0f, 4.0f)
TP_F(render, mistRadius, TUNE_MIST_RADIUS, 10.0f, 0.5f, 48.0f)
TP_F(render, mistFallSpeed, TUNE_MIST_FALL_SPEED, 2.2f, 0.0f, 12.0f)
TP_F(render, sprayDensity, TUNE_SPRAY_DENSITY, 1.3f, 0.0f, 4.0f)
TP_F(render, sprayRadius, TUNE_SPRAY_RADIUS, 14.0f, 0.5f, 48.0f)

// ---- surface-from-below ----
// How much the underside of the water surface ripples the view of the sky.
TP_F(render, subSurfaceRipple, TUNE_SUB_SURFACE_RIPPLE, 1.6f, 0.0f, 8.0f)

// ---- the generic per-liquid submerged profile (submergedProfile) ----
// These shape the MAPPING from a liquid's authored opacity + palette to its
// submerged look, so every liquid — including ones added later — gets a
// complete treatment with no shader change. The subAbsorb/subScatter/
// subVisibility values above remain WATER'S refinement, blended in at the
// clear end of the curve rather than selected by a material test.
//
// Visibility in a fully opaque liquid. Being inside oil should be
// claustrophobic — this is the "arm's length" end of the range.
// ---- generic per-liquid submerged profile ----
// Same divide-by-zero hazard as subVisibility: visM is the denominator of
// the extinction term, and a zero there takes a submerged frame to NaN,
// which renders as a black screen the moment you go under.
TP_F(render, subMurkVis, TUNE_SUB_MURK_VIS, 0.55f, 0.05f, 20.0f)
// Exponent applied to clarity for the VISIBILITY mapping only. Separate from
// the clarity curve itself because one shared exponent cannot both collapse
// oil to arm's length and keep water classified as clear (see submergedProfile).
// pow() with a negative exponent on a clarity approaching 0 explodes to
// infinity; 0 would make every liquid equally visible and defeat the knob.
TP_F(render, subVisCurve, TUNE_SUB_VIS_CURVE, 2.2f, 0.05f, 8.0f)
// Opacity -> per-metre absorption gain for the derived (non-clear) case.
TP_F(render, subAbsorbGain, TUNE_SUB_ABSORB_GAIN, 7.0f, 0.0f, 24.0f)
// Absorption floor, so even a notionally clear liquid is not a vacuum.
TP_F(render, subAbsorbFloor, TUNE_SUB_ABSORB_FLOOR, 0.05f, 0.0f, 1.0f)
// How much of its own colour a liquid scatters back at the eye, at the dense
// and clear ends of the clarity curve. A dense liquid IS what you see.
TP_F(render, subScatterDense, TUNE_SUB_SCATTER_DENSE, 0.42f, 0.0f, 2.0f)
TP_F(render, subScatterClear, TUNE_SUB_SCATTER_CLEAR, 0.16f, 0.0f, 2.0f)
// Clarity band over which a liquid crosses from the derived profile onto
// water's hand-tuned coefficients. Water sits at clarity ~0.79, oil ~0.16.
// Widening this band makes more liquids inherit water's look.
// + a hand-written rule in LoadTuning
TP_F(render, subClearLow, TUNE_SUB_CLEAR_LOW, 0.62f, 0.0f, 1.0f)
// + a hand-written rule in LoadTuning
TP_F(render, subClearHigh, TUNE_SUB_CLEAR_HIGH, 0.78f, 0.0f, 1.0f)

// ---- blood / viscous liquids ----
TP_F(render, bloodF0, TUNE_BLOOD_F0, 0.030f, 0.0f, 0.3f)
TP_F(render, bloodGraze, TUNE_BLOOD_GRAZE, 0.55f, 0.0f, 1.0f)
TP_F(render, bloodAbsorb, TUNE_BLOOD_ABSORB, 55.0f, 0.0f, 200.0f)
TP_F(render, bloodTransmit, TUNE_BLOOD_TRANSMIT, 0.35f, 0.0f, 1.0f)
TP_F(render, bloodMaxTransmit, TUNE_BLOOD_MAX_TRANSMIT, 0.06f, 0.0f, 0.5f)
TP_F(render, bloodDepthRamp, TUNE_BLOOD_DEPTH_RAMP, 22.0f, 0.0f, 100.0f)
TP_F(render, bloodPoolLow, TUNE_BLOOD_POOL_LOW, 0.18f, 0.0f, 1.0f)
TP_F(render, bloodPoolHigh, TUNE_BLOOD_POOL_HIGH, 0.55f, 0.0f, 1.0f)
TP_F(render, bloodSmooth, TUNE_BLOOD_SMOOTH, 1.0f, 0.25f, 3.0f)
TP_F(render, bloodEdgeFeather, TUNE_BLOOD_EDGE_FEATHER, 0.10f, 0.0f, 0.6f)
TP_F(render, bloodWobble, TUNE_BLOOD_WOBBLE, 0.004f, 0.0f, 0.05f)
TP_F(render, bloodSheen, TUNE_BLOOD_SHEEN, 1.15f, 0.0f, 5.0f)
TP_F(render, bloodSheenDrop, TUNE_BLOOD_SHEEN_DROP, 32.0f, 2.0f, 2000.0f)
TP_F(render, bloodSheenPool, TUNE_BLOOD_SHEEN_POOL, 220.0f, 2.0f, 2000.0f)
TP_F(render, bloodAmbientSheen, TUNE_BLOOD_AMBIENT_SHEEN, 0.35f, 0.0f, 2.0f)
TP_F(render, bloodEdgeDepth, TUNE_BLOOD_EDGE_DEPTH, 0.035f, 0.0f, 0.5f)
TP_F(render, bloodEdgeStrength, TUNE_BLOOD_EDGE_STRENGTH, 0.65f, 0.0f, 1.0f)
TP_V3(render, bloodEdgeTint, TUNE_BLOOD_EDGE_TINT, 0.55f, 0.40f, 0.38f)

// ---- stains ----
TP_F(render, stainCoverage, TUNE_STAIN_COVERAGE, 1.35f, 0.0f, 4.0f)
TP_F(render, stainMottle, TUNE_STAIN_MOTTLE, 0.85f, 0.0f, 2.0f)
TP_F(render, stainMottleScale, TUNE_STAIN_MOTTLE_SCALE, 0.55f, 0.05f, 4.0f)
TP_F(render, stainDarken, TUNE_STAIN_DARKEN, 0.55f, 0.0f, 1.0f)
TP_F(render, stainOpacity, TUNE_STAIN_OPACITY, 0.70f, 0.0f, 1.0f)
TP_F(render, stainSheen, TUNE_STAIN_SHEEN, 0.55f, 0.0f, 3.0f)
TP_F(render, stainSheenPower, TUNE_STAIN_SHEEN_POWER, 90.0f, 2.0f, 1000.0f)

// ---- lava / embers ----
TP_F(render, lavaCrackFreq, TUNE_LAVA_CRACK_FREQ, 2.4f, 0.1f, 12.0f)
TP_F(render, lavaCrackKneeLow, TUNE_LAVA_CRACK_KNEE_LOW, 0.50f, 0.0f, 1.0f)
TP_F(render, lavaCrackKneeHigh, TUNE_LAVA_CRACK_KNEE_HIGH, 0.90f, 0.0f, 1.0f)
TP_F(render, lavaWarmBias, TUNE_LAVA_WARM_BIAS, 0.035f, -0.3f, 0.6f)
TP_F(render, lavaEmissionGain, TUNE_LAVA_EMISSION_GAIN, 1.9f, 0.0f, 8.0f)
TP_F(render, lavaPulseAmp, TUNE_LAVA_PULSE_AMP, 0.06f, 0.0f, 0.5f)
TP_F(render, lavaPulseRate, TUNE_LAVA_PULSE_RATE, 0.9f, 0.0f, 8.0f)

// ---- tonemap / budgets ----
// + a hand-written rule in LoadTuning
TP_F(render, exposureWhite, TUNE_EXPOSURE_WHITE, 4.2f, 0.2f, 32.0f)
TP_F(render, bleachAmount, TUNE_BLEACH_AMOUNT, 0.9f, 0.0f, 1.0f)
// + a hand-written rule in LoadTuning
TP_F(render, gamma, TUNE_GAMMA, 2.2f, 1.0f, 3.2f)

// ---- static micro-detail ----
TP_F(render, microLodDist, TUNE_MICRO_LOD_DIST, 40.0f, 0.0f, 200.0f)
TP_F(render, plantLodDist, TUNE_PLANT_LOD_DIST, 16.0f, 0.0f, 200.0f)
// A negative micro budget would underflow the shader's u32 counter and
// uncap the very thing the knob exists to bound; 0 means "never nest",
// which is a legitimate way to turn the feature off by eye.
TP_I(render, microMaxPerRay, TUNE_MICRO_MAX_PER_RAY, 8, 0, 32)
// The sway models are authored with a 2-sub-voxel wall margin; a larger
// amplitude shears blade tips out of the cell where they simply vanish.
TP_F(render, microSwayAmp, TUNE_MICRO_SWAY_AMP, 1.5f, 0.0f, 2.0f)
TP_F(render, microSwaySpeed, TUNE_MICRO_SWAY_SPEED, 1.0f, 0.0f, 6.0f)
TP_F(render, trampleRecover, TUNE_TRAMPLE_RECOVER, 1.4f, 0.05f, 6.0f)
TP_F(render, trampleDepth, TUNE_TRAMPLE_DEPTH, 0.8f, 0.0f, 0.95f)
TP_F(render, trampleLean, TUNE_TRAMPLE_LEAN, 0.35f, 0.0f, 1.0f)
TP_F(render, trampleRadius, TUNE_TRAMPLE_RADIUS, 1.5f, 0.0f, 4.0f)
TP_I(render, primarySteps, TUNE_PRIMARY_STEPS, 4096, 1, 8192)
TP_I(render, farSteps, TUNE_FAR_STEPS, 384, 1, 2048)
// A zero/negative reach would clamp to the 8-step floor everywhere and
// silently drop far shadows; keep it positive.
TP_F(render, farShadowReach, TUNE_FAR_SHADOW_REACH, 60.0f, 1.0f, 400.0f)
// A level cap, so the legal range is 0 (off) .. kFarLevels. Out-of-range
// values are not merely useless here: the shader compares it against a
// 1-based level, so a negative would read as "off" by accident rather
// than by intent and anything past the top level is a lie about coverage.
TP_I(render, farBlockerHitLevel, TUNE_FAR_BLOCKER_HIT_LEVEL, 0, 0, kFarLevels)
// The far SURFACE MAP refine (LOD-seam package A, world.h kFarMap*): the
// highest cascade level whose surface cells traceFar refines against the
// map's 2x-resolution sub-columns. A level cap like the one above, so 0
// (off: the plain centre-sampled cells, the feature's A/B) .. kFarLevels.
TP_I(render, farRefineLevel, TUNE_FAR_REFINE_LEVEL, 2, 0, kFarLevels)

// ---- gas voxel -> parcel crossfade (PLAN_gas_particles.md stage 1b) ----
// The LOD handoff must not land in front of the near clip: a zero here
// would hand EVERY ray to the cascade at t=0 and render the world as
// 40 cm blocks from the camera outward. Floored at 2 m, which is still
// absurdly near but is a knob setting rather than a broken frame. There is
// deliberately no ceiling — >= 25.6 m disables the handoff, which is the
// documented way to A/B it.
// A fraction of the window half-extent. Below 0 the band would start
// outside the box on the far side; above 1 it would never reach 1 at the
// face and the seam would come back with a step in it.
TP_F(render, gasBlendStart, TUNE_GAS_BLEND_START, 0.5f, 0.0f, 1.0f)

// ---- far FIRE PLUMES: smoke from fires the window has left behind ----
// Render-only, and in the render group for that reason rather than for
// convenience: nothing here reaches the CA or the parcel pool. Strength is a
// density multiplier and 0 is the exact off switch (no row recorded at all);
// height is how far the synthesized column climbs, in METRES.
// Far fire plumes. 0 is the off switch and must stay reachable, so the
// floor is 0 rather than a small positive; the ceiling keeps a mistyped
// value from saturating every cell of the density box (GAS_OUTER_MAX) and
// fogging the whole horizon white. Height is clamped to the box's own
// half-extent in metres — past that the shader clamps anyway, and a knob
// whose top half does nothing is a knob that reads as broken.
TP_F(render, farPlumeStrength, TUNE_FAR_PLUME_STRENGTH, 1.0f, 0.0f, 16.0f)
// + a hand-written rule in LoadTuning
TP_F(render, farPlumeHeight, TUNE_FAR_PLUME_HEIGHT, 28.0f, 0.0f, 409.6f)
// How far out a frozen fire still smokes, in METRES. Clamped to the long-range
// box's own half-extent; 0 leaves the wide list empty, which is the exact off
// switch for the whole long-range half.
// The long-range reach, clamped to the box that holds it: half of
// (kGasFarOuterN << kGasFarOuterShift) voxels, in metres. Past that an
// emitter is outside the box and the splat would drop it anyway, so the
// clamp turns "does nothing" into "is the maximum".
// + a hand-written rule in LoadTuning
TP_F(render, farPlumeRange, TUNE_FAR_PLUME_RANGE, 3276.8f, 0.0f, 3276.8f)

// ---- in-window LOD handoff (PLAN_surface_flight_perf.md A1) ----
TP_F(render, lodHandoffDist, TUNE_LOD_HANDOFF_DIST, 20.5f, 2.0f, 60.0f)
// 0 is meaningful here (all shadows go through the cascade), so only
// negatives are refused.
TP_F(render, shadowMaxDist, TUNE_SHADOW_MAX_DIST, 999.0f, 0.0f, 999.0f)

// ---- SHORT-RANGE MODE (dev panel checkbox, RenderParams flag bit 2) ----
// The look/perf comparison arm: a hard ray ceiling plus a fog ramp that hides
// it, the way the fixed-100 m WebGPU voxel engines do it. These three shape
// the mode; whether it is ON is NOT a tuning value (it is overlay state, so
// toggling it cannot rewrite the user's tuning.json).
// ---- short-range mode ----
// The ceiling divides the fog ramp's span, so it must stay positive; 4 m
// is under the near field's own reach and is already an absurd setting,
// but it is a setting rather than a NaN frame.
TP_F(render, shortRangeDist, TUNE_SHORT_RANGE_DIST, 100.0f, 4.0f, 2000.0f)
TP_F(render, shortRangeNearDist, TUNE_SHORT_RANGE_NEAR_DIST, 50.0f, 4.0f, 2000.0f)
// The start fraction is a fraction. 0.95 rather than 1.0 at the top so the
// ramp always has a span to run over.
TP_F(render, shortRangeFogStart, TUNE_SHORT_RANGE_FOG_START, 0.65f, 0.0f, 0.95f)
// Zero density would renormalise 0/0 at the ceiling.
TP_F(render, shortRangeFogDensity, TUNE_SHORT_RANGE_FOG_DENSITY, 5.0f, 0.05f, 24.0f)

// ---- wind: the SHAPE of the field (docs/RESEARCH_wind.md, DESIGN.md 12) ----
// These are the parts of windAt() that are authored once and const-folded into
// every shader. The parts that EVOLVE (direction, speed, gust amplitude) are
// not here — they come out of WindWeather() on the CPU and ride RenderParams,
// because a compile-time constant cannot drift over minutes.
// Human-unit floats, not sim.* integers, and that is now load-bearing in both
// directions: windAtQ (common.wgsl) const-evals these into integers exactly the
// way sim_fluid.wgsl converts its own human-unit knobs, so the sim kernels that
// read the field stay integer while the knobs stay in metres and seconds.
// Clamps, in the order they can bite.
//
// A zero or negative gust wavelength is an infinite spatial frequency: the
// gust phase changes by more than pi between adjacent samples and the
// "field" aliases into per-cell noise. The shader has its own guard on
// this constant (WIND_GUST_K) because a shader compiled offline never
// passes through here at all.
TP_F(wind, gustWavelength, TUNE_WIND_GUST_WAVELENGTH, 4.8f, 0.25f, 60.0f)
TP_F(wind, gustSpeed, TUNE_WIND_GUST_SPEED, 0.35f, 0.0f, 5.0f)
// The overlay's cost is cubic in radius/spacing, and the arrow count is
// computed identically on the CPU (for the instance count) and in the
// vertex shader (for the lattice). Clamping the INPUTS here is what keeps
// those two derivations agreeing about a silly value instead of one of
// them saturating and the other not.
TP_F(wind, dbgWindSpacing, TUNE_WIND_DBG_SPACING, 8.0f, 1.0f, 64.0f)
TP_F(wind, dbgWindRadius, TUNE_WIND_DBG_RADIUS, 48.0f, 0.0f, 256.0f)

// ---- sim: DETERMINISM-CRITICAL, integer only (CLAUDE.md rule 1) ----
TP_I(sim, partGravity, TUNE_PART_GRAVITY, 22, 0, 256)
TP_I(sim, partMaxVel, TUNE_PART_MAX_VEL, 1536, 64, 8192)
TP_I(sim, partBuoyMax, TUNE_PART_BUOY_MAX, 88, 0, 512)
TP_I(sim, partSettleSpeed, TUNE_PART_SETTLE_SPEED, 24, 0, 256)
TP_U(sim, partFloatPatience, TUNE_PART_FLOAT_PATIENCE, 180, 0, 1800)
TP_I(sim, airDensity, TUNE_AIR_DENSITY, 10, 0, 2000)
// A zero falloff makes every explosion reach the full residency window:
// not a crash, but a guaranteed frame-time cliff and an unbounded emergent
// process (CLAUDE.md rule 2). Clamp rather than trust the file.
TP_I(sim, falloffPerCell, TUNE_FALLOFF_PER_CELL, 6, 1, 64)
TP_U(sim, ejectSolid, TUNE_EJECT_SOLID, 250, 0, 1000)
TP_U(sim, ejectLiquid, TUNE_EJECT_LIQUID, 500, 0, 1000)
TP_U(sim, ejectPowder, TUNE_EJECT_POWDER, 350, 0, 1000)
TP_U(sim, ejectGas, TUNE_EJECT_GAS, 0, 0, 1000)
TP_U(sim, liquidEqualize, TUNE_LIQUID_EQUALIZE, 2, 1, 7)
// 1 is "no floor" — the pre-WP5 halving, kept reachable as the A/B oracle.
// The upper bound is 4 because the rule needs f >= 2*minFilm to split at
// all, and a cell holds 8: past 4 no cell could ever spread into air and
// water would stop advancing across a flat floor entirely.
TP_U(sim, liquidMinFilm, TUNE_LIQUID_MIN_FILM, 1, 1, 4)
// Sub-voxel angle of repose (docs/PLAN_powder_mass.md P5): 1 = a resting
// powder sheds EIGHTHS sideways by column-top height, and worldgen lays its
// loose cover's step columns as partial cells (edge 4/8, stair 6/8) that are
// already at rest under that rule. 0 = whole-cell repose and whole-cell tops.
// The CA and worldgen read the same row, so they cannot disagree.
TP_U(sim, powderFineRepose, TUNE_POWDER_FINE_REPOSE, 1, 0, 1)
TP_U(sim, wanderHopMask, TUNE_WANDER_HOP_MASK, 7, 0, 255)
// THE SOLUTE LAYER (docs/PLAN_solutes.md, DESIGN.md "Solutes"). soluteMode
// 0 is the off switch the CA reads: no powder dissolves (the aux layer then
// stays empty and every solute pass dispatches over nothing). 1 = on.
TP_U(sim, soluteMode, TUNE_SOLUTE_MODE, 1, 0, 1)
// A percentage scale on every species' authored `diffusivity` (solutes.json),
// so one --sweep proves the pair exchange reaches the kernel. 0 freezes
// dissolved mass where the current left it; 100 is the authored rate.
TP_U(sim, soluteDiffusion, TUNE_SOLUTE_DIFFUSION, 100, 0, 400)
TP_U(sim, expMicroPerMille, TUNE_EXP_MICRO_PERMILLE, 900, 0, 1000)
// Both of these are packed into bit fields in Particle.flags; an
// out-of-range value would wrap into the neighbouring field rather than
// merely looking wrong, so clamp instead of trusting the file.
TP_U(sim, expMicroLifeTicks, TUNE_EXP_MICRO_LIFE, 40, 1, 255)
TP_U(sim, expMicroScaleIdx, TUNE_EXP_MICRO_SCALE_IDX, 2, 0, 3)
// ---- MLS-MPM fluid, HUMAN units ----
// These are floats in real units (voxels/s², voxels/s, vox²/s, seconds) —
// the ONE deliberate exception to "sim.* is integer-only". The kernel still
// never sees a runtime float: sim_fluid.wgsl converts each to Q16.16-per-tick
// at SHADER COMPILE TIME (WGSL const-eval, IEEE-exact, identical on every
// machine for identical JSON), so rule 1's actual guarantee is intact and the
// fluid-det gate stays the enforcement.
// Units: stiffness/cohesion/attract in (vox/s)^2, gravity vox/s^2, rest
// density particles/voxel, viscosity vox^2/s, damping fraction/s, splash rate
// droplets/s, splash speed vox/s, splash life seconds.
// fluidSubsteps is the CFL budget and pairs with stiffness: the pseudo sound
// speed sqrt(stiffness) must fit under 0.45 cells/substep, so substeps >=
// sqrt(stiffness)/(30*0.45). At the 14000 default that is 8.7 -> 9. It is
// also the fluid's terminal velocity (VMAX = 0.45*substeps cells/tick) and
// the solver's whole per-tick price, so it is the one dial where the look and
// the cost are the same number.
// Substeps: the CFL budget and the solver's price. The 32 ceiling is the
// pass-table/timer sanity bound (the substep table is recorded this many
// times per tick); the 1 floor keeps every /FLUID_SUBSTEPS in the kernels
// legal. Not warned against stiffness here — an under-budgeted stiffness
// is legal, just clamped (FA_CLAMPED is the probe that says so).
TP_I(sim, fluidSubsteps, TUNE_FLUID_SUBSTEPS, 9, 1, 32)
// The float ranges below keep the CONVERTED values inside the ranges the
// kernel's i32 overflow audit assumes — the human bound is the fixed-point
// bound expressed in the human unit (x900 for per-tick² quantities, x30 for
// per-tick). Out-of-range values would wrap i32 mid-kernel, not merely look
// wrong, so the loader clamps rather than trusting the file.
// 48 c²/t²
TP_F(sim, fluidStiffness, TUNE_FLUID_STIFFNESS, 14000.0f, 0.0f, 43200.0f)
// 2 c/t²
TP_F(sim, fluidGravity, TUNE_FLUID_GRAVITY, 900.0f, 0.0f, 1800.0f)
TP_F(sim, fluidRestDensity, TUNE_FLUID_REST_DENSITY, 8.0f, 1.0f, 32.0f)
TP_I(sim, fluidEosPower, TUNE_FLUID_EOS_POWER, 4, 1, 7)
// 16 c²/t²
TP_F(sim, fluidCohesion, TUNE_FLUID_COHESION, 0.0f, 0.0f, 14400.0f)
TP_F(sim, fluidAttractSame, TUNE_FLUID_ATTRACT_SAME, 0.0f, -7200.0f, 7200.0f)
TP_F(sim, fluidAttractDiff, TUNE_FLUID_ATTRACT_DIFF, 0.0f, -7200.0f, 7200.0f)
// 8 c²/t
TP_F(sim, fluidViscosity, TUNE_FLUID_VISCOSITY, 0.0f, 0.0f, 240.0f)
// <0.9/tick
TP_F(sim, fluidDamping, TUNE_FLUID_DAMPING, 0.0f, 0.0f, 20.0f)
// <0.9/tick
TP_F(sim, fluidFriction, TUNE_FLUID_FRICTION, 0.0f, 0.0f, 20.0f)
// Splash coupling: fast free-surface particles shed micro droplets into the
// ballistic particle system (sim_fluid.wgsl g2p).
// <=1/substep
TP_F(sim, fluidSplashRate, TUNE_FLUID_SPLASH_RATE, 4.0f, 0.0f, 180.0f)
// < VMAX
TP_F(sim, fluidSplashSpeed, TUNE_FLUID_SPLASH_SPEED, 18.0f, 0.0f, 90.0f)
TP_F(sim, fluidSplashMaxDensity, TUNE_FLUID_SPLASH_MAXDENS, 0.7f, 0.0f, 4.0f)
// 255 ticks
TP_F(sim, fluidSplashLife, TUNE_FLUID_SPLASH_LIFE, 1.1f, 0.05f, 8.5f)
TP_U(sim, fluidSplashScaleIdx, TUNE_FLUID_SPLASH_SCALE_IDX, 2, 0, 3)
// ---- diffuse material: spray / foam / bubbles (Ihmsen et al. 2012, CGI) ----
// Three potentials, each mapped to 0..1 by the paper's clamping function
//   Phi(I, tmin, tmax) = (min(I,tmax) - min(I,tmin)) / (tmax - tmin),
// then combined as  n_d = I_k * (k_ta * I_ta + k_wc * I_wc) * dt   (Eq. 8).
// Trapped air is a convergence-weighted relative-velocity sum over the node
// neighbourhood; wave crest is a convexity-gated curvature of the density
// gradient; energy is the particle's kinetic energy. Thresholds are in the
// natural unit of each measure so the tuner reads in vox/s and (vox/s)^2.
// Diffuse material (spray/foam/bubbles). Same discipline as the splash
// rows: these become Q16.16-per-tick constants and bit fields at shader
// compile time, so an out-of-range value wraps i32 or bleeds into the
// neighbouring flag field rather than merely looking wrong.
// <=1/substep
TP_F(sim, fluidFoamRate, TUNE_FLUID_FOAM_RATE, 90.0f, 0.0f, 180.0f)
TP_F(sim, fluidFoamCrestRate, TUNE_FLUID_FOAM_CREST_RATE, 120.0f, 0.0f, 180.0f)
// + a hand-written rule in LoadTuning
TP_F(sim, fluidTrappedMin, TUNE_FLUID_TRAPPED_MIN, 1.5f, 0.0f, 400.0f)
// + a hand-written rule in LoadTuning
TP_F(sim, fluidTrappedMax, TUNE_FLUID_TRAPPED_MAX, 11.0f, 0.0f, 400.0f)
// + a hand-written rule in LoadTuning
TP_F(sim, fluidCrestMin, TUNE_FLUID_CREST_MIN, 0.25f, 0.0f, 64.0f)
// + a hand-written rule in LoadTuning
TP_F(sim, fluidCrestMax, TUNE_FLUID_CREST_MAX, 2.0f, 0.0f, 64.0f)
// + a hand-written rule in LoadTuning
TP_F(sim, fluidFoamEnergyMin, TUNE_FLUID_FOAM_EMIN, 8.0f, 0.0f, 8100.0f)
// + a hand-written rule in LoadTuning
TP_F(sim, fluidFoamEnergyMax, TUNE_FLUID_FOAM_EMAX, 260.0f, 0.0f, 8100.0f)
// 255 ticks
// + a hand-written rule in LoadTuning
TP_F(sim, fluidFoamLife, TUNE_FLUID_FOAM_LIFE, 2.2f, 0.05f, 8.5f)
// + a hand-written rule in LoadTuning
TP_F(sim, fluidFoamLifeMin, TUNE_FLUID_FOAM_LIFE_MIN, 0.5f, 0.05f, 8.5f)
TP_F(sim, fluidBubbleBuoyancy, TUNE_FLUID_BUBBLE_BUOY, 1.6f, -4.0f, 8.0f)
// kd in 0..1
TP_F(sim, fluidFoamDrag, TUNE_FLUID_FOAM_DRAG, 0.72f, 0.0f, 1.0f)
TP_F(sim, fluidBubbleDensity, TUNE_FLUID_BUBBLE_RHO, 1.05f, 0.0f, 4.0f)
TP_F(sim, fluidSprayDensity, TUNE_FLUID_SPRAY_RHO, 0.42f, 0.0f, 4.0f)
TP_U(sim, fluidFoamScaleIdx, TUNE_FLUID_FOAM_SCALE_IDX, 3, 0, 3)
// ---- MLS-MPM settle / excite seam ----
// The CA <-> particle handover. Units: settle/wake speeds vox/s, settle
// window in ticks, stain rate chances/s. exciteMode is a switch: 0 = the CA
// owns disturbed settled liquid (Phase-2 default, keeps the pinned world
// hash), 1 = settled liquid with air below converts to MPM particles.
// wakeSpeed defaults to 4x settleEps — that gap is the hysteresis that stops
// blocks flickering between the two states.
// exciteCeiling / exciteRate are the WP5 burst bound, in PARTICLES (8 per
// water voxel). The ceiling is how much of the world's water the seam will
// ever have live at once; the rate is how fast it may get there. Neither
// applies to explicit spawns (the mpm tool, the lab pours) — pouring water is
// something the player did, a lake exciting itself is not.
// Settle/excite seam. Floats through the same clampWarnF discipline; the
// int windows are open-coded like fluidEosPower. The settleTicks floor of
// 8 is a HARD requirement — it covers the CPU-side page-materialization
// readback latency (see tuning.h), so it clamps rather than warns-only.
TP_I(sim, fluidExciteMode, TUNE_FLUID_EXCITE_MODE, 1, 0, 1)
// The burst bound. 256 is the floor rather than 0 because a ceiling of
// zero would silently turn excite off entirely — that is what
// fluidExciteMode is for, and two ways to spell "off" is one too many.
// The upper bound is the pool: a ceiling above kFluidCap is not a bound.
TP_I(sim, fluidExciteCeiling, TUNE_FLUID_EXCITE_CEILING, 8000, 256, 262144)
TP_I(sim, fluidExciteRate, TUNE_FLUID_EXCITE_RATE, 4096, 64, 262144)
TP_I(sim, fluidExcitePerch, TUNE_FLUID_EXCITE_PERCH, 0, 0, 1)
// exciteStep is the SURFACE-DISTURBANCE trigger, in whole cells: a body of
// water whose surface stands this many cells proud of the water surface beside
// it is a splash, not a pool, and goes to the solver so it lands with momentum
// instead of relaxing in place. 0 disables it. Measured against the water
// surface, so it is immune to the eighth-level shot noise a settle leaves.
// 8 is the seam's own surface scan depth (SEAM_EX_STEP_SCAN); a step it
// cannot see is a trigger that never fires, so the knob stops there.
TP_I(sim, fluidExciteStep, TUNE_FLUID_EXCITE_STEP, 2, 0, 8)
// How much of a SETTLED liquid cell's content the MPM grid carries as static
// mass, as a fraction of rest density (1.0 = a full voxel reads exactly rest).
// 0 restores the WP4 behaviour where the two representations pass through each
// other. See the seeding block in sim_fluid.wgsl clearGrid.
// The WGSL side folds this to a Q8 scale (sim_fluid.wgsl
// FLUID_SETTLED_Q8); past ~2 the static boundary out-pressures the fluid
// and fires particles off a still pool.
TP_F(sim, fluidSettledMass, TUNE_FLUID_SETTLED_MASS, 1.0f, 0.0f, 2.0f)
// Does SUBMERGED settled liquid act as a boundary for MPM particles? The
// static mass above puts a density STEP at the interface, which stops a slow
// particle, but the field below it is flat rest with no depth profile — so a
// particle with downward momentum punches through and free-falls through water
// the solver cannot see. A buried particle can never settle back (a submerged
// column has no room by construction), so this is the termination fix, not a
// cosmetic one. 0 is the control arm for `--sweep sim.fluidSubmergedSolid=0,1`.
TP_I(sim, fluidSubmergedSolid, TUNE_FLUID_SUBMERGED_SOLID, 1, 0, 1)
TP_F(sim, fluidSettleEps, TUNE_FLUID_SETTLE_EPS, 6.0f, 0.05f, 20.0f)
TP_F(sim, fluidWakeSpeed, TUNE_FLUID_WAKE_SPEED, 24.0f, 0.1f, 50.0f)
TP_I(sim, fluidSettleTicks, TUNE_FLUID_SETTLE_TICKS, 24, 8, 600)

// ---- THE FORCE-SETTLE BACKSTOP (rule 2's termination guarantee) ------------
// settleColumn walks its own 16 cells plus SETTLE_SPILL more, so a SUBMERGED
// column has no room by construction and refuses forever. Measured at the
// authored home_lake 2026-09-08: 7,610 particles alive and flat in a world with
// 0 awake chunks, 40 of 40 picked blocks refused, 2,060 columns per 20 ticks
// hitting the spill ceiling and 0 for any other reason, 0 eighths converted —
// 3.7 ms/frame of solver that can never finish. These three knobs are the
// escape hatch, and turning stuckTicks to 0 disables the whole path.
//
// The age must key on particle EXISTENCE, not on refusal: once submerged cells
// can no longer excite, the stuck blocks are never CALM either, so they are
// never picked and a refusal-triggered counter would never fire.
// The force-settle backstop. 0 is a legal value for stuckTicks — it is the
// off switch — so the floor is 0, not the 8 fluidSettleTicks needs. The
// ceiling on reach is what bounds the forced walk's write set, and the
// block budget is capped at kFluidSettleMax because the forced picks share
// settleScan's list with the calm ones.
TP_I(sim, fluidStuckTicks, TUNE_FLUID_STUCK_TICKS, 96, 0, 6000)
// Forced blocks per tick. Small on purpose: a forced walk's write set reaches
// past SETTLE_SPILL, so forced picks take a stricter exclusion (no two may
// share an (x,z) chunk column) and the budget bounds the drain rate.
TP_I(sim, fluidForceBlocks, TUNE_FLUID_FORCE_BLOCKS, 4, 0, kFluidSettleMax)
// How many cells past the spill ceiling a forced walk may climb looking for
// room. Buried mass belongs at the column's free surface; this bounds the
// search. Exhausting it means a genuinely sealed column, which is counted
// rather than silently retried.
TP_I(sim, fluidForceReach, TUNE_FLUID_FORCE_REACH, 64, 0, 512)

// ---- WATER BODIES (docs/PLAN_water_master.md, M1) ----
// A still lake gets a NAME and a small record of aggregates, so that from M2
// draining it is arithmetic on that record instead of pressure propagating cell
// by cell through 87,000 voxels. Every knob here is integer (rule 1); the
// physical quantities components 6 and 8 need are floats and land with them.
// waterBodyMode is the off switch and it is 0: at 0 nothing is built, nothing
// is labelled, nothing is classified, so `--sweep sim.waterBodyMode=0,1` is one
// hash and this whole subsystem cannot move the pinned world.
// Volumes are EIGHTHS (the CA's state nibble is eighths, so the ledger is too).
// The enter/exit pairs are deliberately far apart: a body parked on one
// threshold would flip representation every tick, and every flip is a seam
// crossing where mass can be lost.
// ---- water bodies (docs/PLAN_water_master.md) ----
TP_I(sim, waterBodyMode, TUNE_WATER_BODY_MODE, 0, 0, 1)
// + a hand-written rule in LoadTuning
TP_I(sim, waterBodyMinVolume, TUNE_WATER_BODY_MIN_VOLUME, 65536, 0, 16777216)
// + a hand-written rule in LoadTuning
TP_I(sim, waterBodyExitVolume, TUNE_WATER_BODY_EXIT_VOLUME, 32768, 0, 16777216)
TP_I(sim, waterBodyQuietTicks, TUNE_WATER_BODY_QUIET_TICKS, 30, 0, 3600)
// kWaterBodyCap (sim/waterbody.h) is the hard ceiling: from M2 the
// descriptor array is a GPU layout, and a count past its end is not a
// tuning mistake, it is an out-of-bounds write.
TP_I(sim, waterBodyMaxCount, TUNE_WATER_BODY_MAX_COUNT, 64, 0, kWaterBodyCap)
TP_I(sim, waterBodyTestDrain, TUNE_WATER_BODY_TEST_DRAIN, 0, 0, 65536)

// ---- THE DISCHARGE LAW (component 6, M3) ----
// A hole under a body of water is an orifice: Q = Cd * A * sqrt(2 g h). The
// RATE knob is integer (rule 1) and it is the rule-2 bound on the jet — the
// ledger debits by what the op block actually emitted, never by the analytic Q,
// so lowering it slows a drain and can never lose an eighth. The two PHYSICAL
// quantities are human-unit floats in the sanctioned sim.fluid* lane: they are
// const-eval'd to fixed point at the top of sim_waterbody.wgsl by Tint under
// IEEE-exact rules, so the kernel stays integer and bit-deterministic.
// drainExciteRadius is component 7's v1 shell radius; 0 is an exact identity.
// ---- the discharge law (component 6) -------------------------------
// The rate cap is the rule-2 bound on the jet AND the size of the spawn-op
// block the CPU reserves, so it is clamped to kWaterDrainOpsPerBody here
// rather than in the kernel: an emission the block cannot hold would be a
// debit with no particle behind it, which is exactly the mass pump plan §6
// forbids. 0 turns the discharge off with no other effect.
TP_I(sim, drainMaxEighthsPerTick, TUNE_DRAIN_MAX_EIGHTHS, 512, 0, kWaterDrainOpsPerBody)
// Component 7's shell radius. Bounded because the shell is a DISC of cells
// at the free surface plus a column: at r the surface term is ~pi*r^2 cells
// of up to 8 eighths each, and plan §9 item 2 is that a violent drain's
// solid-ball excite is ~33,000 particles against a ~40,000 envelope. 32
// caps the disc at ~3,200 cells, which the 8,000 excite ceiling refuses
// gracefully rather than converting the pool.
TP_I(sim, drainExciteRadius, TUNE_DRAIN_EXCITE_RADIUS, 6, 0, 32)
// Cd above 1 is not a discharge coefficient, it is a mass source. The
// gravity bound is the fluid lane's, for the same fixed-point reason.
TP_F(sim, drainCd, TUNE_DRAIN_CD, 0.6f, 0.0f, 1.0f)
TP_F(sim, drainGravity, TUNE_DRAIN_GRAVITY, 900.0f, 0.0f, 4000.0f)

// ---- RELEVEL (docs/PLAN_water_relevel.md W1) ----
// The shave's mirror image: a disturbed body's columns relax toward the body's
// own mean surface instead of waiting on a reach-1 CA that provably cannot
// flatten a ramp of 1 eighth per 2 cells. All three are integer (rule 1) and
// they are const-eval'd where they are read, so nothing here reaches a kernel
// as an f32.
// waterRelevelMax is the off switch AND the rate: at 0 both new passes return
// after their first comparison and the world is bit-identical to a build
// without W1, which is what `--sweep sim.waterRelevelMax=0,4` states.
// waterRelevelDepth is clamped in the shader to world.h's
// kWaterRelevelDepthMax, which is what the histogram block is sized from.
// ---- relevel (docs/PLAN_water_relevel.md W1) ------------------------
// The rate cap is a WHOLE VOXEL, for the shave's own reason (WB_MAX_STEPS):
// a column that moves more than 8 eighths in a tick is not water finding
// its level, it is a bulldozer, and the give branch cannot honour it
// without emptying a second cell anyway. 0 is the identity arm.
TP_I(sim, waterRelevelMax, TUNE_WATER_RELEVEL_MAX, 4, 0, 8)
// A gain of 0 is a divide by zero in the kernel's k(s).
TP_I(sim, waterRelevelGain, TUNE_WATER_RELEVEL_GAIN, 8, 1, 256)
// Clamped to the ceiling the HISTOGRAM BLOCK is sized from (world.h's
// kWaterRelevelDepthMax). Asking for more buckets than the buffer holds is
// not an approximation, it is another body's block.
TP_I(sim, waterRelevelDepth, TUNE_WATER_RELEVEL_DEPTH, 32, 0, kWaterRelevelDepthMax)

// ---- SURFACE MOMENTUM (docs/PLAN_water_relevel.md W2) ----
// The relevel relaxes and never overshoots. This is the overshoot: four
// non-negative outflow pipes per column (Mei/O'Brien), so the columns beside a
// crater accelerate into it, arrive with momentum and ring.
// waveMode is the off switch: at 0 the `waterFlux` pass row is not recorded at
// all and the apply's wave term is not evaluated, so the world is bit-identical
// to a build without W2 -- which is what `--sweep sim.waveMode=0,1` states.
// waveGravity is the sanctioned human-unit lane (VOXELS/s^2, like
// drainGravity): const-eval'd to Q8 cells/tick^2 at the top of
// sim_waterbody.wgsl under IEEE-exact folding, so the kernel stays integer.
// 98 vox/s^2 is real gravity at kVoxelsPerMetre = 10; with waveDepthCap 10 the
// wave speed sqrt(g*d) is ~1.04 cells/tick, i.e. the CFL limit, which is why
// the depth term is capped rather than taken from a deep lake.
// waveDamping is per SECOND and sets how long the ring lasts; waveSleepEps is
// the Q8 pipe magnitude a body must be strictly under to count as still, and
// 256 is not a tolerance -- a pipe moves `q >> 8` whole eighths, so under 256
// it moves nothing. A body sleeps after sim.fluidSettleTicks such ticks.
// + a hand-written rule in LoadTuning
TP_I(sim, waveMode, TUNE_WAVE_MODE, 0, 0, 1)
// A SANITY bound rather than the stability argument. The wave speed is
// sqrt(g * depth) cells/tick and a reach-1 update cannot carry a ring
// faster than one cell per tick; what actually holds that is the kernel's
// own outflow clamp (a column may never give more than its top cell), so
// these two only catch a typo rather than a physics error.
TP_F(sim, waveGravity, TUNE_WAVE_GRAVITY, 98.0f, 0.0f, 4000.0f)
TP_I(sim, waveDepthCap, TUNE_WAVE_DEPTH_CAP, 10, 1, 64)
// Per SECOND, and 30 is one whole tick: a pipe that lost more than all of
// its flux in a tick is "no momentum at all" written confusingly.
TP_F(sim, waveDamping, TUNE_WAVE_DAMPING, 0.8f, 0.0f, 30.0f)
// 0 is legal and means "never counts as still by itself", so the body
// sleeps only once the relevel reports it flat. Negative is a typo.
TP_I(sim, waveSleepEps, TUNE_WAVE_SLEEP_EPS, 256, 0, 4096)

// ---- W3: WHAT DISTURBS THE SURFACE (docs/PLAN_water_relevel.md section 5) ----
// Three sources, three knobs, each an identity at 0 and each independent of the
// other two. All integer (rule 1): they are Q8 pipe flux, which is the unit the
// pipes already carry, so nothing here needs the human-unit float lane.
// waveBlastImpulse and waveSwimWake are spent on the CPU -- they scale the
// `strength` word of a TickParams impulse record, and at 0 no record is emitted
// at all, so the count stays 0 and wbFlux's loop does not execute. That is why
// neither is read as a TUNE_ const and why `--sweep` on either reports one hash
// on a script that blows nothing up and swims nowhere: the reachability proof
// for these two is the GATE, not the sweep (W-D learned the same lesson).
// waveDrainSink IS a kernel const, because the sink is generated GPU-side from
// WBS_EMIT -- a live discharge is a fact only the ledger knows.
// + a hand-written rule in LoadTuning
TP_I(sim, waveBlastImpulse, TUNE_WAVE_BLAST_IMPULSE, 3072, 0, 65536)
// + a hand-written rule in LoadTuning
TP_I(sim, waveDrainSink, TUNE_WAVE_DRAIN_SINK, 1024, 0, 65536)
// + a hand-written rule in LoadTuning
TP_I(sim, waveSwimWake, TUNE_WAVE_SWIM_WAKE, 512, 0, 65536)

// ---- DISCOVERY (docs/PLAN_water_relevel.md W-D) ----
// A body the PLAYER created gets adopted; puddles stay CA at no cost. Both are
// integer (rule 1). Neither is read by a kernel as a TUNE_ const:
// waterDiscoverMinEighths lives entirely on the CPU (it decides whether a probe
// disc is proposed at all) and waterAdoptMinArea rides TickParams, so a gate can
// move either with SetCurrentTuning and pay no pipeline rebuild.
// waterDiscoverMinEighths is the off switch: at 0 no evidence is accumulated, no
// probe is ever raised, no descriptor carries WBF_DISCOVER and the world is
// bit-identical to a build without W-D.
// W-D. A negative threshold would read as "off" by accident rather than on
// purpose; 0 is the deliberate off switch and is left alone.
TP_I(sim, waterDiscoverMinEighths, TUNE_WATER_DISCOVER_MIN_EIGHTHS, 4096, 0, 1000000)
// A size gate of 0 adopts anything the volume threshold already let through,
// which is a legal (if pointless) configuration; a negative one is a typo.
TP_I(sim, waterAdoptMinArea, TUNE_WATER_ADOPT_MIN_AREA, 64, 0, 100000)

// ---- wind COUPLING: how hard the field pushes the sim (research doc §4.5/4.6)
// The SHAPE of the field is the wind.* group far above; this is what the three
// sim consumers do with it. Human-unit floats for the sim.fluid* reason and by
// the same mechanism: every one is const-eval'd to an integer at the top of the
// kernel that reads it, so nothing here puts an f32 in a sim kernel.
// Speeds are m/s, rates are per-second, chances are probabilities.
// windMode is the gate and the only thing here that can move the world hash:
// 0 off, 1 drift bias, 2 also settled-powder entrainment (kWindMode* in
// world.h says what each promises about rule 2).
// + a hand-written rule in LoadTuning
TP_I(sim, windMode, TUNE_WIND_MODE, 1, kWindModeOff, kWindModeEntrain)
// ---- gas particles (docs/PLAN_gas_particles.md) ----
// The residency edge: 0 = WALL (what it was before stage 1 — a gas voxel that
// wants out sheets along the top plane instead), 1 = SINK (it converts to a
// parcel that keeps drifting outside the window). The gate, and the only thing
// in this block that can move the world hash; at 0 no gas pass is recorded at
// all, so it is an exact off switch and not a cheap path.
// Wind coupling. The gate first: an unknown mode must not fall through to
// "some wind", because the whole hash argument for shipping this is that
// mode 0 means literally no kernel reads the field.
// The gas edge is a two-state gate; anything else is a typo, and silently
// treating a 2 as "on" would hide the day someone means to add a mode.
TP_I(sim, gasMode, TUNE_GAS_MODE, 1, kGasModeWall, kGasModeSink)
// The rest are const-eval'd into integers by the kernels that read them
// (sim_particle, sim_fluid, sim_step), so these bounds are the fixed-point
// bounds written in the human unit — the same discipline as the fluid rows
// above, and for the same reason: an out-of-range value wraps an i32
// mid-kernel rather than merely looking wrong.
TP_F(sim, windDrag, TUNE_WIND_DRAG, 3.0f, 0.0f, 30.0f)
TP_F(sim, windFluidGain, TUNE_WIND_FLUID_GAIN, 0.35f, 0.0f, 4.0f)
// The floor is not 0: a zero mass band would make the taper divide by
// nothing, and "no node ever feels wind" is what windFluidGain 0 is for.
TP_F(sim, windFluidMass, TUNE_WIND_FLUID_MASS, 0.5f, 0.02f, 4.0f)
// A drift reference speed of 0 would make every breath of air a full-bias
// gale, so the floor is a real wind rather than a nominal epsilon.
TP_F(sim, windDriftSpeed, TUNE_WIND_DRIFT_SPEED, 12.0f, 0.5f, 200.0f)
// Capped below 1: at 1.0 a moving voxel ALWAYS tries downwind first, which
// removes the RNG order entirely and turns a gas into a conveyor belt.
TP_F(sim, windDriftMax, TUNE_WIND_DRIFT_MAX, 0.5f, 0.0f, 0.95f)
TP_F(sim, windEntrainSpeed, TUNE_WIND_ENTRAIN_SPEED, 1.2f, 0.5f, 200.0f)
// Rate, not certainty (rule 2). 30/s is one hop per tick, which is the
// most the substep gate can deliver anyway.
TP_F(sim, windEntrainRate, TUNE_WIND_ENTRAIN_RATE, 6.0f, 0.0f, 30.0f)
// Saltation flux rises with a POWER of the excess over the threshold
// (~cube, docs/RESEARCH_wind.md 13.5): the hop chance is
// rate x min(excess / (threshold x span), 1)^power.
TP_F(sim, windEntrainPower, TUNE_WIND_ENTRAIN_POWER, 3.0f, 1.0f, 6.0f)
TP_F(sim, windEntrainSpan, TUNE_WIND_ENTRAIN_SPAN, 1.0f, 0.1f, 10.0f)
// ---- the CURRENT field's one sim coupling (PLAN_water_master.md comp 8)
// The only current knob the SHADER reads. Everything else about the field is
// resolved into primitives on the CPU, so this is the whole .def surface:
// a human-unit rate const-eval'd into Q16-per-substep, the fluid lane's trick.
TP_F(sim, currentDrag, TUNE_CURRENT_DRAG, 6.0f, 0.0f, 30.0f)

// ---- worldgen: NOT KNOBS ANY MORE (P-G, docs/PLAN_environment_truth.md) ----
// The terrain is the MAP's: assets/worldmap/<name>/map.json `terrain` (the
// datum, the landform range, the octave ladder, the attenuation, the calm
// home area, the sediment wedge, the treeline, the reference scale), packed
// into the worldMap buffer header (src/sim/worldmap.h kHTerrain*) and read by
// the height mirror on both sides. The per-biome relief curve and the hill /
// detail / grain multipliers are each biome file's `terrain` block. The
// noise-band biome thresholds, the biome blend and the cave threshold pair
// were dead since the painted map; the alpine cushion is a cover row. The
// map's name and the edit layer are the `world` group in tuning.json (read
// by LoadTuning, no shader constant). One knob survives, as a DEV switch:
// ---- debug ----
// THE VEGETATION KILL-SWITCH. 0 generates a world with no plants at all: no
// trees, cacti, flowers, tall grass, undergrowth, biome cover rows, shore
// plants, pond life, cave flora, alpine cushion or wet moss. Every placement
// block in worldgen.wgsl is gated on it at its SOURCE (treeInfoAt, cactusInfo,
// plantColumnAt, caveFloraAt and the table-driven blocks in genCellIn), so
// the far cascade, the undergrowth canopy scan and the tree candidate list
// all agree there is nothing there. A frame-rate A/B lever, not world
// content: the analytic plant tracer costs per plant cell it can see, and
// this is the one switch that removes every one of them. Terrain, water,
// caves and ruins are untouched. MOVES THE WORLD HASH at 0.
// + a hand-written rule in LoadTuning
TP_U(debug, vegetation, TUNE_VEGETATION, 1, TP_OPEN, TP_OPEN)

// THE GROUND-COVER SWITCH -- the SMALL half of the one above. 0 removes every
// plant a body walks through and nothing else: the biome cover rows (tall
// grass, wildflowers, undergrowth, scrub, the alpine cushion), the tile plants
// (ferns, big toadstools), the shore rows, the pond life (reeds, lilypads,
// kelp), the wet moss skin and the cave flora. TREES AND CACTI STAY -- they
// are the landmark half of the flora and removing them changes what the world
// IS, not how much small stuff is in front of the camera.
//
// Why two switches and not one: `vegetation` was the only lever, so the one
// click that cleared the grass also cleared the wood, and there was no way to
// look at bare terrain under a canopy. This is the lever you want almost
// always; `vegetation` above is the extreme end of the same axis and stays
// because the tree candidate scan and the crown proxy are their own cost.
//
// Gated at the SOURCE like the master (plantColumnAt, caveFloraAt and the
// table-driven blocks in genCellIn), so the undergrowth canopy scan is not
// paid for either. IMPLIED OFF when vegetation is 0 -- GROUND_COVER in
// worldgen.wgsl is the AND of the two, so the master stays the extreme end.
// MOVES THE WORLD HASH at 0.
// + a hand-written rule in LoadTuning
TP_U(debug, groundCover, TUNE_GROUND_COVER, 1, TP_OPEN, TP_OPEN)

// THE PERF EXPERIMENT SELECTOR. An integer a shader experiment may branch on
// (`if (TUNE_PERF_EXP == 2) { ... }`, const-folded), driven by the
// --render-budget arms exp1..exp3 so an experiment is measured against the
// frame it changes IN ONE PROCESS — boot-to-boot noise on the dev machine is
// +-0.8 ms, bigger than most levers. 0 is the shipped renderer; nothing may
// ship reading a non-zero value. Only the shaders that name it pay the prelude
// line (ReferencedTuningBlock), so adding one costs one shader's cache miss.
TP_I(debug, perfExp, TUNE_PERF_EXP, 0, 0, 15)

// ---- oil / petroleum-like viscous liquids (shadeViscous) ----
// Oil and blood share the viscous SURFACE path but look nothing alike, and the
// blood constants applied to oil rendered the pool as flat beige mud. These are
// the oil end of every term that differs; oiliness() derives the blend from the
// material's own authored palette saturation, so no material ids are involved
// and any petroleum-like liquid gets the look for free.
//
// Saturation band separating a biological fluid from a petroleum one. Blood's
// authored colour0 is 0.85 saturated, oil's is 0.46 - pigment suspensions are
// strongly chromatic, petroleum is a near-neutral brown-black.
// ---- oil / petroleum-like viscous liquids ----
// + a hand-written rule in LoadTuning
TP_F(render, oilSatLow, TUNE_OIL_SAT_LOW, 0.50f, TP_OPEN, TP_OPEN)
// + a hand-written rule in LoadTuning
TP_F(render, oilSatHigh, TUNE_OIL_SAT_HIGH, 0.78f, TP_OPEN, TP_OPEN)
// Head-on and grazing reflectance. Oil's IOR is ~1.47 against water's 1.33, so
// F0 is roughly double, and unlike blood it really does approach a mirror at
// the horizon - that hard bright rim is the look, not an artifact.
TP_F(render, oilF0, TUNE_OIL_F0, 0.043f, TP_OPEN, TP_OPEN)
TP_F(render, oilGraze, TUNE_OIL_GRAZE, 0.97f, TP_OPEN, TP_OPEN)
// Specular exponent. Much tighter than blood's: a smooth film gives a small
// hard glint where a rough suspension gives a broad soft one, and that
// narrowness is most of what reads as "glossy" rather than "damp".
// pow(x, e) with e <= 0 is 1 everywhere, which turns the specular lobe into
// a full-screen white wash.
TP_F(render, oilGloss, TUNE_OIL_GLOSS, 620.0f, 1.0f, TP_OPEN)
TP_F(render, oilSheen, TUNE_OIL_SHEEN, 1.6f, TP_OPEN, TP_OPEN)
// How much the reflection is tinted by the liquid's own colour. Near zero for
// oil: a petroleum film is a near-NEUTRAL dark mirror, so what you see in it is
// the sky and the far bank rather than a brown wash of its own body.
TP_F(render, oilReflectTint, TUNE_OIL_REFLECT_TINT, 0.12f, TP_OPEN, TP_OPEN)
// How far oil's body colour is pushed toward black. Petroleum absorbs nearly
// everything that enters it and reflects the rest off the surface, the opposite
// of blood's bright backscatter - this is the term that kills the beige.
TP_F(render, oilDarken, TUNE_OIL_DARKEN, 0.35f, TP_OPEN, TP_OPEN)
// Thin-film interference: the rainbow slick. Strength, and the spatial scale of
// the film-thickness field that sets the band spacing.
TP_F(render, oilIridescence, TUNE_OIL_IRIDESCENCE, 0.16f, TP_OPEN, TP_OPEN)
// Divides into the band phase; zero makes the whole surface one flat colour.
TP_F(render, oilFilmScale, TUNE_OIL_FILM_SCALE, 1.1f, 0.01f, TP_OPEN)
// How readily a density difference counts as "floating on". The iridescent
// sheen only appears where oil lies on a DENSER liquid (floatingOnLiquid);
// this scales how much denser the layer below has to be before it reads as a
// real boundary rather than a mixture. Oil 900 on water 1000 is a ratio of
// 0.111, so at 9.0 that saturates immediately.
TP_F(render, oilFloatSens, TUNE_OIL_FLOAT_SENS, 9.0f, 0.0f, TP_OPEN)
// Width of the silhouette-softening band for oil, against blood's 0.28. Blood
// can afford a wide feather because its body colour reads through the blend;
// oil's body is nearly black by design, so the same fade leaves a droplet with
// nothing to hold up against the background and it becomes a smear of the
// scene behind it. This is most of why oil looked see-through.
// A zero-width smoothstep band is a hard step, which puts the aliased cube
// silhouette straight back; too wide and the droplet goes translucent,
// which is the bug this parameter exists to fix.
TP_F(render, oilEdgeBand, TUNE_OIL_EDGE_BAND, 0.07f, 0.01f, 0.5f)
// How much plain sky reflection an UNPOOLED oil surface returns. A droplet is
// a tiny curved mirror scattering the sky in every direction, so far less
// reaches the eye than off a flat pool; at 1.0 a grazing droplet returns
// full-brightness sky and reads as a hole in the world.
TP_F(render, oilDropReflect, TUNE_OIL_DROP_REFLECT, 0.30f, 0.0f, 1.0f)

// Faint directional glow toward the surface when submerged in a medium too
// dense to see through. Without it a dense liquid is a featureless field of
// colour with no sense of up and nothing in motion - physically honest, but it
// reads as a broken shader rather than as being under the oil.
TP_F(render, subMurkGlow, TUNE_SUB_MURK_GLOW, 2.2f, 0.0f, TP_OPEN)

// ---- clouds + weather (cloud.wgsl, src/sim/weather.h, DESIGN.md 9.w) ----
// clouds (cloud.wgsl). Clamped to the tuner's ranges: a 0 scale divides
// by zero in the march and a 0 step count marches nothing forever.
TP_F(render, cloudShapeScaleM, TUNE_CLOUD_SHAPE_SCALE_M, 9000.0f, 1000.0f, 40000.0f)
TP_F(render, cloudDetailScaleM, TUNE_CLOUD_DETAIL_SCALE_M, 700.0f, 50.0f, 5000.0f)
TP_F(render, cloudWeatherScaleM, TUNE_CLOUD_WEATHER_SCALE_M, 16000.0f, 2000.0f, 100000.0f)
TP_F(render, cloudExtinction, TUNE_CLOUD_EXTINCTION, 0.045f, 0.001f, 0.5f)
TP_F(render, cloudErosion, TUNE_CLOUD_EROSION, 0.45f, 0.0f, 1.0f)
TP_U(render, cloudSteps, TUNE_CLOUD_STEPS, 64, 8, 256)
TP_U(render, cloudLightSteps, TUNE_CLOUD_LIGHT_STEPS, 5, 1, 12)
TP_F(render, cloudMaxDistM, TUNE_CLOUD_MAX_DIST_M, 45000.0f, 2000.0f, 200000.0f)
TP_F(render, cloudHazeM, TUNE_CLOUD_HAZE_M, 32000.0f, 1000.0f, 300000.0f)
TP_F(render, cloudPhaseG, TUNE_CLOUD_PHASE_G, 0.72f, 0.0f, 0.95f)
TP_F(render, cloudMultiScatter, TUNE_CLOUD_MULTI_SCATTER, 0.5f, 0.0f, 0.9f)
TP_F(render, cloudPowder, TUNE_CLOUD_POWDER, 0.7f, 0.0f, 1.0f)
TP_F(render, cloudAmbient, TUNE_CLOUD_AMBIENT, 2.2f, 0.0f, 10.0f)
TP_F(render, cloudSunGain, TUNE_CLOUD_SUN_GAIN, 1.0f, 0.0f, 5.0f)
TP_F(render, cloudShadowStrength, TUNE_CLOUD_SHADOW_STRENGTH, 0.9f, 0.0f, 1.0f)
TP_F(render, cloudRainDensity, TUNE_CLOUD_RAIN_DENSITY, 1.0f, 0.0f, 10.0f)
TP_F(render, cloudRainStreaks, TUNE_CLOUD_RAIN_STREAKS, 1.0f, 0.0f, 4.0f)
TP_F(render, cloudTemporal, TUNE_CLOUD_TEMPORAL, 0.12f, 0.02f, 1.0f)
TP_U(render, cloudResDiv, TUNE_CLOUD_RES_DIV, 3, 1, 8)
TP_F(render, cloudWindScale, TUNE_CLOUD_WIND_SCALE, 4.0f, 0.0f, 40.0f)
TP_F(render, cloudWetDarken, TUNE_CLOUD_WET_DARKEN, 0.42f, 0.0f, 0.9f)
TP_F(render, cloudRainbow, TUNE_CLOUD_RAINBOW, 1.0f, 0.0f, 4.0f)
TP_F(render, cloudCirrusScaleM, TUNE_CLOUD_CIRRUS_SCALE_M, 7000.0f, 500.0f, 50000.0f)
TP_F(render, cloudFogMix, TUNE_CLOUD_FOG_MIX, 1.0f, 0.0f, 1.0f)



// ==== player ====
TP_S(player, model, NO_WGSL, "human")
TP_F(player, flySpeed, NO_WGSL, 13.75f, 1.0f, 80.0f)
TP_F(player, flySprint, NO_WGSL, 32.5f, 1.0f, 200.0f)
TP_F(player, walkSpeed, NO_WGSL, 4.5f, 0.5f, 20.0f)
TP_F(player, sprintSpeed, NO_WGSL, 8.0f, 0.5f, 30.0f)
TP_F(player, gravity, NO_WGSL, 9.81f, 0.0f, 40.0f)
TP_F(player, jumpSpeed, NO_WGSL, 5.25f, 0.0f, 15.0f)
TP_F(player, swimUp, NO_WGSL, 17.5f, 0.0f, 60.0f)
TP_F(player, swimDown, NO_WGSL, 7.5f, 0.0f, 60.0f)
TP_F(player, maxFall, NO_WGSL, 30.0f, 1.0f, 120.0f)
TP_F(player, fallDamageSpeed, NO_WGSL, 8.0f, 0.0f, 60.0f)
TP_F(player, fallSplatSpeed, NO_WGSL, 25.0f, 1.0f, 120.0f)
TP_F(player, fallDamageScale, NO_WGSL, 0.75f, 0.0f, 10.0f)
// What a landing does to a body (Mob::ApplyFallDamage, W2-H). Floors from the
// loader's old max(0) clamps; ceilings are the tuner slider's.
TP_F(player, fallSplatCarveBase, NO_WGSL, 4.0f, 0.0f, 20.0f)
TP_F(player, fallSplatCarvePerMs, NO_WGSL, 0.1f, 0.0f, 1.0f)
TP_I(player, fallSplatDroplets, NO_WGSL, 400, 0, 4096)
TP_I(player, fallSplatBloodVoxels, NO_WGSL, 30, 0, 512)
TP_F(player, fallSplatImpulseRadius, NO_WGSL, 8.0f, 0.0f, 40.0f)
TP_F(player, fallSplatImpulsePerMs, NO_WGSL, 2.0f, 0.0f, 20.0f)
TP_F(player, fallLegBleed, NO_WGSL, 0.3f, 0.0f, 4.0f)
TP_F(player, stepUp, NO_WGSL, 0.58f, 0.0f, 2.0f)
TP_F(player, smoothBump, NO_WGSL, 0.12f, 0.0f, 1.0f)
TP_F(player, stepSpeedPenaltyPerM, NO_WGSL, 2.8f, 0.0f, 10.0f)
TP_F(player, minStepSpeedScale, NO_WGSL, 0.20f, 0.01f, 1.0f)
