// ==== sim: rows no shader reads ====
// + a hand-written rule in LoadTuning
TP_F(sim, windGasScale, NO_WGSL, 1.0f, 0.0f, 16.0f)
// + a hand-written rule in LoadTuning
TP_F(sim, windPartScale, NO_WGSL, 1.0f, 0.0f, 16.0f)
// The drag ramp reference. Floored well above zero because the kernel
// divides by it: windDragRampQ's `max(refQ >> 16, 1)` keeps the shader
// safe whatever arrives, but a reference of 0.1 m/s would saturate the
// ramp in dead calm and quietly restore the fixed-rate behaviour this
// replaces — which is a bug report about gravity, not about wind.
TP_F(sim, windDragRef, NO_WGSL, 40.0f, 1.0f, 200.0f)
// The wake budget cannot exceed the TickParams array it is copied into;
// 0 is a legal "no primitive may wake anything", which is the switch that
// turns entrainment off without turning the fans off.
TP_I(sim, windWakeChunks, NO_WGSL, 96, 0, kWindWakeCap)
// The current field (plan component 8). CPU-side by design —
// the shader reads resolved primitives, never a knob.
// ---- the current field (plan component 8) ----
// The bounds are the shader's overflow audit expressed in human units:
// kCurrentPrimMaxSpeed is 200 cells/s = 20 m/s, and kCurrentPrimMaxExtent
// is what every intermediate in currentPrimEvalQ is bounded against.
TP_I(sim, currentMode, NO_WGSL, 0, 0, 1)
TP_F(sim, currentVortexGamma, NO_WGSL, 22.0f, 0.0f, 400.0f)
// A decay of zero is the bug plan component 8 names outright — a funnel
// standing open in still water — so the floor is a real number, not 0.
TP_F(sim, currentVortexDecay, NO_WGSL, 3.0f, 0.05f, 120.0f)
TP_I(sim, currentVortexRadius, NO_WGSL, 40, 4, kCurrentPrimMaxExtent)
TP_F(sim, currentSinkSpeed, NO_WGSL, 3.0f, 0.0f, 20.0f)
TP_F(sim, currentStreamScale, NO_WGSL, 1.2f, 0.0f, 20.0f)
TP_I(sim, currentStreamMinSlope, NO_WGSL, 24, 0, 4096)


// ==== dayNight ====
// A zero-length day divides by zero in DayPhaseForTick and would freeze
// the cycle at midnight; a negative one is meaningless.
TP_I(dayNight, cycleMinutes, NO_WGSL, 20, 1, 240)
TP_I(dayNight, freeze, NO_WGSL, 0, 0, 1)
// + a hand-written rule in LoadTuning
TP_I(dayNight, freezePhase, NO_WGSL, 32768, 0, 65535)
TP_F(dayNight, sunAzimuth, NO_WGSL, 24.0f, -180.0f, 180.0f)
// + a hand-written rule in LoadTuning
TP_F(dayNight, twilightWidth, NO_WGSL, 0.22f, 0.02f, 1.0f)
TP_F(dayNight, starRotSpeed, NO_WGSL, 1.0f, 0.0f, 8.0f)
// ---- orbital elements (sim/celestial.cpp) ----
TP_F(dayNight, axialTilt, NO_WGSL, 23.4f, 0.0f, 80.0f)
// + a hand-written rule in LoadTuning
TP_F(dayNight, latitudeDeg, NO_WGSL, 42.0f, -89.0f, 89.0f)
TP_F(dayNight, yearLengthDays, NO_WGSL, 96.0f, 0.5f, 2000.0f)
// ---- orbital sanity ----
// Kepler's equation is only solved for bound elliptical orbits, and the
// fixed-iteration Newton solver (celestial.cpp) is accurate well past 0.6
// but not near 1. A parabolic or hyperbolic element set here is a JSON
// typo, not a design choice, so clamp loudly rather than emit a sky that
// flies off.
TP_F(dayNight, orbitEccentricity, NO_WGSL, 0.017f, 0.0f, 0.7f)
TP_F(dayNight, orbitArgPeriapsis, NO_WGSL, 283.0f, 0.0f, 360.0f)
TP_F(dayNight, orbitMeanAnomaly0, NO_WGSL, 0.0f, 0.0f, 360.0f)
// The apparent radii feed the eclipse geometry directly. Zero would make
// eclipses impossible and a huge value would make one permanent, so bound
// both to something a sky can hold.
TP_F(dayNight, sunAngularRadius, NO_WGSL, 0.30f, 0.02f, 12.0f)
TP_I(dayNight, lunarPeriodDays, NO_WGSL, 8, 1, 120)
TP_F(dayNight, moonInclination, NO_WGSL, 5.1f, 0.0f, 45.0f)
TP_F(dayNight, moonEccentricity, NO_WGSL, 0.055f, 0.0f, 0.7f)
TP_F(dayNight, moonArgPeriapsis, NO_WGSL, 130.0f, 0.0f, 360.0f)
TP_F(dayNight, moonNode, NO_WGSL, 0.0f, 0.0f, 360.0f)
TP_F(dayNight, moonMeanAnomaly0, NO_WGSL, 40.0f, 0.0f, 360.0f)
TP_F(dayNight, moonAngularRadius, NO_WGSL, 1.7f, 0.05f, 20.0f)
TP_I(dayNight, moon2PeriodDays, NO_WGSL, 9, 1, 120)
TP_F(dayNight, moon2Inclination, NO_WGSL, 8.7f, 0.0f, 45.0f)
TP_F(dayNight, moon2Eccentricity, NO_WGSL, 0.03f, 0.0f, 0.7f)
TP_F(dayNight, moon2ArgPeriapsis, NO_WGSL, 20.0f, 0.0f, 360.0f)
TP_F(dayNight, moon2Node, NO_WGSL, 95.0f, 0.0f, 360.0f)
TP_F(dayNight, moon2MeanAnomaly0, NO_WGSL, 200.0f, 0.0f, 360.0f)
TP_F(dayNight, moon2AngularRadius, NO_WGSL, 1.05f, 0.05f, 20.0f)


// ==== weather ====
TP_B(weather, waterFreezes, NO_WGSL, true)
TP_B(weather, iceMelts, NO_WGSL, true)
// The sky half (weather.h). Clamped here, not trusted: a negative epoch or
// a transition of 0 would divide by zero in weather::Resolve.
TP_B(weather, clouds, NO_WGSL, true)
TP_B(weather, autoCycle, NO_WGSL, true)
TP_S(weather, preset, NO_WGSL, "fair")
TP_F(weather, epochMinutes, NO_WGSL, 7.0f, 0.5f, 600.0f)
TP_F(weather, cycleSpeed, NO_WGSL, 1.0f, 0.0f, 1000.0f)
