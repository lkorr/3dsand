// The ONE table of shader-facing tuning parameters.
//
// Every row here used to be written out by hand in THREE places that had to
// agree and that nothing checked: the Emit* call in TuningWgslBlock()
// (sim/tuning.cpp), the SPEC row in scripts/tuning_prelude.py, and the default
// in both of those. A row present in one and missing from the other meant
// shaders that validate offline and then fail to build for real, or — worse —
// a shader silently compiled against a default the engine never uses.
//
// Include this with TP_F / TP_I / TP_U / TP_V3 defined to whatever you need,
// then #undef them. scripts/tuning_prelude.py is GENERATED from this file by
// scripts/gen_tuning_prelude.py, so the Python side cannot drift at all.
//
// Columns: (group, member, WGSL name, default...)
//   group  the Tuning sub-struct AND the tuning.json object name — they are
//          always the same string; LoadTuning relies on it.
//   member the C++ member inside that sub-struct, which is ALSO the JSON key.
//   TUNE_* the WGSL constant name. Conventionally TUNE_ + SNAKE(member), but
//          four rows predate that rule and keep their authored names.
//
// The DECLARATIONS and the doc comments live in sim/tuning.h, and the reads
// (with their per-parameter clamping and warnings) live in LoadTuning. This
// table deliberately does not try to absorb either: the comments in tuning.h
// are the reason that file is readable, and the clamps are real logic, not
// boilerplate.
//
// A default changed here changes it for the engine AND for offline shader
// validation at once. Values in the `sim` and `worldgen` groups feed the CA:
// changing one changes the world hash, so re-run --selftest (CLAUDE.md rule 1).

// clang-format off


// ---- sky / sun ----
TP_F(render, skyGradient, TUNE_SKY_GRADIENT, 1.4f)
TP_F(render, skyHorizonOffset, TUNE_SKY_HORIZON_OFFSET, 0.25f)
TP_V3(render, skyHorizon, TUNE_SKY_HORIZON, 0.72f, 0.8f, 0.9f)
TP_V3(render, skyZenith, TUNE_SKY_ZENITH, 0.25f, 0.47f, 0.85f)
TP_V3(render, sunTint, TUNE_SUN_TINT, 1.0f, 0.9f, 0.7f)
TP_F(render, sunDiscPower, TUNE_SUN_DISC_POWER, 800.0f)
TP_F(render, sunDiscGain, TUNE_SUN_DISC_GAIN, 3.0f)
TP_F(render, sunHaloPower, TUNE_SUN_HALO_POWER, 8.0f)
TP_F(render, sunHaloGain, TUNE_SUN_HALO_GAIN, 0.12f)
TP_V3(render, sunColor, TUNE_SUN_COLOR, 1.0f, 0.95f, 0.86f)
TP_F(render, sunIntensity, TUNE_SUN_INTENSITY, 1.35f)

// ---- atmospheric sky ----
TP_F(render, skyRayleigh, TUNE_SKY_RAYLEIGH, 12.0f)
TP_F(render, skyMie, TUNE_SKY_MIE, 1.0f)
TP_F(render, skyMieG, TUNE_SKY_MIE_G, 0.76f)
TP_F(render, skyMieStrength, TUNE_SKY_MIE_STRENGTH, 1.0f)
TP_F(render, skyExposure, TUNE_SKY_EXPOSURE, 1.6f)
TP_V3(render, skyGround, TUNE_SKY_GROUND, 0.22f, 0.2f, 0.17f)
TP_F(render, sunSize, TUNE_SUN_SIZE, 3.0f)
TP_F(render, sunReddening, TUNE_SUN_REDDENING, 1.0f)

// ---- night sky ----
TP_V3(render, nightZenith, TUNE_NIGHT_ZENITH, 0.006f, 0.01f, 0.028f)
TP_V3(render, nightHorizon, TUNE_NIGHT_HORIZON, 0.03f, 0.036f, 0.062f)
TP_V3(render, fluidColor, TUNE_FLUID_COLOR, 0.20f, 0.42f, 0.85f)
TP_V3(render, fluidColor1, TUNE_FLUID_COLOR1, 0.92f, 0.34f, 0.10f)
TP_V3(render, fluidColor2, TUNE_FLUID_COLOR2, 0.22f, 0.78f, 0.28f)
TP_V3(render, fluidColor3, TUNE_FLUID_COLOR3, 0.88f, 0.72f, 0.25f)
TP_F(render, fluidParticleSize, TUNE_FLUID_PARTICLE_SIZE, 0.58f)
TP_F(render, fluidStretch, TUNE_FLUID_STRETCH, 0.4f)
TP_F(render, fluidDensityShade, TUNE_FLUID_DENSITY_SHADE, 0.45f)
TP_F(render, fluidFoam, TUNE_FLUID_FOAM, 0.55f)
// MPM fluid SURFACE rendering (raymarch.wgsl MPM FLUID SURFACE block):
// surface 1/0 toggle, iso x rest density, smooth in voxels, clarity metres,
// foamSpeed vox/s.
TP_F(render, fluidSurface, TUNE_FLUID_SURFACE, 1.0f)
TP_F(render, fluidIso, TUNE_FLUID_ISO, 0.30f)
TP_F(render, fluidSmooth, TUNE_FLUID_SMOOTH, 1.3f)
TP_F(render, fluidIor, TUNE_FLUID_IOR, 1.33f)
TP_F(render, fluidClarity, TUNE_FLUID_CLARITY, 1.3f)
TP_F(render, fluidReflect, TUNE_FLUID_REFLECT, 1.0f)
TP_F(render, fluidSpecular, TUNE_FLUID_SPECULAR, 1.0f)
TP_F(render, fluidFoamSpeed, TUNE_FLUID_FOAM_SPEED, 22.0f)
TP_F(render, fluidWobble, TUNE_FLUID_WOBBLE, 0.5f)
// Depth colour gradient (raymarch.wgsl, DEPTH GRADIENT block). The shallow
// tint is what a thin film reads as, the deep tint what the body tends toward;
// depth is the metres of path over which the ramp completes.
TP_V3(render, fluidShallow, TUNE_FLUID_SHALLOW, 0.42f, 0.86f, 0.82f)
TP_V3(render, fluidDeep, TUNE_FLUID_DEEP, 0.02f, 0.15f, 0.42f)
TP_F(render, fluidDepth, TUNE_FLUID_DEPTH, 2.6f)
TP_F(render, fluidGradient, TUNE_FLUID_GRADIENT, 1.0f)
// Grid foam field (sim_fluid.wgsl foam potentials, raymarch surface whitening).
TP_F(render, fluidFoamField, TUNE_FLUID_FOAM_FIELD, 1.0f)
TP_F(render, fluidFoamTexture, TUNE_FLUID_FOAM_TEXTURE, 0.65f)
// Foam PARTICLE colour (debris.wgsl vsParticle, PPAY_FOAM). Foam is
// entrained air, so it has no material - it is coloured from here.
TP_V3(render, foamColor, TUNE_FOAM_COLOR, 0.97f, 0.98f, 1.0f)
TP_F(render, foamColorVar, TUNE_FOAM_COLOR_VAR, 0.18f)
TP_F(render, starBrightness, TUNE_STAR_BRIGHTNESS, 1.0f)
TP_F(render, starDensity, TUNE_STAR_DENSITY, 150.0f)
TP_F(render, starSize, TUNE_STAR_SIZE, 0.85f)
TP_F(render, starSparsity, TUNE_STAR_SPARSITY, 0.012f)
TP_F(render, starTwinkle, TUNE_STAR_TWINKLE, 0.35f)
TP_F(render, milkyWayStrength, TUNE_MILKYWAY_STRENGTH, 0.55f)
TP_V3(render, milkyWayColor, TUNE_MILKYWAY_COLOR, 0.52f, 0.56f, 0.78f)
TP_F(render, nebulaStrength, TUNE_NEBULA_STRENGTH, 0.4f)
TP_V3(render, nebulaCool, TUNE_NEBULA_COOL, 0.16f, 0.3f, 0.62f)
TP_V3(render, nebulaWarm, TUNE_NEBULA_WARM, 0.55f, 0.2f, 0.38f)
TP_F(render, auroraStrength, TUNE_AURORA_STRENGTH, 0.55f)
TP_F(render, auroraHeight, TUNE_AURORA_HEIGHT, 900.0f)
TP_V3(render, auroraLow, TUNE_AURORA_LOW, 0.1f, 0.85f, 0.45f)
TP_V3(render, auroraHigh, TUNE_AURORA_HIGH, 0.65f, 0.2f, 0.85f)

// ---- moon ----
TP_F(render, moonRadius, TUNE_MOON_RADIUS, 0.03f)
TP_F(render, moonBrightness, TUNE_MOON_BRIGHTNESS, 1.6f)
TP_V3(render, moonColor, TUNE_MOON_COLOR, 0.92f, 0.93f, 0.88f)
TP_F(render, moonGlow, TUNE_MOON_GLOW, 0.35f)
TP_F(render, moonEarthshine, TUNE_MOON_EARTHSHINE, 0.055f)
TP_V3(render, moonLightColor, TUNE_MOON_LIGHT_COLOR, 0.55f, 0.68f, 1.0f)
TP_F(render, moonLightIntensity, TUNE_MOON_LIGHT_INTENSITY, 0.16f)

// ---- night ambient ----
TP_V3(render, nightAmbSky, TUNE_NIGHT_AMB_SKY, 0.055f, 0.075f, 0.135f)
TP_V3(render, nightAmbGround, TUNE_NIGHT_AMB_GROUND, 0.022f, 0.026f, 0.042f)

// ---- ambient / diffuse ----
TP_V3(render, ambSky, TUNE_AMB_SKY, 0.4f, 0.48f, 0.62f)
TP_V3(render, ambGround, TUNE_AMB_GROUND, 0.25f, 0.22f, 0.17f)
TP_F(render, diffuseWrap, TUNE_DIFFUSE_WRAP, 0.55f)
TP_F(render, faceX, TUNE_FACE_X, 0.96f)
TP_F(render, faceZ, TUNE_FACE_Z, 0.92f)

// ---- AO / shadows ----
TP_F(render, aoStrength, TUNE_AO_STRENGTH, 0.45f)
TP_F(render, aoFar, TUNE_AO_FAR, 0.72f)
TP_F(render, shadowBias, TUNE_SHADOW_BIAS, 0.02f)
TP_I(render, shadowSteps, TUNE_SHADOW_STEPS, 384)
TP_F(render, shadowSoftNear, TUNE_SHADOW_SOFT_NEAR, 0.6f)
TP_F(render, shadowSoftFar, TUNE_SHADOW_SOFT_FAR, 9.0f)
TP_F(render, shadowLift, TUNE_SHADOW_LIFT, 0.45f)
TP_F(render, shadowFarLift, TUNE_SHADOW_FAR_LIFT, 0.3f)

// ---- grain ----
TP_F(render, grainBroadScale, TUNE_GRAIN_BROAD_SCALE, 11.0f)
TP_F(render, grainFineScale, TUNE_GRAIN_FINE_SCALE, 2.5f)
TP_F(render, grainMix, TUNE_GRAIN_MIX, 0.68f)
TP_F(render, grainAmp, TUNE_GRAIN_AMP, 0.065f)
TP_F(render, grainAmpFar, TUNE_GRAIN_AMP_FAR, 0.05f)

// ---- media / fire ----
TP_F(render, mediaAbsorb, TUNE_MEDIA_ABSORB, 6.4f)
TP_F(render, mediaTauMax, TUNE_MEDIA_TAU_MAX, 6.0f)
TP_F(render, fireFlickerBase, TUNE_FIRE_FLICKER_BASE, 0.7f)
TP_F(render, fireFlickerAmp, TUNE_FIRE_FLICKER_AMP, 0.55f)
TP_F(render, fireFlickerRate, TUNE_FIRE_FLICKER_RATE, 13.0f)
TP_F(render, fireGlowRate, TUNE_FIRE_GLOW_RATE, 1.4f)
TP_F(render, fireIntensity, TUNE_FIRE_INTENSITY, 2.1f)
TP_F(render, fireBreatheAmp, TUNE_FIRE_BREATHE_AMP, 0.08f)
TP_F(render, fireBreatheRate, TUNE_FIRE_BREATHE_RATE, 5.3f)
TP_F(render, emissiveStrength, TUNE_EMISSIVE_STRENGTH, 1.7f)
TP_F(render, emissiveFlickerBase, TUNE_EMISSIVE_FLICKER_BASE, 0.82f)
TP_F(render, emissiveFlickerAmp, TUNE_EMISSIVE_FLICKER_AMP, 0.28f)
TP_F(render, emissiveFlickerRate, TUNE_EMISSIVE_FLICKER_RATE, 9.0f)

// ---- water ----
TP_F(render, waterF0, TUNE_WATER_F0, 0.0204f)
TP_V3(render, waterAbsorb, TUNE_WATER_ABSORB, 1.85f, 0.42f, 0.2f)
TP_V3(render, waterScatter, TUNE_WATER_SCATTER, 0.045f, 0.16f, 0.2f)
TP_F(render, waterFresnelPower, TUNE_WATER_FRESNEL_POWER, 5.0f)
TP_F(render, rippleAmpScale, TUNE_RIPPLE_AMP_SCALE, 0.35f)
TP_F(render, rippleSpeedScale, TUNE_RIPPLE_SPEED_SCALE, 0.4f)
TP_F(render, waterFetchLow, TUNE_WATER_FETCH_LOW, 0.35f)
TP_F(render, waterFetchHigh, TUNE_WATER_FETCH_HIGH, 0.85f)
TP_F(render, reflectionCutoff, TUNE_REFLECTION_CUTOFF, 0.06f)
TP_I(render, reflectionSteps, TUNE_REFLECTION_STEPS, 96)
TP_F(render, causticGain, TUNE_CAUSTIC_GAIN, 1.5f)
TP_F(render, causticCap, TUNE_CAUSTIC_CAP, 0.85f)
TP_F(render, glintIntensity, TUNE_GLINT_INTENSITY, 0.85f)
TP_F(render, glintPowerNear, TUNE_GLINT_POWER_NEAR, 180.0f)
TP_F(render, glintPowerFar, TUNE_GLINT_POWER_FAR, 900.0f)
TP_F(render, foamDepth, TUNE_FOAM_DEPTH, 0.42f)
TP_F(render, foamStrength, TUNE_FOAM_STRENGTH, 0.55f)
TP_F(render, iceF0, TUNE_ICE_F0, 0.021f)
TP_F(render, iceFresnelPower, TUNE_ICE_FRESNEL_POWER, 5.0f)
TP_F(render, iceAbsorb, TUNE_ICE_ABSORB, 3.2f)
TP_F(render, iceAbsorbFloor, TUNE_ICE_ABSORB_FLOOR, 0.06f)
TP_F(render, iceScatter, TUNE_ICE_SCATTER, 0.3f)
TP_F(render, iceScatterDepth, TUNE_ICE_SCATTER_DEPTH, 1.6f)
TP_F(render, iceScatterNight, TUNE_ICE_SCATTER_NIGHT, 0.25f)
TP_F(render, iceGrain, TUNE_ICE_GRAIN, 0.09f)
TP_F(render, iceGrainScale, TUNE_ICE_GRAIN_SCALE, 0.35f)
TP_F(render, iceGloss, TUNE_ICE_GLOSS, 190.0f)
TP_F(render, iceSpec, TUNE_ICE_SPEC, 0.55f)
TP_F(render, iceDepthMax, TUNE_ICE_DEPTH_MAX, 3.0f)
TP_F(render, iceReflectMin, TUNE_ICE_REFLECT_MIN, 0.12f)

// ---- submerged view (raymarch.wgsl shadeSubmerged / godRays / bedCaustic) ----
// These only ever apply when the ray is INSIDE a liquid, which above water is
// never — every term below is gated on that, so a dry frame pays nothing.
// Underwater absorption is deliberately its OWN set rather than reusing
// waterAbsorb: looking THROUGH a lake from outside wants a strong red kill
// (that is the depth cue), but living inside it at that strength leaves you in
// a flat blue void with no visible distance at all. Underwater wants a longer
// visibility range and a stronger scatter floor.
TP_V3(render, subAbsorb, TUNE_SUB_ABSORB, 0.42f, 0.11f, 0.075f)
TP_V3(render, subScatter, TUNE_SUB_SCATTER, 0.055f, 0.19f, 0.24f)
// In-scatter strength and how fast the volume tint saturates with distance.
TP_F(render, subScatterGain, TUNE_SUB_SCATTER_GAIN, 1.0f)
// Distance (metres) at which the far view has fully faded to the scatter
// colour. This is the underwater equivalent of fog distance and it is the
// single knob that says "murky pond" vs "clear tropical water".
TP_F(render, subVisibility, TUNE_SUB_VISIBILITY, 11.0f)
// Screen-edge darkening while submerged — a cheap, strong "you are in a
// medium" cue that costs one dot product.
TP_F(render, subVignette, TUNE_SUB_VIGNETTE, 0.34f)
// Snell's-window brightening: looking UP from under water compresses the whole
// sky into a ~97 degree cone. Outside it the surface mirrors the murk.
TP_F(render, subSnellGain, TUNE_SUB_SNELL_GAIN, 1.25f)

// ---- caustics cast onto submerged surfaces ----
// The existing causticGain/Cap drive the caustic seen looking DOWN through a
// surface from outside. These drive the caustic painted on a lit voxel face
// while the camera is under the water, which is a different projection (from
// the surface above the SURFACE point, not the bed point) and wants its own
// strength or one of the two views always looks wrong.
TP_F(render, bedCausticGain, TUNE_BED_CAUSTIC_GAIN, 2.4f)
TP_F(render, bedCausticCap, TUNE_BED_CAUSTIC_CAP, 1.5f)
// Metres of water above a surface past which its caustics have washed out.
TP_F(render, bedCausticFade, TUNE_BED_CAUSTIC_FADE, 6.0f)
// Sharpness of the caustic web. Higher = thinner, brighter filaments.
TP_F(render, bedCausticSharp, TUNE_BED_CAUSTIC_SHARP, 2.2f)

// ---- volumetric light shafts (god rays) ----
// Ray-marched with a real occlusion test per sample, so shafts break correctly
// around the shore and any overhang. Sample count is a direct frame-time
// multiplier on submerged pixels ONLY.
TP_I(render, godRaySteps, TUNE_GODRAY_STEPS, 14)
TP_F(render, godRayStrength, TUNE_GODRAY_STRENGTH, 0.55f)
// Henyey-Greenstein forward-scattering asymmetry: shafts are much brighter
// looking toward the sun than away from it, which is what makes them read as
// beams rather than as uniform haze.
TP_F(render, godRayAniso, TUNE_GODRAY_ANISO, 0.62f)
// Metres the shaft march covers. Beyond this the scatter has saturated anyway.
TP_F(render, godRayRange, TUNE_GODRAY_RANGE, 14.0f)
// Steps the per-sample occlusion ray gets. Short on purpose: it only has to
// find the surface or a nearby blocker, not resolve distant geometry.
TP_I(render, godRayShadowSteps, TUNE_GODRAY_SHADOW_STEPS, 20)

// ---- drifting particulate (silt) ----
// Render-only motes in the water volume. This is what gives the shafts
// something to catch, and it is most of why footage reads as underwater.
TP_F(render, siltDensity, TUNE_SILT_DENSITY, 0.55f)
TP_F(render, siltBrightness, TUNE_SILT_BRIGHTNESS, 0.5f)
TP_F(render, siltDrift, TUNE_SILT_DRIFT, 0.05f)

// ---- surface-from-below ----
// How much the underside of the water surface ripples the view of the sky.
TP_F(render, subSurfaceRipple, TUNE_SUB_SURFACE_RIPPLE, 1.6f)

// ---- the generic per-liquid submerged profile (submergedProfile) ----
// These shape the MAPPING from a liquid's authored opacity + palette to its
// submerged look, so every liquid — including ones added later — gets a
// complete treatment with no shader change. The subAbsorb/subScatter/
// subVisibility values above remain WATER'S refinement, blended in at the
// clear end of the curve rather than selected by a material test.
//
// Visibility in a fully opaque liquid. Being inside oil should be
// claustrophobic — this is the "arm's length" end of the range.
TP_F(render, subMurkVis, TUNE_SUB_MURK_VIS, 0.55f)
// Exponent applied to clarity for the VISIBILITY mapping only. Separate from
// the clarity curve itself because one shared exponent cannot both collapse
// oil to arm's length and keep water classified as clear (see submergedProfile).
TP_F(render, subVisCurve, TUNE_SUB_VIS_CURVE, 2.2f)
// Opacity -> per-metre absorption gain for the derived (non-clear) case.
TP_F(render, subAbsorbGain, TUNE_SUB_ABSORB_GAIN, 7.0f)
// Absorption floor, so even a notionally clear liquid is not a vacuum.
TP_F(render, subAbsorbFloor, TUNE_SUB_ABSORB_FLOOR, 0.05f)
// How much of its own colour a liquid scatters back at the eye, at the dense
// and clear ends of the clarity curve. A dense liquid IS what you see.
TP_F(render, subScatterDense, TUNE_SUB_SCATTER_DENSE, 0.42f)
TP_F(render, subScatterClear, TUNE_SUB_SCATTER_CLEAR, 0.16f)
// Clarity band over which a liquid crosses from the derived profile onto
// water's hand-tuned coefficients. Water sits at clarity ~0.79, oil ~0.16.
// Widening this band makes more liquids inherit water's look.
TP_F(render, subClearLow, TUNE_SUB_CLEAR_LOW, 0.62f)
TP_F(render, subClearHigh, TUNE_SUB_CLEAR_HIGH, 0.82f)

// ---- blood / viscous liquids ----
TP_F(render, bloodF0, TUNE_BLOOD_F0, 0.03f)
TP_F(render, bloodGraze, TUNE_BLOOD_GRAZE, 0.55f)
TP_F(render, bloodAbsorb, TUNE_BLOOD_ABSORB, 55.0f)
TP_F(render, bloodTransmit, TUNE_BLOOD_TRANSMIT, 0.35f)
TP_F(render, bloodMaxTransmit, TUNE_BLOOD_MAX_TRANSMIT, 0.06f)
TP_F(render, bloodDepthRamp, TUNE_BLOOD_DEPTH_RAMP, 22.0f)
TP_F(render, bloodPoolLow, TUNE_BLOOD_POOL_LOW, 0.18f)
TP_F(render, bloodPoolHigh, TUNE_BLOOD_POOL_HIGH, 0.55f)
TP_F(render, bloodSmooth, TUNE_BLOOD_SMOOTH, 1.0f)
TP_F(render, bloodEdgeFeather, TUNE_BLOOD_EDGE_FEATHER, 0.1f)
TP_F(render, bloodWobble, TUNE_BLOOD_WOBBLE, 0.004f)
TP_F(render, bloodSheen, TUNE_BLOOD_SHEEN, 1.15f)
TP_F(render, bloodSheenDrop, TUNE_BLOOD_SHEEN_DROP, 32.0f)
TP_F(render, bloodSheenPool, TUNE_BLOOD_SHEEN_POOL, 220.0f)
TP_F(render, bloodAmbientSheen, TUNE_BLOOD_AMBIENT_SHEEN, 0.35f)
TP_F(render, bloodEdgeDepth, TUNE_BLOOD_EDGE_DEPTH, 0.035f)
TP_F(render, bloodEdgeStrength, TUNE_BLOOD_EDGE_STRENGTH, 0.65f)
TP_V3(render, bloodEdgeTint, TUNE_BLOOD_EDGE_TINT, 0.55f, 0.4f, 0.38f)

// ---- stains ----
TP_F(render, stainCoverage, TUNE_STAIN_COVERAGE, 1.35f)
TP_F(render, stainMottle, TUNE_STAIN_MOTTLE, 0.85f)
TP_F(render, stainMottleScale, TUNE_STAIN_MOTTLE_SCALE, 0.55f)
TP_F(render, stainDarken, TUNE_STAIN_DARKEN, 0.55f)
TP_F(render, stainOpacity, TUNE_STAIN_OPACITY, 0.7f)
TP_F(render, stainSheen, TUNE_STAIN_SHEEN, 0.55f)
TP_F(render, stainSheenPower, TUNE_STAIN_SHEEN_POWER, 90.0f)

// ---- lava / embers ----
TP_F(render, lavaCrackFreq, TUNE_LAVA_CRACK_FREQ, 2.4f)
TP_F(render, lavaCrackKneeLow, TUNE_LAVA_CRACK_KNEE_LOW, 0.5f)
TP_F(render, lavaCrackKneeHigh, TUNE_LAVA_CRACK_KNEE_HIGH, 0.9f)
TP_F(render, lavaWarmBias, TUNE_LAVA_WARM_BIAS, 0.035f)
TP_F(render, lavaEmissionGain, TUNE_LAVA_EMISSION_GAIN, 1.9f)
TP_F(render, lavaPulseAmp, TUNE_LAVA_PULSE_AMP, 0.06f)
TP_F(render, lavaPulseRate, TUNE_LAVA_PULSE_RATE, 0.9f)
TP_F(render, heatSpillStrength, TUNE_HEAT_SPILL_STRENGTH, 0.16f)
TP_F(render, emberBrightness, TUNE_EMBER_BRIGHTNESS, 2.2f)
TP_F(render, emberRise, TUNE_EMBER_RISE, 26.0f)
TP_F(render, emberRate, TUNE_EMBER_RATE, 3.4f)
TP_U(render, emberDensity, TUNE_EMBER_DENSITY, 84)

// ---- tonemap / budgets ----
TP_F(render, exposureWhite, TUNE_EXPOSURE_WHITE, 4.2f)
TP_F(render, bleachAmount, TUNE_BLEACH_AMOUNT, 0.9f)
TP_F(render, gamma, TUNE_GAMMA, 2.2f)

// ---- static micro-detail ----
TP_F(render, microLodDist, TUNE_MICRO_LOD_DIST, 40.0f)
TP_I(render, microMaxPerRay, TUNE_MICRO_MAX_PER_RAY, 8)
TP_F(render, microSwayAmp, TUNE_MICRO_SWAY_AMP, 1.5f)
TP_F(render, microSwaySpeed, TUNE_MICRO_SWAY_SPEED, 1.1f)
TP_I(render, primarySteps, TUNE_PRIMARY_STEPS, 4096)
TP_I(render, farSteps, TUNE_FAR_STEPS, 384)
TP_F(render, farShadowReach, TUNE_FAR_SHADOW_REACH, 60.0f)

// ---- in-window LOD handoff (PLAN_surface_flight_perf.md A1) ----
TP_F(render, lodHandoffDist, TUNE_LOD_HANDOFF_DIST, 24.0f)
TP_F(render, shadowMaxDist, TUNE_SHADOW_MAX_DIST, 999.0f)

// ---- sim: DETERMINISM-CRITICAL, integer only (CLAUDE.md rule 1) ----
TP_I(sim, partGravity, TUNE_PART_GRAVITY, 22)
TP_I(sim, partMaxVel, TUNE_PART_MAX_VEL, 1536)
TP_I(sim, airDensity, TUNE_AIR_DENSITY, 10)
TP_I(sim, falloffPerCell, TUNE_FALLOFF_PER_CELL, 6)
TP_U(sim, ejectSolid, TUNE_EJECT_SOLID, 250)
TP_U(sim, ejectLiquid, TUNE_EJECT_LIQUID, 500)
TP_U(sim, ejectPowder, TUNE_EJECT_POWDER, 350)
TP_U(sim, ejectGas, TUNE_EJECT_GAS, 0)
TP_U(sim, liquidEqualize, TUNE_LIQUID_EQUALIZE, 2)
TP_U(sim, wanderHopMask, TUNE_WANDER_HOP_MASK, 7)
TP_U(sim, expMicroPerMille, TUNE_EXP_MICRO_PERMILLE, 900)
TP_U(sim, expMicroLifeTicks, TUNE_EXP_MICRO_LIFE, 40)
TP_U(sim, expMicroScaleIdx, TUNE_EXP_MICRO_SCALE_IDX, 2)
// ---- MLS-MPM fluid, HUMAN units ----
// These are floats in real units (voxels/s², voxels/s, vox²/s, seconds) —
// the ONE deliberate exception to "sim.* is integer-only". The kernel still
// never sees a runtime float: sim_fluid.wgsl converts each to Q16.16-per-tick
// at SHADER COMPILE TIME (WGSL const-eval, IEEE-exact, identical on every
// machine for identical JSON), so rule 1's actual guarantee is intact and the
// fluid-det gate stays the enforcement.
// Units: stiffness/cohesion/attract in (vox/s)^2, gravity vox/s^2, rest
// density particles/voxel, viscosity vox^2/s, damping fraction/s, splash rate
// droplets/s, splash speed vox/s, splash life seconds.
TP_F(sim, fluidStiffness, TUNE_FLUID_STIFFNESS, 5400.0f)
TP_F(sim, fluidGravity, TUNE_FLUID_GRAVITY, 98.1f)
TP_F(sim, fluidRestDensity, TUNE_FLUID_REST_DENSITY, 8.0f)
TP_I(sim, fluidEosPower, TUNE_FLUID_EOS_POWER, 4)
TP_F(sim, fluidCohesion, TUNE_FLUID_COHESION, 90.0f)
TP_F(sim, fluidAttractSame, TUNE_FLUID_ATTRACT_SAME, 45.0f)
TP_F(sim, fluidAttractDiff, TUNE_FLUID_ATTRACT_DIFF, -90.0f)
TP_F(sim, fluidViscosity, TUNE_FLUID_VISCOSITY, 1.5f)
TP_F(sim, fluidDamping, TUNE_FLUID_DAMPING, 0.0f)
// Splash coupling: fast free-surface particles shed micro droplets into the
// ballistic particle system (sim_fluid.wgsl g2p).
TP_F(sim, fluidSplashRate, TUNE_FLUID_SPLASH_RATE, 4.0f)
TP_F(sim, fluidSplashSpeed, TUNE_FLUID_SPLASH_SPEED, 18.0f)
TP_F(sim, fluidSplashMaxDensity, TUNE_FLUID_SPLASH_MAXDENS, 0.7f)
TP_F(sim, fluidSplashLife, TUNE_FLUID_SPLASH_LIFE, 1.1f)
TP_U(sim, fluidSplashScaleIdx, TUNE_FLUID_SPLASH_SCALE_IDX, 2)
// ---- diffuse material: spray / foam / bubbles (Ihmsen et al. 2012, CGI) ----
// Three potentials, each mapped to 0..1 by the paper's clamping function
//   Phi(I, tmin, tmax) = (min(I,tmax) - min(I,tmin)) / (tmax - tmin),
// then combined as  n_d = I_k * (k_ta * I_ta + k_wc * I_wc) * dt   (Eq. 8).
// Trapped air is a convergence-weighted relative-velocity sum over the node
// neighbourhood; wave crest is a convexity-gated curvature of the density
// gradient; energy is the particle's kinetic energy. Thresholds are in the
// natural unit of each measure so the tuner reads in vox/s and (vox/s)^2.
TP_F(sim, fluidFoamRate, TUNE_FLUID_FOAM_RATE, 90.0f)
TP_F(sim, fluidFoamCrestRate, TUNE_FLUID_FOAM_CREST_RATE, 120.0f)
TP_F(sim, fluidTrappedMin, TUNE_FLUID_TRAPPED_MIN, 1.5f)
TP_F(sim, fluidTrappedMax, TUNE_FLUID_TRAPPED_MAX, 11.0f)
TP_F(sim, fluidCrestMin, TUNE_FLUID_CREST_MIN, 0.25f)
TP_F(sim, fluidCrestMax, TUNE_FLUID_CREST_MAX, 2.0f)
TP_F(sim, fluidFoamEnergyMin, TUNE_FLUID_FOAM_EMIN, 8.0f)
TP_F(sim, fluidFoamEnergyMax, TUNE_FLUID_FOAM_EMAX, 260.0f)
TP_F(sim, fluidFoamLife, TUNE_FLUID_FOAM_LIFE, 2.2f)
TP_F(sim, fluidFoamLifeMin, TUNE_FLUID_FOAM_LIFE_MIN, 0.5f)
TP_F(sim, fluidBubbleBuoyancy, TUNE_FLUID_BUBBLE_BUOY, 1.6f)
TP_F(sim, fluidFoamDrag, TUNE_FLUID_FOAM_DRAG, 0.72f)
TP_F(sim, fluidBubbleDensity, TUNE_FLUID_BUBBLE_RHO, 1.05f)
TP_F(sim, fluidSprayDensity, TUNE_FLUID_SPRAY_RHO, 0.42f)
TP_U(sim, fluidFoamScaleIdx, TUNE_FLUID_FOAM_SCALE_IDX, 3)

// ---- worldgen (integer; needs a world regen to take effect) ----
TP_I(worldgen, treeline, TUNE_TREELINE, 72)
TP_I(worldgen, baseHeight, TUNE_BASE_HEIGHT, 32)
TP_I(worldgen, hillAmplitude, TUNE_HILL_AMPLITUDE, 42)
TP_I(worldgen, hillWavelength, TUNE_HILL_WAVELENGTH, 64)
TP_I(worldgen, detailAmplitude, TUNE_DETAIL_AMPLITUDE, 12)
TP_I(worldgen, detailWavelength, TUNE_DETAIL_WAVELENGTH, 16)
TP_I(worldgen, biomeScale, TUNE_BIOME_SCALE, 384)
TP_U(worldgen, desertThreshold, TUNE_DESERT_THRESHOLD, 214)
TP_U(worldgen, pineThreshold, TUNE_PINE_THRESHOLD, 176)
TP_U(worldgen, meadowThreshold, TUNE_MEADOW_THRESHOLD, 92)
TP_I(worldgen, treeTile, TUNE_TREE_TILE, 144)
TP_U(worldgen, treeChanceForest, TUNE_TREE_CHANCE_FOREST, 78)
TP_U(worldgen, treeChancePine, TUNE_TREE_CHANCE_PINE, 70)
TP_U(worldgen, treeChanceMeadow, TUNE_TREE_CHANCE_MEADOW, 22)
TP_U(worldgen, treeChanceDesert, TUNE_TREE_CHANCE_DESERT, 6)
TP_U(worldgen, autumnFraction, TUNE_AUTUMN_FRACTION, 5)
TP_I(worldgen, pondTile, TUNE_POND_TILE, 448)
TP_U(worldgen, pondChance, TUNE_POND_CHANCE, 4)
TP_I(worldgen, pondRadiusMin, TUNE_POND_RADIUS_MIN, 68)
TP_U(worldgen, pondRadiusSpan, TUNE_POND_RADIUS_SPAN, 60)
// Bowl depth in VOXELS at the pond centre, tapering to pondDepthRim at the
// edge. At kVoxelMeters 0.10 the player capsule is 17 voxels tall, so the old
// 8-voxel centre depth was 0.8 m — ankle deep, and it made "swim in a pond"
// impossible anywhere except the one authored lake. 26 puts the centre at
// 2.6 m, comfortably over the player's head, while the rim stays shallow
// enough to wade in from.
TP_I(worldgen, pondDepth, TUNE_POND_DEPTH, 26)
TP_I(worldgen, pondDepthRim, TUNE_POND_DEPTH_RIM, 3)
// 1-in-N chance a surface cell over deep enough water carries a lilypad, and
// 1-in-N that a pad carries a blossom.
TP_U(worldgen, lilyChance, TUNE_LILY_CHANCE, 22)
TP_U(worldgen, lilyFlowerChance, TUNE_LILY_FLOWER_CHANCE, 5)
// 1-in-N chance a shallow-margin column grows a reed clump, and how tall the
// clump runs (voxels above the bed, so a reed in deeper water is still cut off
// at the surface by the emergent check in genCell).
TP_U(worldgen, reedChance, TUNE_REED_CHANCE, 130)
TP_I(worldgen, reedHeight, TUNE_REED_HEIGHT, 16)
// 1-in-N chance a deeper bed column grows kelp, and its height in voxels.
TP_U(worldgen, kelpChance, TUNE_KELP_CHANCE, 120)
TP_I(worldgen, kelpHeight, TUNE_KELP_HEIGHT, 10)
// ---- vines / climbers / hanging moss (worldgen agent B) ----
// A hanging vine is a CURTAIN under a canopy: one roll per COLUMN decides
// whether that column hosts a strand, and the strand then runs from the canopy
// underside down by a jittered length. 1-in-N over the canopy footprint, so a
// small number here furs the whole forest — 26 puts a strand every ~5 voxels
// of canopy, which reads as a draped tree rather than as a hanging curtain
// wall. Great oaks halve it (they are the ancient ones).
TP_U(worldgen, vineChance, TUNE_VINE_CHANCE, 26)
// Strand length in voxels, min + a 0..span jitter. The jitter is what gives
// the curtain a ragged hem instead of a machine-cut edge; keep the span
// comparable to the min or every strand ends at visibly the same height.
TP_I(worldgen, vineLenMin, TUNE_VINE_LEN_MIN, 10)
TP_I(worldgen, vineLenSpan, TUNE_VINE_LEN_SPAN, 26)
// 1-in-N vine strands are a FLOWERING creeper, which then blooms every 7th
// cell down its length. Gated on the same column roll as the vine, so a
// blossom can only ever appear on a column that actually grew one.
TP_U(worldgen, creeperFlowerChance, TUNE_CREEPER_FLOWER_CHANCE, 9)
// Spanish-moss beards on the great oaks and birches: 1-in-N columns, and a
// short length, because moss is a fuzz on the structure rather than a strand
// hanging off it. Longer than ~14 and it stops reading as moss.
TP_U(worldgen, mossChance, TUNE_MOSS_CHANCE, 14)
TP_I(worldgen, mossLenMin, TUNE_MOSS_LEN_MIN, 4)
TP_I(worldgen, mossLenSpan, TUNE_MOSS_LEN_SPAN, 9)
// Ivy climbing a trunk: 1-in-N of the cells on the bole's outer shell, gated
// to a couple of angular ropes rather than sheathing the trunk.
TP_U(worldgen, ivyChance, TUNE_IVY_CHANCE, 2)
// How fast the ivy ropes spiral around the bole, in 1/16 of a 256-step turn
// per voxel of height. 0 = straight vertical stripes.
TP_I(worldgen, ivyTwist, TUNE_IVY_TWIST, 5)
// Ivy coverage on the ARENA and RUIN stone walls, 1..8. Higher is denser;
// coverage always falls off toward the top of the wall so the coping stays
// clear and the creeper reads as having climbed rather than been painted.
TP_U(worldgen, wallIvyDensity, TUNE_WALL_IVY_DENSITY, 3)
// ---- shoreline: the wet fringe outside a pond ----
// RESTORED by agent E: these ten rows were dropped from this file during a
// concurrent rollback while their declarations stayed in tuning.h and their
// TUNE_* names stayed referenced by worldgen.wgsl. That combination passes
// check_invariants' .h side and still fails tint with "unresolved value
// TUNE_SHORE_BAND", which invalidates the worldgen pipeline and makes EVERY
// gate fail as a determinism regression. Defaults below are read straight off
// the declarations in tuning.h so they cannot disagree with it.
TP_I(worldgen, shoreBand, TUNE_SHORE_BAND, 24)
TP_I(worldgen, shoreMudWidth, TUNE_SHORE_MUD_WIDTH, 10)
// How far ABOVE the waterline a column may stand and still count as shore, in
// voxels. The most load-bearing knob in the feature: pondSurface is
// min(rim) - 2, so most of a rim stands well above the water, and a fringe
// defined by radius alone paints marsh up whatever hillside abuts the disc.
// Cutting on height instead puts the reed beds in the shallow bays and leaves
// the steep sides as dry bank. It moves coverage a long way — at the default
// pond it keeps 5% of the raw band at 4 and 99% at 24.
TP_I(worldgen, shoreLift, TUNE_SHORE_LIFT, 12)
TP_U(worldgen, shoreCattailChance, TUNE_SHORE_CATTAIL_CHANCE, 12)
TP_I(worldgen, shoreCattailReach, TUNE_SHORE_CATTAIL_REACH, 9)
TP_I(worldgen, shoreCattailHeight, TUNE_SHORE_CATTAIL_HEIGHT, 20)
TP_U(worldgen, shoreSedgeChance, TUNE_SHORE_SEDGE_CHANCE, 4)
TP_U(worldgen, shoreHorsetailChance, TUNE_SHORE_HORSETAIL_CHANCE, 10)
TP_I(worldgen, shoreHorsetailHeight, TUNE_SHORE_HORSETAIL_HEIGHT, 9)
TP_U(worldgen, shoreIrisChance, TUNE_SHORE_IRIS_CHANCE, 34)
TP_U(worldgen, shoreMossChance, TUNE_SHORE_MOSS_CHANCE, 3)
// ---- desert / pine highland / alpine ground cover (worldgen agent E) ----
// The three biomes that generated bare. All of these are 1-in-N per column
// inside the relevant mask, or a percentage where noted, and every one of them
// places INERT material in a single voxel above the surface (rule 2).
//
// Cacti. `cactusChance` is a PERCENT per 2.5 m tile, not a 1-in-N, matching
// treeChance* above — a cactus is placed by the same per-tile scheme a tree is.
// `saguaroFraction` is the percentage of those that are tall columns rather
// than ground-level barrels; the columns are landmarks, so they have to stay
// occasional or the desert reads as a plantation.
TP_U(worldgen, cactusChance, TUNE_CACTUS_CHANCE, 26)
TP_U(worldgen, saguaroFraction, TUNE_SAGUARO_FRACTION, 22)
// Desert ground cover, 1-in-N per column. Tussock is the common one — it is
// what stops bare sand reading as a texture — and scrub is the woody accent.
// Both are gated by a patch mask so the desert has bare stretches between
// stands rather than an even sprinkle, which is what makes it read as arid.
TP_U(worldgen, tussockChance, TUNE_TUSSOCK_CHANCE, 9)
TP_U(worldgen, scrubChance, TUNE_SCRUB_CHANCE, 26)
// vnoise 0..255 threshold for the desert patch mask: cover only grows where the
// mask is above this, so the biome keeps open sand between its stands.
TP_I(worldgen, desertPatch, TUNE_DESERT_PATCH, 130)
// Pine-highland floor: huckleberry/juniper under the conifers, 1-in-N per
// column inside its own patch mask.
TP_U(worldgen, heathChance, TUNE_HEATH_CHANCE, 7)
TP_I(worldgen, heathPatch, TUNE_HEATH_PATCH, 128)
// Alpine cushion above TREELINE, 1-in-N per column. DELIBERATELY the sparsest
// number in this file: the snowline is meant to read as harsh, and a ridge
// planted at forest-floor density says the opposite. Raising this is the one
// knob that can undo the whole intent of the alpine band.
TP_U(worldgen, alpineChance, TUNE_ALPINE_CHANCE, 40)
// RESTORED by agent E along with the shore rows above: these three were also
// lost from this file during the concurrent rollback while their declarations
// stayed in tuning.h, which is the combination that fails tint at
// "unresolved value TUNE_CAVE_THRESHOLD1" rather than at compile time.
TP_U(worldgen, ruinChance, TUNE_RUIN_CHANCE, 5)
TP_U(worldgen, caveThreshold1, TUNE_CAVE_THRESHOLD1, 150)
TP_U(worldgen, caveThreshold2, TUNE_CAVE_THRESHOLD2, 148)

// ---- oil / petroleum-like viscous liquids (shadeViscous) ----
// Oil and blood share the viscous SURFACE path but look nothing alike, and the
// blood constants applied to oil rendered the pool as flat beige mud. These are
// the oil end of every term that differs; oiliness() derives the blend from the
// material's own authored palette saturation, so no material ids are involved
// and any petroleum-like liquid gets the look for free.
//
// Saturation band separating a biological fluid from a petroleum one. Blood's
// authored colour0 is 0.85 saturated, oil's is 0.46 - pigment suspensions are
// strongly chromatic, petroleum is a near-neutral brown-black.
TP_F(render, oilSatLow, TUNE_OIL_SAT_LOW, 0.5f)
TP_F(render, oilSatHigh, TUNE_OIL_SAT_HIGH, 0.78f)
// Head-on and grazing reflectance. Oil's IOR is ~1.47 against water's 1.33, so
// F0 is roughly double, and unlike blood it really does approach a mirror at
// the horizon - that hard bright rim is the look, not an artifact.
TP_F(render, oilF0, TUNE_OIL_F0, 0.043f)
TP_F(render, oilGraze, TUNE_OIL_GRAZE, 0.97f)
// Specular exponent. Much tighter than blood's: a smooth film gives a small
// hard glint where a rough suspension gives a broad soft one, and that
// narrowness is most of what reads as "glossy" rather than "damp".
TP_F(render, oilGloss, TUNE_OIL_GLOSS, 620.0f)
TP_F(render, oilSheen, TUNE_OIL_SHEEN, 1.6f)
// How much the reflection is tinted by the liquid's own colour. Near zero for
// oil: a petroleum film is a near-NEUTRAL dark mirror, so what you see in it is
// the sky and the far bank rather than a brown wash of its own body.
TP_F(render, oilReflectTint, TUNE_OIL_REFLECT_TINT, 0.12f)
// How far oil's body colour is pushed toward black. Petroleum absorbs nearly
// everything that enters it and reflects the rest off the surface, the opposite
// of blood's bright backscatter - this is the term that kills the beige.
TP_F(render, oilDarken, TUNE_OIL_DARKEN, 0.35f)
// Thin-film interference: the rainbow slick. Strength, and the spatial scale of
// the film-thickness field that sets the band spacing.
TP_F(render, oilIridescence, TUNE_OIL_IRIDESCENCE, 0.16f)
TP_F(render, oilFilmScale, TUNE_OIL_FILM_SCALE, 1.1f)
// How readily a density difference counts as "floating on". The iridescent
// sheen only appears where oil lies on a DENSER liquid (floatingOnLiquid);
// this scales how much denser the layer below has to be before it reads as a
// real boundary rather than a mixture. Oil 900 on water 1000 is a ratio of
// 0.111, so at 9.0 that saturates immediately.
TP_F(render, oilFloatSens, TUNE_OIL_FLOAT_SENS, 9.0f)
// Width of the silhouette-softening band for oil, against blood's 0.28. Blood
// can afford a wide feather because its body colour reads through the blend;
// oil's body is nearly black by design, so the same fade leaves a droplet with
// nothing to hold up against the background and it becomes a smear of the
// scene behind it. This is most of why oil looked see-through.
TP_F(render, oilEdgeBand, TUNE_OIL_EDGE_BAND, 0.07f)
// How much plain sky reflection an UNPOOLED oil surface returns. A droplet is
// a tiny curved mirror scattering the sky in every direction, so far less
// reaches the eye than off a flat pool; at 1.0 a grazing droplet returns
// full-brightness sky and reads as a hole in the world.
TP_F(render, oilDropReflect, TUNE_OIL_DROP_REFLECT, 0.3f)

// Faint directional glow toward the surface when submerged in a medium too
// dense to see through. Without it a dense liquid is a featureless field of
// colour with no sense of up and nothing in motion - physically honest, but it
// reads as a broken shader rather than as being under the oil.
TP_F(render, subMurkGlow, TUNE_SUB_MURK_GLOW, 2.2f)

// clang-format on
