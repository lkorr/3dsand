// ==== gore ====
// Read order mirrors the banding in Tuning::Gore: micro spray first
// (shared droplet properties, then bleed, then sever), whole-voxel blood
// second, variance last.
// ---- A. micro spray ----
// The life field is 8 bits in Particle.flags (PMICRO_LIFE_MASK). A value
// past 255 would wrap and produce droplets that die instantly, which reads
// as "the spray stopped working" rather than as a bad number.
TP_I(gore, microLifeTicks, NO_WGSL, 70, 1, 255)
// + a hand-written rule in LoadTuning
TP_I(gore, microScale, NO_WGSL, 4, 2, 6)
TP_F(gore, bleedSprayPerDrip, NO_WGSL, 3.0f, 0.0f, 24.0f)
TP_F(gore, bleedSpraySpeed, NO_WGSL, 3.5f, 0.0f, 30.0f)
TP_F(gore, bleedSprayCone, NO_WGSL, 0.55f, 0.0f, 2.0f)
TP_I(gore, severSpray, NO_WGSL, 220, 0, 2000)
TP_I(gore, severDecayTicks, NO_WGSL, 45, 1, 300)
TP_F(gore, severSpraySpeed, NO_WGSL, 9.0f, 0.0f, 40.0f)
TP_F(gore, severSprayCone, NO_WGSL, 0.8f, 0.0f, 2.0f)
// ---- B. whole-voxel blood ----
TP_F(gore, bleedVoxelGain, NO_WGSL, 1.0f, 0.0f, 8.0f)
// The cap is what bounds ONE wound's total output. Zero means a wound
// never owes anything, i.e. drips are off; negative is meaningless.
TP_F(gore, bleedBudgetCap, NO_WGSL, 120.0f, 0.0f, 600.0f)
TP_F(gore, severStumpBudget, NO_WGSL, 40.0f, 0.0f, 400.0f)
TP_F(gore, corpseBleedPerVoxel, NO_WGSL, 1.5f, 0.0f, 10.0f)
TP_F(gore, corpseJointHold, NO_WGSL, 1.1f, 0.0f, 8.0f)
TP_F(gore, corpseJointCut, NO_WGSL, 0.12f, 0.0f, 1.0f)
// ---- whole-voxel bleeding bounds (rule 2) ----
// The drip period and the op budget together cap how much real matter a
// wound can push into the CA, so both need a hard floor/ceiling here
// rather than a "should be sensible" comment. A period of 0 would drip
// every tick AND divide nothing — it is the one value that turns a wound
// into an unbounded fountain.
TP_I(gore, bleedDripTicks, NO_WGSL, 4, 1, 60)
// 64 is far above anything the look needs (six is the shipped value) and
// still leaves the per-tick cell-op queue overwhelmingly free.
TP_I(gore, bleedOpsPerTick, NO_WGSL, 6, 0, 64)
// ---- clump size (rule 2) ----
// 3 is the ceiling, not the shader's max brush radius of 7. A drip is a
// REPEATING source: the sphere volume goes 1/7/33/123/257, so by radius 4
// one wound is pushing a quarter of a chunk's worth of liquid per drip and
// the CA cannot settle it between drips — the chunk stops sleeping, which
// is a rule 2 failure that presents as a perf bug. The budget debit scales
// with the same volume (BleedClumpVoxels), so a big clump empties a wound
// proportionally faster rather than multiplying its total output.
TP_I(gore, bleedClumpRadius, NO_WGSL, 0, 0, 3)
TP_I(gore, severVoxels, NO_WGSL, 14, 0, 200)
TP_F(gore, severVoxelSpeed, NO_WGSL, 6.0f, 0.0f, 30.0f)
// A gobbet subdivides severVoxels rather than multiplying it, so the only
// real bound needed is "at least one particle per gobbet". 64 is a sanity
// ceiling: past it a gobbet exceeds any sane severVoxels and the throw
// degenerates to a single lump.
TP_I(gore, severGobbetVoxels, NO_WGSL, 1, 1, 64)
TP_F(gore, severGobbetSpread, NO_WGSL, 0.6f, 0.0f, 4.0f)
// ---- C. variance ----
// A negative or zero gain would silently disable bleeding rather than
// reading as a tuning mistake, so floor it just above zero.
TP_F(gore, bleedGain, NO_WGSL, 1.0f, 0.0f, 8.0f)
// ---- D. crater shape ----
// 0 is a load-bearing value, not just the low end: the mob gate asserts
// that carveChunkiness 0 removes byte-identically the same voxels the old
// white-noise crater did. Clamping it here is what keeps that identity
// reachable from a slider that has been dragged past the end.
TP_F(gore, carveChunkiness, NO_WGSL, 0.65f, 0.0f, 1.0f)
TP_F(gore, carveBlobSize, NO_WGSL, 3.5f, 0.5f, 12.0f)
TP_F(gore, carveFalloff, NO_WGSL, 3.0f, 1.0f, 8.0f)
// Each round is a full pass over the limb's voxels and can only ever
// REMOVE, so an unbounded count is a way to erase a body one slider drag
// at a time. Four is already past the point where more reads as different.
TP_I(gore, carveSpallRounds, NO_WGSL, 2, 0, 4)
// ---- E. the wound model (game/mob.h Mob::CutLimb) ----------------------
// BOUNDS, not taste. Each of these is a value that turns the wound model
// into something other than a wound model at the ends of its range, and
// the tuner offers a text box as well as a slider.
//
// A negative depth or length is a kerf that removes nothing, which reads
// as "the sword stopped working" rather than as a bad number; a huge one
// is a swing that erases a limb, which is exactly the behaviour this whole
// change exists to remove. woundHeftRef divides, so zero is a division by
// zero dressed up as a slider.
TP_F(gore, cutDepth, NO_WGSL, 0.08f, 0.0f, 8.0f)
TP_F(gore, cutDepthPower, NO_WGSL, 0.32f, 0.0f, 8.0f)
TP_F(gore, cutLength, NO_WGSL, 0.90f, 0.1f, 16.0f)
TP_F(gore, cutWidth, NO_WGSL, 0.20f, 0.05f, 4.0f)
TP_I(gore, cutSpallRounds, NO_WGSL, 1, 0, 4)
TP_F(gore, cutSpallStrength, NO_WGSL, 0.30f, 0.0f, 1.0f)
TP_F(gore, cleaveArea, NO_WGSL, 1.6f, 0.0f, 16.0f)
// 1 would divide by zero in the power shaping (Tuning::Gore::cleaveFrom).
TP_F(gore, cleaveFrom, NO_WGSL, 0.5f, 0.0f, 0.95f)
// The kerf's half-thickness floor, world voxels (was a literal 0.08 in melee.cpp).
TP_F(gore, cutWidthMin, NO_WGSL, 0.08f, 0.0f, 2.0f)
// THE STAB (Tuning::Gore::stabAlign). Above 1 no blow is ever a stab.
TP_F(gore, stabAlign, NO_WGSL, 0.7f, 0.0f, 1.01f)
TP_F(gore, stabDepth, NO_WGSL, 0.35f, 0.0f, 8.0f)
TP_F(gore, stabDepthPower, NO_WGSL, 0.6f, 0.0f, 8.0f)
TP_F(gore, stabWidth, NO_WGSL, 0.4f, 0.05f, 4.0f)
TP_F(gore, stabThick, NO_WGSL, 0.1f, 0.0f, 2.0f)
TP_F(gore, woundHeftRef, NO_WGSL, 5.3f, 0.01f, 60.0f)
TP_F(gore, woundHeftMax, NO_WGSL, 4.0f, 1.0f, 32.0f)
TP_F(gore, woundStainRadius, NO_WGSL, 0.90f, 0.0f, 16.0f)
TP_F(gore, woundStainSurface, NO_WGSL, 0.90f, 0.0f, 1.0f)
TP_F(gore, woundStainDensity, NO_WGSL, 0.30f, 0.0f, 1.0f)
TP_F(gore, woundStainBlob, NO_WGSL, 0.5f, 0.25f, 16.0f)
TP_F(gore, woundStainCoherence, NO_WGSL, 0.8f, 0.0f, 1.0f)
TP_F(gore, craterStainRim, NO_WGSL, 1.5f, 0.0f, 16.0f)
TP_B(gore, woundHeals, NO_WGSL, true)
// A DIVISOR. Below 1 it would make a wound dry FASTER than the authored
// rule, which is a different feature wearing this one's name; the ceiling
// is where "slower" has become "never" anyway.
TP_F(gore, woundHealSlow, NO_WGSL, 2.0f, 1.0f, 64.0f)
TP_F(gore, stainCutRadius, NO_WGSL, 1.6f, 0.0f, 16.0f)
TP_I(gore, stainCutAmount, NO_WGSL, 15, 0, 15)
TP_I(gore, stainCutBuried, NO_WGSL, 6, 0, 15)
TP_F(gore, stainCutBuriedChance, NO_WGSL, 0.35f, 0.0f, 1.0f)
TP_I(gore, stainBoneMin, NO_WGSL, 5, 0, 15)
// The re-bleed (Tuning::Gore::woundRebloodTicks). 0 ticks turns it off.
TP_I(gore, woundRebloodTicks, NO_WGSL, 15, 0, 600)
TP_F(gore, woundRebloodRadius, NO_WGSL, 0.45f, 0.0f, 4.0f)
TP_I(gore, woundRebloodAmount, NO_WGSL, 12, 0, 15)
TP_F(gore, woundRebloodFull, NO_WGSL, 20.0f, 1.0f, 1000.0f)
TP_F(gore, stainContactScale, NO_WGSL, 1.0f, 0.0f, 8.0f)
TP_F(gore, stainFloorTransfer, NO_WGSL, 0.35f, 0.0f, 1.0f)
TP_I(gore, stainWashPerContact, NO_WGSL, 3, 0, 15)
TP_F(gore, splatterReach, NO_WGSL, 48.0f, 0.0f, 256.0f)
TP_I(gore, splatterAmount, NO_WGSL, 6, 0, 15)
TP_I(gore, splatterPerLimb, NO_WGSL, 64, 0, 256)
TP_F(gore, splatterSplatRadius, NO_WGSL, 0.3f, 0.0f, 2.0f)
// A sever fraction of 0 severs on the first disconnected speck — that is
// the straggler bug in Mob::CarveLimb wearing a slider — and 1 can never
// fire at all. Both ends are excluded rather than merely discouraged.
TP_F(gore, woundSeverFraction, NO_WGSL, 0.28f, 0.05f, 0.95f)
TP_F(gore, woundNeckRadius, NO_WGSL, 0.80f, 0.0f, 16.0f)
TP_F(gore, woundNeckFraction, NO_WGSL, 0.28f, 0.0f, 0.95f)
TP_F(gore, woundImpactSeverScale, NO_WGSL, 4.0f, 0.0f, 20.0f)
// ---- E6. trauma and teeth (game/impact.h) -------------------------------
TP_F(gore, bruiseRadius, NO_WGSL, 0.9f, 0.0f, 8.0f)
// The coat is a 0..15 nibble, so a step past it is a step to full opacity
// in one blow -- legal, and what an author asking for 15 means.
TP_F(gore, bruiseStep, NO_WGSL, 6.0f, 0.0f, 15.0f)
TP_F(gore, bruiseMax, NO_WGSL, 12.0f, 0.0f, 15.0f)
TP_F(gore, bruiseBleedChance, NO_WGSL, 0.55f, 0.0f, 1.0f)
TP_F(gore, bruiseBleedFrom, NO_WGSL, 0.85f, 0.0f, 1.0f)
// Non-negative only: 0 means "do not scale the step by hp at all", which is
// the pre-2026-09-19 behaviour and the honest way to switch this off.
TP_F(gore, bruiseHpRef, NO_WGSL, 16.0f, 0.0f, 64.0f)
TP_F(gore, bruiseHpFloor, NO_WGSL, 0.45f, 0.0f, 1.0f)
// BY NAME, not by id -- see Tuning::Gore::bruiseMat for why. An empty
// string is legal and means "do not bruise"; an unknown name resolves to 0
// at use and means the same thing, so there is nothing to clamp here.
TP_S(gore, bruiseMat, NO_WGSL, "skin_bruised")
TP_F(gore, bluntBleedScale, NO_WGSL, 0.1f, 0.0f, 1.0f)
// Ceiling, not taste: a dent as wide as a limb stops being a dent and
// becomes an amputation by arithmetic, which is the one thing a blunt hit
// must never be (Mob::BluntCarveScope).
TP_F(gore, bluntCarveRadius, NO_WGSL, 0.7f, 0.0f, 4.0f)
TP_F(gore, pulpAmt, NO_WGSL, 8.0f, 1.0f, 15.0f)
// 1 is legal and means "never": nothing short of a wholly bloodied core
// earns a dent, and a core is never wholly anything because of the taper.
TP_F(gore, pulpCarveFrom, NO_WGSL, 0.3f, 0.0f, 1.0f)
TP_F(gore, pulpRotRate, NO_WGSL, 1.5f, 0.0f, 20.0f)
TP_F(gore, unarmedBruiseRadius, NO_WGSL, -1.0f, -1.0f, 8.0f)
TP_F(gore, unarmedBruiseStep, NO_WGSL, -1.0f, -1.0f, 15.0f)
TP_F(gore, unarmedBleedChance, NO_WGSL, -1.0f, -1.0f, 1.0f)
TP_F(gore, unarmedBleedScale, NO_WGSL, -1.0f, -1.0f, 1.0f)
TP_F(gore, unarmedCarveRadius, NO_WGSL, -1.0f, -1.0f, 4.0f)
TP_F(gore, unarmedPulpCarveFrom, NO_WGSL, -1.0f, -1.0f, 1.0f)
// A hard blunt blow to the head can knock the creature down (Mob::BluntHit).
TP_F(gore, headKnockPower, NO_WGSL, 0.7f, 0.0f, 1.0f)
TP_F(gore, headKnockChance, NO_WGSL, 0.5f, 0.0f, 1.0f)
TP_F(gore, headKnockSeconds, NO_WGSL, 1.0f, 0.0f, 10.0f)
TP_F(gore, biteRadius, NO_WGSL, 0.45f, 0.0f, 8.0f)
// Floored at the same 0.5 the crater's and rot's blob sizes are: below one
// lattice cell the correlated field degenerates to white noise and the
// tear goes back to being speckle (see ValueNoise3).
TP_F(gore, biteBlob, NO_WGSL, 2.5f, 0.5f, 12.0f)
TP_F(gore, biteStainScale, NO_WGSL, 1.5f, 0.0f, 8.0f)
// Floored at 1 for the reason woundHealSlow is: a divisor below 1 would
// make rot decay FASTER than the puddle rule it is dividing, and 0 is a
// division by zero rather than "never heals" (that is `woundHeals` off).
TP_F(gore, infectHealSlow, NO_WGSL, 6.0f, 1.0f, 512.0f)
// Ceilings rather than taste, and the same one for both: a rate past a
// human body's worth of voxels a minute stops being a disease and becomes a
// dissolve, and the pass's per-burst work scales with it. 0 is meaningful on
// either (see the note in tuning.h) so neither has a floor above it.
TP_F(gore, infectSpreadRate, NO_WGSL, 1.0f, 0.0f, 240.0f)
TP_F(gore, infectRotRate, NO_WGSL, 0.5f, 0.0f, 240.0f)
TP_F(gore, infectMobMult, NO_WGSL, 1.0f, 0.0f, 50.0f)
// The coat the rot lays on the bone it uncovers. All three are cosmetic
// and all three are meaningful at their floor: 0 stain = white bone back,
// 0 vary = one flat shade, 0 ichor = the victim's blood only.
TP_F(gore, infectBoneStain, NO_WGSL, 11.0f, 0.0f, 15.0f)
TP_F(gore, infectBoneStainVary, NO_WGSL, 5.0f, 0.0f, 15.0f)
TP_F(gore, infectBoneIchor, NO_WGSL, 0.45f, 0.0f, 1.0f)
TP_F(gore, brainHpPerVoxel, NO_WGSL, 10.0f, 0.0f, 200.0f)
// What losing matter costs (was mob.h kCarveDamagePerVolume).
TP_F(gore, carveHpPerVolume, NO_WGSL, 1.5f, 0.0f, 20.0f)
// Blast power for a full-radius body crater. Floor 1: it is a divisor.
TP_F(gore, blastPowerRef, NO_WGSL, 200.0f, 1.0f, 2000.0f)
// A thrown rock is a blow (MobSystem::ApplyContactDamage, W2-H phase 2).
// contactMaxPerTick is the rule-2 bound on contacts billed per tick.
TP_F(gore, contactImpulseMin, NO_WGSL, 40.0f, 0.0f, 2000.0f)
TP_F(gore, contactHpPerImpulse, NO_WGSL, 0.25f, 0.0f, 4.0f)
TP_F(gore, contactMaxHp, NO_WGSL, 60.0f, 0.0f, 1000.0f)
TP_I(gore, contactMaxPerTick, NO_WGSL, 8, 0, 64)
// Striker's own approach speed floor (vox/s) and its minimum run of motion
// (voxels) before a contact is a blow: walking into a body never hurts.
TP_F(gore, contactMinSpeed, NO_WGSL, 15.0f, 0.0f, 500.0f)
TP_F(gore, contactMinTravel, NO_WGSL, 2.0f, 0.0f, 100.0f)
// ---- F. blood is health / G. burns cap health (game/mob.h) -------------
// A negative rate would make bleeding HEAL, which is not a tuning
// mistake anyone means; zero is a legitimate "blood is cosmetic again".
TP_F(gore, bleedHpPerVoxel, NO_WGSL, 0.6f, 0.0f, 5.0f)
TP_B(gore, stumpBleedsOpen, NO_WGSL, true)
// + a hand-written rule in LoadTuning
TP_F(gore, burnCapMidFraction, NO_WGSL, 0.40f, 0.05f, 0.95f)
TP_F(gore, burnCapMidHealth, NO_WGSL, 0.333f, 0.0f, 1.0f)
// The burn curve must stay a curve: the mid knot strictly inside (0,
// death), the death knot at most 1 (a body cannot be more than all
// burnt), and the mid health inside [0, 1] so the cap is monotone.
// + a hand-written rule in LoadTuning
TP_F(gore, burnDeathFraction, NO_WGSL, 0.70f, 0.05f, 1.0f)


// ==== coat ====
// ---- coats: a substance on a body (Tuning::Coat) --------------------------
// CPU-only, like `gore` above. The per-SUBSTANCE half of this feature is in
// materials.json ("coat": { decay, shed, effects }); these are the engine's
// cadences and budgets over it.
// A recount period of 0 would retake the ledger every tick a body is
// dirty, which is one full lattice pass per creature per tick — the rule 2
// trap this cadence exists to close.
TP_I(coat, recountTicks, NO_WGSL, 8, 1, 240)
// decayScale DIVIDES the authored seconds, so 0 is a division by zero
// dressed up as "nothing ever dries" — say that with a small number.
// 300 is not arbitrary: it is what turns blood's authored 20 s per level
// into a two-tick period, which is the `body-coat` gate's fast arm and the
// fastest anything here is meant to be dialled.
TP_F(coat, decayScale, NO_WGSL, 1.0f, 0.01f, 300.0f)
TP_F(coat, sunDryScale, NO_WGSL, 2.0f, 1.0f, 20.0f)
TP_I(coat, shedCells, NO_WGSL, 3, 0, 32)
TP_I(coat, shedPerTick, NO_WGSL, 64, 0, 1024)
TP_I(coat, shedAmount, NO_WGSL, 2, 0, 15)
TP_F(coat, hudMinFrac, NO_WGSL, 0.02f, 0.0f, 1.0f)


// ==== melee ====
// ---- BOUNDS, not taste ---------------------------------------------------
// Every clamp here protects a STRUCTURAL property of the stroke rather than
// an opinion about how it should feel, and each one is a thing a slider
// dragged to its end can otherwise break outright:
//
//   * a zero or negative time divides in the phase machine's own
//     normalisation;
//   * a zero speed BAND makes the damage ramp `(v - min) / (full - min)`
//     singular, and the sweep's own `max(..., 1e-3f)` would then quietly
//     turn every touch into a full-power hit;
//   * a smoothing halflife of 0 is a step function, which is what the lean
//     plane's rate limit exists to avoid (melee.h: the interpolation
//     between two opposite leans passes through the degenerate radius);
//   * an aim gain of 0 disconnects the mouse, which reads as a hung game
//     rather than as a setting.
TP_F(melee, commitSpeed, NO_WGSL, 900.0f, 1.0f, 3000.0f)
TP_F(melee, recoverTime, NO_WGSL, 0.22f, 0.02f, 2.0f)
// + a hand-written rule in LoadTuning
TP_F(melee, fullSpeedMps, NO_WGSL, 20.0f, 0.05f, 60.0f)
// + a hand-written rule in LoadTuning
TP_F(melee, minSpeedMps, NO_WGSL, 0.9f, 0.0f, 60.0f)
TP_F(melee, aimGainX, NO_WGSL, 0.0050f, 0.0002f, 0.10f)
TP_F(melee, aimGainY, NO_WGSL, 0.0067f, 0.0002f, 0.10f)
TP_F(melee, reachGainM, NO_WGSL, 0.0030f, 0.0f, 0.2f)
// The azimuth stops are asymmetric because an arm is (melee.h), but both
// have to leave a window the seed can live in: a walk cycle parks the
// weapon arm near the bottom of the elevation range, and a window that
// could not represent it would move the blade on the take-over tick — the
// one thing the whole design forbids.
TP_F(melee, azOut, NO_WGSL, 1.83f, 0.20f, 3.10f)
TP_F(melee, azAcross, NO_WGSL, 1.40f, 0.20f, 3.10f)
TP_F(melee, elMin, NO_WGSL, -1.50f, -1.55f, -0.10f)
TP_F(melee, elMax, NO_WGSL, 1.48f, 0.10f, 1.55f)
TP_F(melee, handExtend, NO_WGSL, 0.78f, 0.15f, 1.0f)
TP_F(melee, extendSmoothing, NO_WGSL, 0.18f, 0.005f, 2.0f)
TP_F(melee, leanTurnRate, NO_WGSL, 18.0f, 0.5f, 120.0f)
// + a hand-written rule in LoadTuning
TP_F(melee, handLead, NO_WGSL, 1.0f, -1.0f, 1.0f)
TP_F(melee, fallbackReachM, NO_WGSL, 0.60f, 0.05f, 4.0f)
// Strictly under 1: a fully straight two-bone chain is a locked elbow, and
// AnimSolveTwoBone clamps to its own annulus anyway — a target outside the
// reach costs mouse travel to wind back before the arm visibly moves, which
// is exactly the "the input went dead" feel integration exists to avoid.
TP_F(melee, reachFraction, NO_WGSL, 0.94f, 0.20f, 0.99f)
TP_F(melee, guardForwardM, NO_WGSL, 0.22f, -2.0f, 2.0f)
TP_F(melee, guardUpM, NO_WGSL, 0.26f, -2.0f, 2.0f)
TP_F(melee, guardSideM, NO_WGSL, 0.16f, -2.0f, 2.0f)
TP_F(melee, dirSmoothing, NO_WGSL, 0.06f, 0.005f, 1.0f)
TP_F(melee, bladeSmoothing, NO_WGSL, 0.055f, 0.005f, 1.0f)
// Past ~pi the "wrist" is a ball joint and the fist can end up facing
// backwards down its own arm (game/mob.cpp applies this as a slerp limit).
TP_F(melee, wristMaxAngle, NO_WGSL, 3.10f, 0.0f, 3.14f)
// ---- THE STEER RAMP, and what each bound is protecting -------------------
//
//   * the two speeds are a BAND, so an inverted or zero-width one makes the
//     ramp `(v - lo) / (hi - lo)` singular. `steerSpeedHiMps` is pushed
//     above the low end rather than the pair being swapped: the low end is
//     the one a player tunes ("how still is still?") and swapping would
//     silently redefine the knob they just dragged.
//   * steerFloor at 1 disables the ramp entirely and restores the previous
//     always-align behaviour, which is a legitimate setting and the A/B for
//     the whole change. 0 is legitimate too: a guard that shares nothing
//     with the stroke.
// + a hand-written rule in LoadTuning
TP_F(melee, steerSpeedLoMps, NO_WGSL, 0.6f, 0.0f, 20.0f)
// + a hand-written rule in LoadTuning
TP_F(melee, steerSpeedHiMps, NO_WGSL, 3.0f, 0.0f, 40.0f)
TP_F(melee, steerFloor, NO_WGSL, 0.15f, 0.0f, 1.0f)
// ---- PER-JOINT SMOOTHING + THE HAND'S FRONTAL PLANE ---------------------
// Halflives: 0 is a legitimate off switch (SmoothAlpha returns 1); the
// ceilings only stop a fat-fingered "2" from turning the arm into taffy.
// handBackFrac at 0 pins the hand to the plane exactly; past ~0.5 the
// clamp stops meaning "in front" at all.
TP_F(melee, armSmoothing, NO_WGSL, 0.04f, 0.0f, 1.0f)
TP_F(melee, wristSmoothing, NO_WGSL, 0.10f, 0.0f, 1.0f)
TP_F(melee, handBackFrac, NO_WGSL, 0.05f, 0.0f, 0.5f)
// ---- THE ELBOW/SHOULDER CONES -------------------------------------------
// Both are half-angles, so pi is "unbounded" and restores the old free
// behaviour for an A/B. The floors are not zero: a cone of exactly 0 pins
// the bend plane to the authored one, which is a stiff arm rather than a
// wrong one, and is worth being able to ask for — but a NEGATIVE one would
// make `acos(c) > cone` true on every tick including the aligned case.
TP_F(melee, elbowPoleCone, NO_WGSL, 1.75f, 0.05f, 3.14f)
TP_F(melee, elbowAxisCone, NO_WGSL, 3.14f, 0.0f, 3.14f)
TP_F(melee, edgeFloor, NO_WGSL, 0.35f, 0.0f, 1.0f)
// THE SWEEP'S DENSITY (melee.cpp MeleeSweepDamage). sweepSpacingM is the
// widest gap allowed between two rows of probe rays across one tick's swing;
// the rays are lines, so anything thinner than it can pass between them. A
// human forearm is ~1 voxel (0.1 m), hence 0.05. sweepMaxSteps caps the rows
// so no flick can cost more than sweepMaxSteps * 5 rays (rule 2); at 24 the
// spacing holds up to a tip travelling 1.2 m per tick (36 m/s at 30 Hz).
TP_F(melee, sweepSpacingM, NO_WGSL, 0.05f, 0.01f, 0.5f)
TP_I(melee, sweepMaxSteps, NO_WGSL, 24, 1, 64)
// STRIKE CHAINING (session.cpp, strokes.h StrikeChains). A player strike
// flicked back the way the last one came may start during that one's recover,
// its windup chainWindupRate times faster; chainSectorLeeway is how many
// compass steps either side of dead opposite still count. Rate 1 keeps the
// early start with no speed-up; leeway 0 allows exactly opposite only.
TP_F(melee, chainWindupRate, NO_WGSL, 2.0f, 1.0f, 8.0f)
TP_I(melee, chainSectorLeeway, NO_WGSL, 1, 0, 4)
// A CHARGED STRIKE (session.cpp, strokes.h StrokeCursor::holdWindup). Held
// past its windup, a player strike parks at the windup's end until the button
// is released and then lands chargeDamage times harder (every hp in the
// weapon's strike profile). While held, a flick names another stroke and the
// arm re-aims to that one's windup end over chargeBlendTicks ticks (QuadInOut).
TP_F(melee, chargeDamage, NO_WGSL, 1.5f, 1.0f, 5.0f)
TP_I(melee, chargeBlendTicks, NO_WGSL, 15, 1, 60)
// A RE-AIM IS A FLICK, NOT A TURN (strike_pick.h Feed). While a charged
// strike is held, a mouse motion re-aims it only if it is over within
// chargeFlickTicks ticks and moved at most chargeFlickPx pixels; a longer or
// bigger one is the camera turning and leaves the held strike alone.
TP_I(melee, chargeFlickTicks, NO_WGSL, 8, 1, 30)
TP_F(melee, chargeFlickPx, NO_WGSL, 240.0f, 10.0f, 5000.0f)
// AN INJURED ARM (dual wielding; Mob::HandCondition, the weakest hp fraction
// of the arm chain and hand). Below injuredArmFrom a stroke that arm throws
// is stretched in tempo, up to 1 + injuredArmSlow times as long as the arm
// nears zero (strokes.h InjuredArmSlow) -- and since speed is the damage, a
// slower cut is a weaker one. Below injuredArmDrop the fist cannot hold on:
// what it holds falls (Mob::GripFails). 0 turns either effect off.
TP_F(melee, injuredArmFrom, NO_WGSL, 0.75f, 0.0f, 1.0f)
TP_F(melee, injuredArmSlow, NO_WGSL, 1.0f, 0.0f, 4.0f)
TP_F(melee, injuredArmDrop, NO_WGSL, 0.15f, 0.0f, 1.0f)
// ---- THE BLOCK KNOBS, and what each clamp is protecting ------------------
//
//   * blockGapM is the slack in the segment-vs-segment test. NEGATIVE would
//     mean the two blades must overlap to register, which no real pair of
//     sweeps does, and a parry that can never fire is indistinguishable
//     from the feature being absent. The ceiling is the other failure and
//     the more insidious one: a gap of half a metre parries blows that
//     passed a foot from the defender's blade, which reads as "the AI is
//     invincible" rather than as a bad number.
//   * blockItemDamage above 1 makes the blocking weapon take MORE than the
//     blow carried, so parrying is worse than being cut, which inverts the
//     mechanic. 0 is allowed on purpose — a world where blades never wear.
//   * the two nudges are radians of stroke angle at full power, applied
//     every parry. Past ~1 rad a single block spins the defender's guard
//     most of the way across its own azimuth stops, and a fast exchange
//     turns into the guard oscillating instead of guarding. 0 is allowed:
//     that is "blocking is free", a legitimate setting, not a broken one.
TP_F(melee, blockGapM, NO_WGSL, 0.22f, 0.0f, 0.5f)
TP_F(melee, blockItemDamage, NO_WGSL, 0.35f, 0.0f, 1.0f)
TP_F(melee, blockNudgeAz, NO_WGSL, 0.30f, 0.0f, 1.0f)
TP_F(melee, blockNudgeEl, NO_WGSL, 0.18f, 0.0f, 1.0f)
TP_F(melee, pickMinSpeed, NO_WGSL, 250.0f, 1.0f, 1500.0f)
// Each further strike one stroke lands on the same creature does this
// fraction of the previous one: 0.5 = 100%, 50%, 25%, ... 1 = no falloff,
// 0 = only the first contact hurts.
TP_F(melee, repeatHitScale, NO_WGSL, 0.5f, 0.0f, 1.0f)
// Capped at 90: past it a look is reflected to the front (ResolveSwingYaw),
// so a wider cone could never be reached. 0 pins every swing to the body.
TP_F(melee, aimYaw, NO_WGSL, 70.0f, 0.0f, 90.0f)
TP_F(melee, torsoShare, NO_WGSL, 0.35f, 0.0f, 1.0f)
TP_F(melee, torsoPitch, NO_WGSL, 0.20f, 0.0f, 1.0f)
TP_F(melee, headClearM, NO_WGSL, 0.06f, 0.0f, 0.5f)
// Past half a metre the capsule is wider than the arm can reach round and
// the stroke is pinned at the stop; 0 is the off switch and is legal.
TP_F(melee, bodyClearM, NO_WGSL, 0.05f, 0.0f, 0.5f)
// 0 pins the lean plane outright; pi is "never treat a turn as a
// reversal", which is the old behaviour and the one-JSON-edit A/B.
TP_F(melee, leanFlipHold, NO_WGSL, 3.14f, 0.0f, 3.15f)
TP_F(melee, leanMinSpeed, NO_WGSL, 0.05f, 0.0f, 5.0f)
// Past ~0.95 the roll would never be recomputed at all, which is a blade
// whose edge stops leading the cut.
TP_F(melee, flatMinSin, NO_WGSL, 0.20f, 0.0f, 0.95f)


// ==== combatfx ====
// ---- combat feel: hit-stop, hit flash, combat cues ------------------------
TP_B(combatfx, hitStop, NO_WGSL, true)
// ---- BOUNDS ---------------------------------------------------------------
// THE DIP MAY NOT REACH ZERO AND MAY NOT LAST. A scale of 0 stops the tick
// accumulator filling at all, which is a hang the player cannot get out of
// by any input, since every input is consumed inside the tick loop. A
// duration in whole seconds is the same hang with a timer on it. 0.02 and
// 400 ms are both well past anything that reads as impact and comfortably
// short of anything that reads as broken.
TP_F(combatfx, hitStopChipScale, NO_WGSL, 0.45f, 0.02f, 1.0f)
TP_F(combatfx, hitStopChipMs, NO_WGSL, 55.0f, 0.0f, 400.0f)
TP_F(combatfx, hitStopFleshScale, NO_WGSL, 0.22f, 0.02f, 1.0f)
TP_F(combatfx, hitStopFleshMs, NO_WGSL, 95.0f, 0.0f, 400.0f)
TP_F(combatfx, hitStopSeverScale, NO_WGSL, 0.10f, 0.02f, 1.0f)
TP_F(combatfx, hitStopSeverMs, NO_WGSL, 33.0f, 0.0f, 400.0f)
// The flash is added to a LINEAR HDR colour before the tonemap. Past about
// 4 the tonemap has nothing left to give and every tier looks identical, so
// the ceiling is where the knob stops doing anything rather than where it
// starts looking bad.
TP_F(combatfx, flashChip, NO_WGSL, 0.35f, 0.0f, 4.0f)
TP_F(combatfx, flashFlesh, NO_WGSL, 0.85f, 0.0f, 4.0f)
TP_F(combatfx, flashSever, NO_WGSL, 1.60f, 0.0f, 4.0f)
// A zero halflife would never decay (the per-frame factor is
// exp2(-dt/halflife), which is 0/0 at 0), leaving every struck limb lit for
// the rest of the session.
TP_F(combatfx, flashHalflife, NO_WGSL, 0.075f, 0.01f, 2.0f)
TP_B(combatfx, hitReact, NO_WGSL, true)
// THE REACTION IS SLIGHT BY CONSTRUCTION, and these are the numbers that
// say so. 25 degrees of lean or a fifth of a body height of shove is no
// longer a flinch — it is a stagger, which is a different feature with a
// recovery state and an AI opinion about it. A zero halflife never decays,
// exactly as the flash's does not.
TP_F(combatfx, hitReactRefDamage, NO_WGSL, 14.0f, 0.1f, 60.0f)
TP_F(combatfx, hitReactMaxScale, NO_WGSL, 2.2f, 1.0f, 8.0f)
TP_F(combatfx, hitReactLeanDeg, NO_WGSL, 10.0f, 0.0f, 25.0f)
TP_F(combatfx, hitReactSpineShare, NO_WGSL, 0.55f, 0.0f, 1.0f)
TP_F(combatfx, hitReactPushFrac, NO_WGSL, 0.050f, 0.0f, 0.2f)
TP_F(combatfx, hitReactLimbDeg, NO_WGSL, 22.0f, 0.0f, 45.0f)
TP_F(combatfx, hitReactHalflife, NO_WGSL, 0.110f, 0.01f, 0.6f)
TP_F(combatfx, hitReactImpulse, NO_WGSL, 5.0f, 0.0f, 200.0f)
TP_F(combatfx, whooshVolume, NO_WGSL, 0.55f, 0.0f, 4.0f)
TP_F(combatfx, whooshMinSpeed, NO_WGSL, 300.0f, 0.0f, 2000.0f)
TP_F(combatfx, whooshRateSlow, NO_WGSL, 0.82f, 0.25f, 4.0f)
TP_F(combatfx, whooshRateFast, NO_WGSL, 1.25f, 0.25f, 4.0f)
TP_F(combatfx, whooshEdgeFrac, NO_WGSL, 0.55f, 0.0f, 1.0f)
TP_F(combatfx, whooshPan, NO_WGSL, 1.0f, 0.0f, 1.0f)
TP_F(combatfx, fleshVolume, NO_WGSL, 0.90f, 0.0f, 4.0f)
TP_F(combatfx, clangVolume, NO_WGSL, 0.85f, 0.0f, 4.0f)
TP_F(combatfx, strikeEdgeVolume, NO_WGSL, 0.65f, 0.0f, 4.0f)
TP_F(combatfx, strikeBluntVolume, NO_WGSL, 0.70f, 0.0f, 4.0f)
TP_F(combatfx, cutVolume, NO_WGSL, 0.50f, 0.0f, 4.0f)
TP_F(combatfx, cueRadius, NO_WGSL, 22.0f, 1.0f, 400.0f)


