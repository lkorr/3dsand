TP_F(wind, stormGust, NO_WGSL, 0.6f, 0.0f, 3.0f)
TP_F(wind, stormJump, NO_WGSL, 90.0f, 0.0f, 180.0f)
TP_I(wind, stormBursts, NO_WGSL, 2, 0, 6)
TP_F(wind, stormBurstRadius, NO_WGSL, 25.0f, 3.0f, 51.0f)
TP_B(wind, stormFrontJet, NO_WGSL, true)
TP_B(wind, dbgWindField, NO_WGSL, false)


// ==== render: rows no shader reads ====
TP_B(render, dbgCurrentField, NO_WGSL, false)
TP_V3(render, sunDir, NO_WGSL, 0.50f, 0.55f, 0.38f)
TP_F(render, fogOpticalDepths, NO_WGSL, 4.5f, 0.5f, 20.0f)
TP_F(render, fogLerpPerFrame, NO_WGSL, 0.08f, 0.005f, 1.0f)
// 0 would stall a refill forever (the horizon would never come back) and
// the top is the whole farList buffer, which is the dispatch's own limit.
TP_I(render, farRefillRate, NO_WGSL, 1024, 1, kFarListCap)
// Same two bounds, same reasons: 0 would freeze the horizon wherever the
// player left it, and farList is the dispatch's own ceiling.
TP_I(render, farPlaneFillRate, NO_WGSL, 256, 1, kFarListCap)
// A scale above 1 would be supersampling the most expensive shader in the
// engine; below a quarter the frame is 400x225 and the UI text on top is
// larger than the terrain. Present mode is an enum; fpsCap 0 = off.
TP_F(render, renderScale, NO_WGSL, 1.0f, 0.25f, 1.0f)
TP_I(render, taa, NO_WGSL, 0, 0, 1)
// TAA: a history shorter than 1 sample is not a history, and one longer
// than the f16 the shader stores it in cannot be counted. The clamp width
// and the jitter are both allowed to be 0 (those are the A/B arms) but
// neither is allowed to be negative, which would invert the test it feeds.
TP_F(render, taaMaxHist, NO_WGSL, 24.0f, 1.0f, 512.0f)
TP_F(render, taaClamp, NO_WGSL, 0.25f, 0.0f, 4.0f)
TP_F(render, taaJitter, NO_WGSL, 1.0f, 0.0f, 2.0f)
TP_I(render, taaSharpLod, NO_WGSL, 1, 0, 1)
// 0 would make every tap weigh the same, i.e. a box filter over the
// whole 3x3 and no reconstruction at all.
TP_F(render, taaSharpness, NO_WGSL, 2.29f, 0.05f, 64.0f)
TP_I(render, denoise, NO_WGSL, 0, 0, 1)
// The shading-LOD filter: iterations are bounded by the bind groups
// Simulation allocates (kDenoiseMaxIters); the ramp edges must be ordered
// (smoothstep) and positive; the tolerances are widths, so > 0.
TP_I(render, denoiseIters, NO_WGSL, 2, 0, 4)
// + a hand-written rule in LoadTuning
TP_F(render, denoisePxFull, NO_WGSL, 2.0f, 0.1f, 16.0f)
// + a hand-written rule in LoadTuning
TP_F(render, denoisePxStart, NO_WGSL, 8.0f, 0.2f, 32.0f)
TP_F(render, denoiseDepthTol, NO_WGSL, 0.03f, 0.001f, 0.5f)
TP_F(render, denoiseChromaTol, NO_WGSL, 0.25f, 0.01f, 2.0f)
TP_F(render, denoiseStrength, NO_WGSL, 0.7f, 0.0f, 1.0f)
// + a hand-written rule in LoadTuning
TP_I(render, presentMode, NO_WGSL, 1, 0, 2)
TP_F(render, fpsCap, NO_WGSL, 0.0f, 0.0f, 240.0f)


// ==== world ====
// A NAME, never a path: worldmap.cpp joins it under assets/worldmap/,
// and a value with a separator in it would reach outside that directory.
// (world.editLayer moved to the map's map.json in map-overhaul P7.)
// + a hand-written rule in LoadTuning
TP_S(world, mapLayer, NO_WGSL, "default")

// clang-format on
