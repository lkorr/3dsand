TP_F(wind, windSpeed, NO_WGSL, 6.0f, 0.0f, 40.0f)
TP_F(wind, windDirDeg, NO_WGSL, 45.0f, 0.0f, 360.0f)
TP_F(wind, gustStrength, NO_WGSL, 1.0f, 0.0f, 2.0f)
TP_B(wind, weatherAuto, NO_WGSL, true)
// The gust fronts ride the air at this fraction of the reference mean speed
// (windfield.h AdvPhase). 1 = physical; 0 freezes the fronts in place and
// leaves only the slow evolution term. Summed from tick 0, so moving it
// jumps the pattern once.
TP_F(wind, gustAdvect, NO_WGSL, 1.0f, 0.0f, 4.0f)
// ---- the height/terrain ramp (docs/RESEARCH_wind.md 13.2; windfield.cpp) ----
// Roughness length z0 and the reference height where the log profile is 1.0,
// both metres. z0 below a millimetre makes the profile a step at the ground;
// the reference must be above z0 or the log ratio inverts.
